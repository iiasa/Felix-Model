Total PasMeat Supply to Regions incl Import[Regions]=
	sum(PasMeat Trade to Meet Demand[Regions!,Regions])
	~	Ton/Year
	~	total supply of pasture meat (including domestic supply, and international \
		import) to each region
	|

Total PasMeat Supply from Regions incl Export[Regions]=
	sum(PasMeat Trade to Meet Demand[Regions,Regions!])
	~	Ton/Year
	~	Total pasture meat supply from Region A including domestic supply, and \
		international exports from Region A
	|

Forest Land Energy Yield[Regions]=
	Forest Land Yield[Regions]*Effect of Trees Maturing on Yield[Regions]*Effect of Trees Aging on Yield\
		[Regions]
	~	Biomass ton/(Year*ha)
	~	Forest Land Energy Yield accounting for reference forest biomass \
		production and effect of trees age.
	|

Food supply in tonnes[Regions,PlantFood]=
	Agricultural Product Supply to Regions incl Import Plant Food[Regions,PlantFood]*Food fraction in demand\
		[Regions,PlantFood] ~~|
Food supply in tonnes[Regions,AnimalFood]=
	Agricultural Product Supply to Regions incl Import Animal Food[Regions,AnimalFood]
	~	Ton/Year
	~		|

Feed Availability[Regions,PlantFood]=
	Agricultural Product Supply to Regions incl Import Plant Food[Regions,PlantFood]*Feed fraction in demand\
		[Regions,PlantFood]
	~	Ton/Year
	~		|

Production rate of animal food[Regions,CropMeat]=
	MIN(Total Agricultural Product Demand from Regions incl Export Demand Animal Food[Regions\
		,CropMeat],
	Potential production rate of crop animal food[Regions,CropMeat]) ~~|
Production rate of animal food[Regions,Eggs]=
	MIN(Total Agricultural Product Demand from Regions incl Export Demand Animal Food[Regions\
		,Eggs],Potential production rate of crop animal food[Regions,Eggs]) ~~|
Production rate of animal food[Regions,PasMeat]=
	Production rate of pasture based food[Regions,PasMeat] ~~|
Production rate of animal food[Regions,Dairy]=
	Production rate of pasture based food[Regions,Dairy]
	~	Ton/Year
	~		|

Production rate of pasture based food[Regions,PasMeat]=
	MIN(Potential production rate of pasture based food[Regions,PasMeat],Total Agricultural Product Demand from Regions incl Export Demand Animal Food\
		[Regions,PasMeat]) ~~|
Production rate of pasture based food[Regions,Dairy]=
	MIN(Potential production rate of pasture based food[Regions,Dairy],Total Agricultural Product Demand from Regions incl Export Demand Animal Food\
		[Regions,Dairy])
	~	Ton/Year
	~	Total animal food production due to animal food land availability and \
		animal food land yield.
	|

Agricultural Product Supply to Regions incl Import Animal Food[Regions,AnimalFood]=
	SMOOTHI(Food demand inc Waste in tonnes[Regions,AnimalFood] , 1, Agricultural Product Supply to Regions incl Import\
		[Regions,AnimalFood])
	~	Ton/Year
	~		|

Agricultural Product Supply to Regions incl Import Plant Food[Regions,PlantFood]=
	SMOOTHI(Desired crop production[Regions,PlantFood], 1, Agricultural Product Supply to Regions incl Import\
		[Regions,PlantFood] )
	~	Ton/Year
	~		|

Total Agricultural Product Demand from Regions incl Export Demand Animal Food[Regions\
		,AnimalFood]=
	SMOOTHI( Agricultural Product Supply from Regions incl Export[Regions,AnimalFood],1,\
		Food demand inc Waste in tonnes[Regions,AnimalFood] )
	~	Ton/Year
	~		|

Potential production rate of pasture based food[Regions,PasMeat]=
	Grassland Allocated for Food Production[Regions]*Grassland allocation fraction[Regions\
		,PasMeat]*Grassland Meat Yield[Regions] ~~|
Potential production rate of pasture based food[Regions,Dairy]=
	Grassland Allocated for Food Production[Regions]*Grassland allocation fraction[Regions\
		,Dairy]*Grassland Milk Yield[Regions]
	~	Ton/Year
	~	Total animal food production due to animal food land availability and \
		animal food land yield.
	|

Grassland Needed[Regions,PasMeat]=
	Total Agricultural Product Demand from Regions incl Export Demand Animal Food[Regions\
		,PasMeat]/Expected Grassland Meat Yield[Regions] ~~|
Grassland Needed[Regions,Dairy]=
	Total Agricultural Product Demand from Regions incl Export Demand Animal Food[Regions\
		,Dairy]/Expected Grassland Milk Yield[Regions]
	~	ha
	~		|

