P2O5 demand from agriculture[Regions]=
	Reference P2O5 consumption 2010[Regions]*
	Effect of Income on P2O5 Use[Regions]*
	Effect of Technology on P2O5 Consumption[Regions]*
	Effect of Land Availability on P2O5 Use[Regions]
	~	Ton/Year
	~		|

Effect of Land Availability on P2O5 Use[Regions]=
	L land P2O5[Regions]/ 
	(
	1 + EXP(-k land P2O5[Regions] * (Relative DemSupply Ratio AgrLand[Regions] - x0 land P2O5\
		[Regions]))
	)
	~	Dmnl
	~		|

Effect of Income on P2O5 Use[Regions]=
	L gwp P2O5[Regions] / 
	(1 + 
	EXP(-k gwp P2O5[Regions] * (Relative GDP per Capita[Regions] - x0 gwp P2O5[Regions])\
		)
	)
	~	Dmnl
	~		|

Effect of Technology on P2O5 Consumption[Regions]=
	IF THEN ELSE(Time<2020, 1, 
	L tech P2O5[Regions]/ (1 + EXP(-k tech P2O5[Regions] * ((Time-2020) - x0 tech P2O5[Regions\
		]))))
	~	Dmnl
	~		|

