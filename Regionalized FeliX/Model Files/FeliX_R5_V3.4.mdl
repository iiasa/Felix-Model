		[Regions,Gender,"20-24"],1) ~~|
Tertiary Education Enrollment Fraction[Regions,Gender,"25-29"]=
	MIN(Effect of GWP per capita on tertiary enrollment[Regions,Gender]*Reference tertiary education enrollment fraction\
		[Regions,Gender,"25-29"],1)
	~	1/Year
	~	MIN(Effect of GWP per capita on tertiary \
		enrollment[Regions,Gender]*Reference tertiary education enrollment \
		fraction[Regions,Gender,"15-19"]*Tertiary age \
		distribution[Regions,"15-19"],1)
