	|

INIT BITRN[Regions]=
	0
	~	Dmnl
	~	Initial Biomass Installation Technology Ratio.
		The global value is 0
		GET XLS CONSTANTS('InitialValues.xlsx','Stocks','F34')
	|

Average Annual Production per Capacity[Regions]=
	0.116
	~	Mtoe/Year
	~	Average annual energy production per unit of biomass installed capacity.
