		15-19 enrolling at tertiary education
		
		+ 
		SMOOTH3(STEP(Tertiary education enrollment \
		Variation[Regions,Gender]-Reference tertiary education enrollment fraction \
		Init[Regions,Gender,"20-24"],Current year),SSP Demographic Variation Time)
	|

Graduation Rate from Tertiary Education[Regions,Gender,"20-24"]=
	MIN(
	DELAY1(
	Enrollment Rate to Tertiary Education[Regions,Gender,"15-19"]*(Average Tertiary Education Duration\
		)/Interval duration+
	Enrollment Rate to Tertiary Education[Regions,Gender,"20-24"]*(Interval duration-Average Tertiary Education Duration\
		)/Interval duration,
	Average Tertiary Education Duration),
	Maturation Rate[Regions,Gender,"20-24"]
	) ~~|
Graduation Rate from Tertiary Education[Regions,Gender,"25-29"]=
	MIN(
	DELAY1(Enrollment Rate to Tertiary Education[Regions,Gender,"20-24"]*Average Tertiary Education Duration\
		/Interval duration+
	Enrollment Rate to Tertiary Education[Regions,Gender,"25-29"]*(Interval duration-Average Tertiary Education Duration\
		)/Interval duration, 
	Average Tertiary Education Duration),
	Maturation Rate[Regions,Gender,"25-29"]
	) ~~|
Graduation Rate from Tertiary Education[Regions,Gender,"30-34"]=
	MIN(
	DELAY1(
	Enrollment Rate to Tertiary Education[Regions,Gender,"25-29"]*Average Tertiary Education Duration\
		/Interval duration+
	Enrollment Rate to Tertiary Education[Regions,Gender,"30-34"]*(Interval duration-Average Tertiary Education Duration\
		)/Interval duration,
	Average Tertiary Education Duration),
	Maturation Rate[Regions,Gender,"30-34"]
	) ~~|
Graduation Rate from Tertiary Education[Regions,Gender,"15-19"]=
	MIN(
	DELAY1(
	Enrollment Rate to Tertiary Education[Regions,Gender,"15-19"]*(Interval duration-Average Tertiary Education Duration\
		)/Interval duration,
	Average Tertiary Education Duration),
	Maturation Rate[Regions,Gender,"15-19"]
	)
	~	People/Year
	~		|

Age Specific Fertility Rate[Regions,Fertile]=
	MAX(L0 asfr[Regions,Fertile]+L asfr[Regions,Fertile]/(1+EXP(-k asfr[Regions,Fertile]\
		)/(Effect Edu[Regions,Fertile]*Effect TFR[Regions,Fertile])),0)
	~	Dmnl
	~	Age-specific fertility rate is formulated as a LOGISTIC function, derived from the \
		Total Fertility - Age-Specific Fertility Rate relationship observed in the \
		data from Wittgenstein Center for Population and Human Capital.
		
		MAX(Ramp for fertility variation[Regions,Fertile]+L age fertility[Regions,Fertile] / \
		(1 + EXP(-k age fertility[Regions,
		Fertile] * (Total Fertility[Regions] - x0 age \
		fertility[Regions,Fertile]))),0)
	|

