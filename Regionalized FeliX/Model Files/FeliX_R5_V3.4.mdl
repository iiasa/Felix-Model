INIT Other Capital Change[Regions]=
	8e+09
	~	$/Year
	~	Inital capital in other sectors.
		in the global version of FeliX: GET XLS \
		CONSTANTS('InitialValues.xlsx','Stocks','F6')
	|

Other Technology Inflection Point Variation=
	100
	~	Dmnl
	~	Parameter determining inflection point of reference factor productivity in \
		other than energy sectors.
	|

OLDCapital Elasticity Output=
	0.35
	~	Dmnl
	~	Capital Elasticity of Output.
	~	:SUPPLEMENTARY 
	|

OLDOutput in 1900=
	1.3e+12
	~	$/Year
	~	Economy output in 1900.
	~	:SUPPLEMENTARY 
	|

Childhood:
	"0-4","5-9","10-14"
	~	
	~		|

Other Capital Change Ratio[Regions]=
	0.77
	~	Dmnl
	~	Strength of adjustment of current to reference capital change related to \
		sectors other than energy.
	|

Other Technologies=
	Reference Other Technology*(1-Other Technology Inflection Point^Other Technology Steepness\
		/(Other Technology Inflection Point
	^Other Technology Steepness
	+((Time-INITIAL TIME)/Year Period)^Other Technology Steepness))
	~	Dmnl
	~	Factor productivity in other than energy sectors.
	|

Other Technology Inflection Point=
	100+STEP(Other Technology Inflection Point Variation-100, 2020)
	~	Dmnl
	~	Parameter determining inflection point of reference factor productivity in \
		other than energy sectors.
	|

Consumption or income of a person per day=
	2.15
	~	$/(Person*Day)
	~	$2.15 a day (2017PPP)
		$1.9 a day (2011PPP)
	|

