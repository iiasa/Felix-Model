Unskilled population[Regions,Gender,Cohorts]=
	Population Cohorts[Regions,Gender,Cohorts]-Skilled population[Regions,Gender,Cohorts\
		]
	~	People
	~		|

Gini1[Regions,Gender,Cohorts]=
	1-(Unskilled population[Regions,Gender,Cohorts]*Relative incomes of unskilled[Gender\
		,Cohorts]+(2*Relative incomes of unskilled[Gender,Cohorts]+Relative incomes of skilled\
		[Gender,Cohorts])*Skilled population[Regions,Gender,Cohorts])/(Population Cohorts[Regions\
		,Gender,Cohorts]*Total relative incomes[Gender,Cohorts])
	~	
	~	if using the shares variables, the equation is: 1-(population share of \
		unskilled*income share of unskilled+population share of skilled*(income \
		share of unskilled+1))
	|

Gini2[Regions,Gender,Cohorts]=
	1-(Skilled population[Regions,Gender,Cohorts]*Relative incomes of skilled[Gender,Cohorts\
		]
	+(2*Relative incomes of skilled[Gender,Cohorts]+Relative incomes of unskilled[Gender\
		,Cohorts])*Unskilled population[Regions,Gender,Cohorts])/(Population Cohorts[Regions\
		,Gender,Cohorts]*Total relative incomes[Gender,Cohorts])
	~	
	~	if using the shares variables, the equation is: 1-(population share of \
		skilled*income share of skilled+population share of unskilled*(income \
		share of skilled+1))
	|

"lnPL-mean"[Regions,Gender,Cohorts]=
	LN(Poverty line)-Mean value of the lognormal distribution of consumption or income[Regions\
		,Gender,Cohorts]
	~	Dmnl
	~		|

Mean value of the lognormal distribution of consumption or income[Regions,Gender,Cohorts\
		]=
	LN(Real incomes per capita[Regions,Gender,Cohorts])-(Standard deviation of the lognormal distribution of consumption\
		[Regions,Gender,Cohorts]^
	2)/2
	~	$/(Person*Year)
	~		|

Standard deviation of the lognormal distribution of consumption[Regions,Gender,Cohorts\
		]=
	SQRT(2)*Inverse table for standard normal distribution((Gini coefficient[Regions,Gender\
		,Cohorts]+1)/2)
	~	Dmnl
	~		|

Gini coefficient[Regions,Gender,Cohorts]=
	IF THEN ELSE(Gini1[Regions,Gender,Cohorts]>0,Gini1[Regions,Gender,Cohorts], Gini2[Regions\
		,Gender,Cohorts])
	~	Dmnl
	~	To make sure the value of Gini coefficient>0
	|

