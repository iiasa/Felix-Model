		]
	~	
	~		|

PasMeat Prices Adj Fractions[Regions]=
	FIND ZERO(Demand Scale[Regions],Scaled Excess Demand PasMeat[Regions],Relative Demand Scale\
		[Regions],Initial Export Fraction Demand
	[Regions],
	Size n Demand,Skip Demand,Tolerance Demand,Max Iteration Demand,Method Demand)
	~	
	~	This is used to solve nonlinear simultaneous algebraic equations of \
		pasture meat prices, which then adjust the supply of pasture meat from \
		different regions to make scaled excess demand of pasture meat close to 0.
	|

