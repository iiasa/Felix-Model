		[Regions]+
	Investment in Coal Exploration[Regions]+Investment in Coal Production[Regions]+Investment in Coal Technology\
		[Regions]+
	Investment in Gas Exploration[Regions]+Investment in Gas Production[Regions]+Investment in Gas Technology\
		[Regions]+
	Investment in Biomass Capacity[Regions]+Investment in Biomass Energy Technology[Regions\
		]+
	Investment in Solar Capacity[Regions]+Investment in Solar Energy Technology[Regions]\
