	~	Mtoe/Year
	~	Average total gas production per year.
	|

Gas Production[Regions]=
	Gas Production Rate[Regions]
	~	Mtoe/Year
	~	Total gas energy production per year. Source of historical data: \
		International Energy Agency – Key World Energy Statistics 2007; BP \
		Statistical Review of World Energy June 2008
	|

Gas Cost[Regions]=
	Unit Cost of Gas Exploration[Regions]+Unit Cost of Gas Production[Regions]
	~	$/Mtoe
	~	Cost of unit gas resources as a sum of unit exploration and production \
		costs.
	|

Identified Gas Resources[Regions]= INTEG (
	Gas Exploration[Regions]-Gas Production[Regions],
		(Total Gas Demand from Regions incl Export Demand[Regions]*Normal Gas Production Ratio\
		[Regions]+Cumulative Gas Production[Regions]*(1-Gas Fraction Recoverable[Regions]))\
		/Gas Fraction Recoverable[Regions])
	~	Mtoe
	~	Gas Resources discovered thanks to developments in exploration technology.
	|

Gas Discovery Technology Development Time[Regions]=
	GDR Var S[Regions]+SMOOTH(STEP(Gas Discovery and Recovery Technology Development Time Variation\
		[Regions]-GDR Var S[Regions], 2020+E Var T),SSP Energy Technology Variation Time
	)
	~	Year
	~	Average time required to turn investments into concrete gas discovery \
		developments.
	|

Relative Productivity of Investment in Gas Exploration[Regions]=
	Relative Productivity of Investment in Gas Exploration Variation[Regions]+
	STEP(Relative Productivity of Investment in Gas Exploration Variation[Regions]-Relative Productivity of Investment in Gas Exploration Variation\
		[Regions], 2020)
	~	toe/$
	~	Relative Productivity of Investment in Gas Exploration without taking into \
		account remaining undiscovered gas resources and advances in exploration \
		technologies.
	|

Gas Exploration Rate[Regions]=
	MIN(Desired Gas Exploration Rate[Regions],Potential Gas Exploration[Regions])
	~	Mtoe/Year
	~	Gas Exploration Rate accounting for potential and desired gas exploration \
		rates.
	|

Relative Productivity of Investment in Gas Production Compared to Exploration Variation\
		[Regions]=
	10
	~	Dmnl
	~		|

Change in Average Gas Production[Regions]=
	(Gas Production[Regions]-Average Gas Production[Regions])/Time to Average Gas Production
	~	Mtoe/(Year*Year)
	~	Change in Average Gas Production.
	|

Gas Gross Margin[Regions]=
	(Gas Price[Regions]-Gas Cost[Regions])/Gas Cost[Regions]
	~	Dmnl
	~	Actual gas gross margin.
	~	:SUPPLEMENTARY 
	|

Gas Price per MBtu[Regions]=
	Gas Price[Regions]*Mtoe per Btu
	~	$/MBtu
	~	Actual Gas Price per Barrel.
	~	:SUPPLEMENTARY 
	|

RPGPE S[Regions]=
	10
	~	Dmnl
	~		|

Gas Production Coverage[Regions]=
	Identified Gas Resources[Regions]/Average Gas Production[Regions]
	~	Year
	~	Ratio indicating gas coverage in years for discovered resources and at the \
		current average gas production.
	|

Required Identified Gas Resources[Regions]=
	(Identified Gas Resources[Regions]/Total Gas Recoverable Resource Remaining[Regions]\
		)*(Normal Gas Production Ratio[Regions]*Total Gas Demand from Regions incl Export Demand\
		[Regions])
	~	Mtoe
	~	The desired Identified Gas Resources level sought by the gas sector.
	|

FG Var S[Regions]=
	FG S[Regions]+SMOOTH(STEP(FG S[Regions]-FG S[Regions], 2020),1)
	~	Dmnl
	~	Percentage of total gas sector revenue dedicated to exploration and \
		production technology development.
	|

Investment in Gas Production Delay[Regions]=
	IG Var S[Regions]+SMOOTH(STEP(Investment in Gas Exploration and Production Delay Variation\
		[Regions]-IG Var S[Regions], 2020+E Var T),SSP Energy Technology Variation Time
	)
	~	Year
	~	Time delay to make investments in gas production effective.
	|

Gas Exploration[Regions]=
	MAX(0,Gas Exploration Rate[Regions])
	~	Mtoe/Year
	~	Gas resources discovery rate.
	|

Potential Gas Exploration[Regions]=
	Effective Investment in Gas Exploration[Regions]*Productivity of Investment in Gas Exploration\
		[Regions]/toe per Mtoe
	~	Mtoe/Year
	~	Potential Gas exploration due to available investments in gas resources \
		discovery.
	|

Effective Investment in Gas Exploration[Regions]= INTEG (
	Change in Effective Investment in Gas Exploration[Regions],
		INIT EIGE[Regions])
	~	$/Year
	~	Effective investments dedicated for gas resources exploration.
	|

Fraction of Gas Revenues Invested in Technology[Regions]=
	FG Var S[Regions]+SMOOTH(STEP(Fraction of Gas Revenues Invested in Technology Variation\
		[Regions]-FG Var S[Regions], 2020+E Var T),SSP Energy Technology Variation Time
	)
	~	Dmnl
	~	Percentage of total gas sector revenue dedicated to exploration and \
		production technology development.
	|

Gas Fraction Recoverable[Regions]=
	MINGFR+(MAXGFR-MINGFR)*(Ratio of Gas Fraction Recoverable to Unrecoverable[Regions]/\
		(Ratio of Gas Fraction Recoverable to Unrecoverable[Regions]+1))
	~	Dmnl
	~	Percentage of gas resources that can be produced due to current state of \
		recovery technology.
	|

Cumulative Gas Production[Regions]= INTEG (
	Gas Production[Regions],
		INIT CGPN[Regions])
	~	Mtoe
	~	Cumulative Gas resources that has been produced.
	|

Total Gas Resources[Regions]=
	Undiscovered Gas Resources[Regions]+Cumulative Additions to Gas Production[Regions]
	~	Mtoe
	~	Total gas resources including Undiscovered Gas Resources, Identified Gas \
		Resources and resources already produced i.e. Cumulative Gas Production.
	|

Change in Gas Productivity of Investment[Regions]=
	(Productivity of Investment in Gas Exploration[Regions]-Gas Productivity of Investment\
		[Regions])/Gas Production Coverage[Regions]
	~	toe/(Year*$)
	~	Change in Gas Productivity of Investment.
	|

Total Gas Discoverable Resources[Regions]=
	(Total Gas Resources[Regions]-Cumulative Additions to Gas Production[Regions])*Gas Fraction Discoverable\
		[Regions]
	~	Mtoe
	~	Total Gas Discoverable Resources as a percentage of Total Gas Resources. \
		It excludes identified and already produced resources. The percentage is \
		determined by exploration technology developments.
	|

Potential Gas Production from Resources[Regions]=
	Total Gas Recoverable Resource Remaining[Regions]/Normal Gas Production Ratio[Regions\
		]
	~	Mtoe/Year
	~	Potential Gas Production rate due to Total Oil Recoverable Resource \
		Remaining adjusted by oil production safety coverage.
	|

Gas Recovery Technology Development Time[Regions]=
	GDR Var S[Regions]+SMOOTH(STEP(Gas Discovery and Recovery Technology Development Time Variation\
		[Regions]-GDR Var S[Regions], 2020+E Var T),SSP Energy Technology Variation Time
	)
	~	Year
	~	Average time required to turn investments into concrete gas recovery \
		developments.
