TABLE F Gases Radiative Forcing SSP2 RCP26(
	[(0,0)-(10,10)],(2010,0.0311024),(2020,0.061264),(2030,0.0782927),(2040,0.080345),(2050\
		,0.0847037),(2060,0.0891935),(2070,0.0927838),(2080,0.0960691),(2090,0.0987984),(2100\
		,0.101286))
	~	W/(Meter*Meter)
	~	Data series for future projections of f-gases radiative forcing by \
		Message-GLOBIOM (SSP2 marker model) in RCP 2.6.
	|

F Gases Radiative Forcing RCP45=
	TABLE F Gases Radiative Forcing SSP2 RCP45(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of f gases radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 4.5).
	|

Watt per J s=
	1
	~	W/(J/sec)
	~	Conversion from J/s to watts.
	|

Heat to 700m=
	Heat in Atmosphere and Upper Ocean*(1-Land Area Fraction)+Heat in Deep Ocean 1+Heat in Deep Ocean 2
	~	Year*W/(Meter*Meter)
	~	Sum of the heat in the atmosphere and upper ocean and that in the top two \
		layers of the deep ocean. Assumes default layer thicknesses, i.e., 100 m \
		for the mixed ocean and 300 m each for layers 1 and 2.
	|

TABLE F Gases Radiative Forcing(
	[(0,0)-(10,10)],(1900,0),(1950,1e-05),(2005,0.021105),(2010,0.0311024))
	~	W/(Meter*Meter)
	~	Data series for historical data of F-gases radiative forcing. Pre-2000 \
		From AR5, 2005 AND 2010 from the SSP database, SSP2 Message-GLOBIOM \
		(marker).
	|

TABLE N2O Radiative Forcing(
	[(1900,0)-(2005,1)],(1900,0.025),(1910,0.029),(1920,0.036),(1930,0.043),(1940,0.048)\
		,(1950,0.056),(1960,0.064),(1970,0.077),(1980,0.098),(1990,0.124),(2000,0.145),(2005\
		,0.155711),(2010,0.167804))
	~	W/(Meter*Meter)
	~	Data series for historical data of N2O radiative forcing.
	|

TABLE N2O Radiative Forcing SSP2 RCP26(
	[(0,0)-(10,10)],(2010,0.167804),(2020,0.190994),(2030,0.213422),(2040,0.233756),(2050\
		,0.249976),(2060,0.262045),(2070,0.270751),(2080,0.275577),(2090,0.277001),(2100,0.27603\
		))
	~	W/(Meter*Meter)
	~	Data series for future projections of N2O radiative forcing by \
		MESSAGE-GLOBIOM (RCP 2.6).
	|

Heat Transfer 3=
	(Relative Deep 2 Ocean Temperature-Relative Deep 3 Ocean Temperature)*Heat Transfer Coefficient 3\
		/Mean Depth of Adjacent 2 3 Layers
	~	W/(Meter*Meter)
	~	Heat transfer from the second to the third layer of the deep ocean.
	|

Effective Radiative Forcing=
	Total Radiative Forcing
	~	W/(Meter*Meter)
	~	Total radiative forcing from various factors in the atmosphere.
	|

TABLE CH4 Radiative Forcing SSP2 RCP85(
	[(0,0)-(10,10)],(2010,0.588276),(2020,0.624748),(2030,0.647046),(2040,0.664906),(2050\
		,0.676129),(2060,0.685959),(2070,0.695531),(2080,0.699882),(2090,0.698119),(2100,0.688933\
		))
	~	W/(Meter*Meter)
	~	Data series for future projections of CH4 radiative forcing by \
		MESSAGE-GLOBIOM (RCP 8.5).
	|

F Gases Radiative Forcing RCP19=
	TABLE F Gases Radiative Forcing SSP2 RCP19(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of f-gases radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 1.9).
	|

F Gases Radiative Forcing RCP26=
	TABLE F Gases Radiative Forcing SSP2 RCP26(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of f-gases radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 2.6).
	|

F Gases Radiative Forcing RCP34=
	TABLE F Gases Radiative Forcing SSP2 RCP34(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of f gases radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MESSAGE (RCP \
		8.5).
	|

F Gases Radiative Forcing=
	IF THEN ELSE(Time<=2010,F Gases Radiative Forcing History,
	IF THEN ELSE(RCP Scenario=0, F Gases Radiative Forcing RCP19,
	IF THEN ELSE(RCP Scenario=1,F Gases Radiative Forcing RCP26,
	IF THEN ELSE(RCP Scenario=2,F Gases Radiative Forcing RCP34,
	IF THEN ELSE(RCP Scenario=3, F Gases Radiative Forcing RCP45, 
	IF THEN ELSE(RCP Scenario=4, F Gases Radiative Forcing RCP60, 
	F Gases Radiative Forcing RCP85
	))))))
	~	W/(Meter*Meter)
	~	Radiative forcing from F-gases (HFC and others) in the atmosphere.
	|

RCP Scenario=
	3
	~	Dmnl [1,4,1]
	~	Trigger for Representative Concentration Pathways scenarios.
		RCP Scenario=0, RCP1.9
		RCP Scenario=1,RCP2.6,
		RCP Scenario=2,RCP3.4,
		RCP Scenario=3, RCP 4.5,
		RCP Scenario=4, RCP 6,
		RCP Scenario=5, RCP 8.5
	|

Land Area Fraction=
	0.292
	~	Dmnl
	~	Fraction of global surface area that is land.
	|

Heat Transfer 1=
	(Temperature Change from Preindustrial-Relative Deep 1 Ocean Temperature)*Heat Transfer Coefficient 1\
		/Mean Depth of Adjacent M 1 Layers
	~	Watt/(Meter*Meter)
	~	Heat transfer from the atmosphere & upper ocean to the first layer of the \
		deep ocean.
	|

Heat Transfer 2=
	(Relative Deep 1 Ocean Temperature-Relative Deep 2 Ocean Temperature)*Heat Transfer Coefficient 2\
		/Mean Depth of Adjacent 1 2 Layers
	~	W/(Meter*Meter)
	~	Heat transfer from the first to the second layer of the deep ocean.
	|

