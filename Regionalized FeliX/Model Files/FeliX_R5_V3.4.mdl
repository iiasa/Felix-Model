Urban and Other Land[Regions]=
	Urban and Industrial Land[Regions]+Other Land[Regions]
	~	ha
	~		|

Energy Crops Production[Regions]=
	Arable Land Allocated for Energy Crops[Regions]*Agriculture Land Energy Yield[Regions\
		]
	~	Biomass ton/Year
	~	Total energy biomass production from energy crops.
	|

L fertilizer[Regions,PlantFood]=
	SA L fertilizer[Regions,PlantFood]+STEP(SA L fertilizer[Regions,PlantFood]-SA L fertilizer\
		[Regions,PlantFood], 2020) ~~|
L fertilizer[Regions,PasMeat]=
	SA L fertilizer[Regions,PasMeat]
	~	Dmnl
	~		|

Arable Land Needed for Energy Crops[Regions]=
	Total Crops Biomass Demand[Regions]/Agriculture Land Energy Yield[Regions]
	~	ha
	~	Land area dedicated to energy crops production.
	|

Average P demand rate[Regions]=
	SMOOTHI(Desired phosphate rock production rate[Regions], 5, Average P demand rate ref\
		[Regions])
	~	Ton/Year
	~		|

Average P demand rate ref[Regions]=
	5.67132e+07,
	5.3443e+07,
	3.035e+07,
	9.33646e+06,
	3.035e+07
	~	Ton/Year
	~		|

Crop yield for each category[Regions,PlantFood]=
	Average expected crop yield[Regions,PlantFood]
	* Effect of Input Neutral Technology Change on Agricultural Land Fertility[Regions]
	* Effect of Climate Change on Agricultural Yield
	* Effect of Carbon Concentration on Agricultural Yield
	* Effect of Water Withdrawal on Agriculture Land Fertility
	~	Ton/(ha*Year)
	~		|

Effect of Input Neutral Technology Change on Agricultural Land Fertility[Regions]=
	L gdp agritech[Regions] - EXP(-k gdp agritech[Regions]*Relative GDP per Capita[Regions\
		])
	~	Dmnl
	~	Impact of technological advancement on agricultural land fertility.
		1+Reference Input Neutral TC in Agriculture Variation*(LN(Relative GWP per \
		Capita+Delay in GWP for agriculture technology impact
		))
	|

x0 fertilizer[Regions,PlantFood]=
	SA x0 fertilizer[Regions,PlantFood] + STEP(SA x0 fertilizer[Regions,PlantFood]-SA x0 fertilizer\
		[Regions,PlantFood], 2020) ~~|
x0 fertilizer[Regions,PasMeat]=
	SA x0 fertilizer[Regions,PasMeat]
	~	Dmnl
	~		|

Effect of Income on Fertilizer N Use[Regions]=
	L gwp fert N[Regions] / 
	(1 + 
	EXP(-k gwp fert N[Regions] * (Relative GDP per Capita[Regions] - x0 gwp fert N[Regions\
		]))
	)
	~	Dmnl
	~	L gwp fert / 
		(1 + 
		EXP(-k gwp fert * (Relative GWP per Capita - x0 gwp fert))
		)
	|

Fertilization Related Practices[Regions]=
	Effect of Input Neutral Technology Change on Agricultural Land Fertility[Regions]*Effect of Management Practices on Agriculture Land Fertility
	~	Dmnl
	~	Variable representing extent of technical advancement and management \
		practices related to fertilization.
	|

k fertilizer[Regions,PlantFood]=
	SA k fertilizer[Regions,PlantFood] + STEP(SA k fertilizer[Regions,PlantFood]-SA k fertilizer\
		[Regions,PlantFood], 2020) ~~|
k fertilizer[Regions,PasMeat]=
	SA k fertilizer[Regions,PasMeat]
	~	Dmnl
	~		|

Effect of N on Yield 2[Regions,PlantFood]=
	L fertilizer[Regions,PlantFood] / 
	(1 + 
	EXP(-k fertilizer[Regions,PlantFood] * (N ratio applied to reference[Regions,PlantFood\
		] - x0 fertilizer[Regions,PlantFood]))
	) ~~|
Effect of N on Yield 2[Regions,PasMeat]=
	L fertilizer[Regions,PasMeat] / 
	(1 + 
	EXP(-k fertilizer[Regions,PasMeat] * (N ratio applied to reference[Regions,PasMeat] \
		- x0 fertilizer[Regions,PasMeat]))
	)
	~	Dmnl
	~		|

P discovery rate[Regions]=
	SMOOTH(Discovery amount[Regions]*PULSE(Discovery year, 1), 2)
	~	Ton/Year
	~		|

Phosphate Rock Proven Reserves[Regions]= INTEG (
	P discovery rate[Regions]-P rock production rate[Regions],
		INIT P proven reserves[Regions])
	~	Ton
	~		|

Potential crop production[Regions,PlantFood]=
	Area harvested[Regions,PlantFood]*Crop yield for each category[Regions,PlantFood]
	~	Ton/Year
	~		|

Relative DemSupply Ratio AgrLand[Regions]=
	Smoothed Demand Supply Ratio Agr Land[Regions]/Reference Dem Suppyl Ratio Agr Land 2010\
		[Regions]
	~	Dmnl
	~		|

Expected crop yield[Regions,PlantFood]=
	DELAY1I(Crop yield for each category[Regions,PlantFood], 1,INIT Crop Yield[Regions,PlantFood\
		])
	~	Ton/(Year*ha)
	~		|

k land fert N[Regions]=
	SA k land fert N[Regions] + STEP(SA k land fert N[Regions]-SA k land fert N[Regions]\
		, 2020)
	~	Dmnl
	~		|

L land fert N[Regions]=
	SA L land fert N[Regions] + STEP(SA L land fert N[Regions]-SA L land fert N[Regions]\
		, 2020)
	~	Dmnl
	~		|

x0 land fert N[Regions]=
	SA x0 land fert N[Regions] + STEP(SA x0 land fert N[Regions]-SA x0 land fert N[Regions\
		], 2020)
	~	Dmnl
	~		|

Commercial N application for agriculture[Regions]=
	Reference nitrogen consumption 2010[Regions]*
	Effect of Income on Fertilizer N Use[Regions]*
	Effect of Technology on Fertilizer N Consumption*
	Effect of Land Availability on Fertilizer N Use[Regions]
	~	Ton/Year
	~	Application of N fertilizers, aligning with the "agricultural use" of \
		"total nutrient nitrogen" in the FAO database.
	|

Effect of Land Availability on Fertilizer N Use[Regions]=
	L land fert N[Regions] / 
	(
	1 + EXP(-k land fert N[Regions] * (Relative DemSupply Ratio AgrLand[Regions] - x0 land fert N\
		[Regions]))
	)
	~	Dmnl
	~	L land fert / 
		(
		1 + EXP(-k land fert * (Relative DemSupply Ratio AgrLand - x0 land fert))
		)
	|

Feed demand in tonnes[Regions,PlantFood]=
	Food demand inc Waste in tonnes[Regions,CropMeat]*Feed share of crop types Data[Regions\
		,PlantFood]*Unit feed used for meat production[Regions]
	~	Ton/Year
	~	The amount of PlantFood required for crop-based meat production
	|

Permanent meadows and pastures[Regions]=
	Agricultural Land[Regions]*Meadows and Pastures Percentage of Agriculture Land[Regions\
		]
	~	ha
	~	Area of permanent meadows and pastures land.
	|

Agricultural Land Erosion Rate[Regions]=
	Agricultural Land[Regions]*Agricultural Land Erosion Fraction[Regions]
	~	ha/Year
	~	Process of transformation between Agriculture and Other Land.
	|

Forest Land Needed to be Harvested[Regions]=
	(Total Forest Biomass Demand[Regions]/(1-Biomass Production Processing Loss[Regions]\
		))/Forest Land Energy Yield[Regions]
	~	ha
	~	Total area of Forest needed for biomass production purposes accounting for \
		total demand for forest biomass, average forest land yield and average \
		losses in forest biomass production process.
	|

Intended Conversion Other to Agriculture[Regions]=
	Desired Agricultural Land Conversion[Regions]*(1-AF S[Regions])
	~	ha
	~		|

Fraction of Agricultural Land Conversion from Forest[Regions]=
	AF Var S[Regions] + SMOOTH(STEP(Fraction of Agricultural Land Conversion from Forest Variation\
		-AF Var S[Regions], 2020+L Var T),SSP Land Use Change Variation Time
	)
	~	Dmnl
	~		|

AF Var S[Regions]=
	AF S[Regions] + SMOOTH(STEP(AF S[Regions]-AF S[Regions], 2020),1
	)
	~	Dmnl
	~		|

Forest Biomass Production[Regions]=
	MIN(Total Forest Biomass Demand[Regions], 
	Harvest Available Forest Land[Regions]*Forest Land Energy Yield[Regions]*(1-Biomass Production Processing Loss\
		[Regions]))
	~	Biomass ton/Year
	~	Total biomass production from forest.
	|

Intended Conversion Forest to Agriculture[Regions]=
	Desired Agricultural Land Conversion[Regions]*AF S[Regions]
	~	ha/Year
	~		|

Actual Forest Land Harvested[Regions]=
	(Forest Biomass Production[Regions]/(1-Biomass Production Processing Loss[Regions]))\
		/Forest Land Energy Yield[Regions]
	~	ha
	~	Forest biomass production expressed in terms of forest land harvested \
		excluding forest biomass production processing loss.
	|

Agricultural Land Erosion Fraction[Regions]=
	Agricultural Land Erosion Fraction Variation[Regions]+STEP(Agricultural Land Erosion Fraction Variation\
		[Regions]-Agricultural Land Erosion Fraction Variation[Regions], 2020)
	~	1/Year
	~	This is actually dependent on yield. The highher the yield, the shorter \
		the lifetime of the agricultural land.
	|

Potential Biomass Production[Regions]=
	Forest Land Yield[Regions]*Harvest Available Forest Land[Regions]*(1-Biomass Production Processing Loss\
		[Regions])
	~	Biomass ton/Year
	~	Potential Biomass Production for given area to be harvested, actual yield \
		from ha and excluding forest biomass production processing losses.
	|

Expected Grassland Milk Yield[Regions]=
	DELAY1I(Grassland Milk Yield[Regions], 1, Initial Grassland Milk Yield[Regions])
	~	Ton/(Year*ha)
	~		|

Grassland Milk Yield[Regions]=
	Grassland Meat Yield[Regions]*Meat to Milk Multiplier[Regions]
	~	Ton/(Year*ha)
	~		|

Permanent crops[Regions]=
	Agricultural Land[Regions]*Permanent Crops Percentage of Agriculture Land[Regions]
	~	ha
	~	Area of permanent crops land.
	|

Effect of price on P production[Regions]=
	a price*EXP(-b price*Relative P price[Regions])
	~	Dmnl
	~		|

Effect of reserves on P price[Regions]=
	a reserve*EXP(-b reserve*(Reserve demand ratio[Regions]/Initial P reserve production ratio\
		))
	~	Dmnl
	~		|

Effect of scarcity on P production[Regions]= WITH LOOKUP (
	Phosphate Rock Proven Reserves[Regions]/Desired phosphate rock production rate[Regions\
		],
		([(0,0)-(2,1)],(0,0),(0.5,0.5),(1,0.9),(1.5,0.95),(2,1) ))
	~	Dmnl
	~		|

P Uptake for each crop type[Regions,PlantFood]=
	Average P content[PlantFood]*Food production rate[Regions,PlantFood] ~~|
P Uptake for each crop type[Regions,PasMeat]=
	Average P content[PasMeat]*Food production rate[Regions,PasMeat]
	~	Ton/Year
	~		|

Forest Land[Regions]= INTEG (
	Forestation from Agricultural Land[Regions]
	+ Forestation from Other Land[Regions]
	- Deforestation to Agricultural Land[Regions]
	- Deforestation to Urban Land[Regions],
		INIT Forest Land[Regions])
	~	ha
	~	Total Forest Land.
	|

Forest Land Change[Regions]=
	Forest Land[Regions]/INIT Forest Land[Regions]
	~	Dmnl
	~	Ratio of forest land area change compared to its initial area in year 1900.
	|

Forest Land Discrepancy[Regions]=
	MAX(0, Forest Land Needed to be Harvested[Regions]-Harvest Available Forest Land[Regions\
		])
	~	ha
	~		|

Forest Land Fertility[Regions]=
	Normal Forest Land Fertility[Regions]
	*Effect of Climate Change on Forest Land Fertility
	*Effect of Management Practices on Forest Land Fertility[Regions]
	*Effect of CO2 Concentration on Forest Land Fertility
	*Effect of Biodiversity on Forest Land Fertility[Regions]
	*Effect of Input Neutral Technology Change on Forest Land Fertility[Regions]
	~	Dmnl
	~	Multiplier inidcating forest land fertility i.e. how many times the \
		nominal forest land yield has changed since the reference value in year \
		1900.
	|

L urban land[Regions]=
	EGI Var S[Regions]+STEP(Effect of GDP on Urban Land Requirement l Variation[Regions]\
		-EGI Var S[Regions], 2020+SE Var T)
	~	Dmnl
	~		|

Effect of Trees Maturing on Yield[Regions]=
	Table for ETMY(Desired Production Fraction[Regions])
	~	Dmnl
	~	Parameter accounting for increased forest biomass production from mature \
		trees.
	|

P2O5 supply for agriculture[Regions]=
	P2O5 agriculture fraction*P2O5 production rate[Regions]
	~	Ton/Year
	~		|

Forest Protected Land[Regions]= INTEG (
	Forest Protected Land Change[Regions],
		INIT Forest Protected Land[Regions])
	~	ha
	~	Area of forest land indicated as protected. Source of historical data: \
		http://www.fao.org/docrep/003/x4108e/X4108E11.htm# P3941_174357
	|

Forest Protected Land Change[Regions]=
	DELAY3(Forest Protected Land[Regions]*Current to Max Forest Protected Land[Regions],\
		Time to Adjust Forest Protected Land)
	~	ha/Year
	~	Changes in area of forest land indicated as protected.
	|

Delayed area harvested[Regions,PlantFood]= DELAY FIXED (
	 Area harvested[Regions,PlantFood] , 1, Initial Area harvested[Regions,PlantFood])
	~	ha
	~		|

Deforestation to Urban Land[Regions]=
	MIN(
	Urban and Industrial Land Discrepancy[Regions]*(1-Fraction of Urban Land Conversion from Agriculture\
		[Regions])/Forest to Urban Land Allocation Time,
	(Forest Land[Regions]-Forest Protected Land[Regions])/Forest to Urban Land Allocation Time\
		)
	~	ha/Year
	~	Transformation process of Forest into Urban and Industrial Land.
	|

EGX Var S[Regions]=
	EGX S[Regions]+STEP(EGX S[Regions]-EGX S[Regions], 2020)
	~	Dmnl
	~		|

Total Daily Calorie Supply per Capita[Regions]=
	Animal Food Supply kcal capita day[Regions]+Vegetal Food supply kcal capita day[Regions\
		]
	~	kcal/Person/Day
	~	Total average amount of food measured in calories available for each \
		person per day. Source of projection data: GLOBIOM model, IIASA.
	|

Forestation from Agricultural Land[Regions]=
	MIN(
	(Agricultural Land[Regions]-Agriculture Protected Land[Regions])/TIME STEP,
	Forest Land Discrepancy[Regions]*Fraction of Forest Land Conversion from Agriculture\
		/Agriculture to Forest Land Allocation Time
	)
	~	ha/Year
	~	Process of transformation between Forest and Agriculture Land.
	|

Agricultural Land[Regions]= INTEG (
	- Agricultural Land Erosion Rate[Regions]
	- Forestation from Agricultural Land[Regions]
	- Agricultural Land Conversion Rate to Urban Land[Regions]
	+ Deforestation to Agricultural Land[Regions]
	+ Agricultural Land Development Rate[Regions],
		INIT Agricultural Land[Regions])
	~	ha
	~	Total Agriculture Land.
	|

Forestation from Other Land[Regions]=
	MIN(
	(Other Land[Regions]-Other Protected Land[Regions])/Other to Forest Land Allocation Time\
		,
	Forest Land Discrepancy[Regions]*(1-Fraction of Forest Land Conversion from Agriculture\
		)/Other to Forest Land Allocation Time
	)
	~	ha/Year
	~		|

Agricultural Land Conversion Rate to Urban Land[Regions]=
	MIN(
	Urban and Industrial Land Discrepancy[Regions]*Fraction of Urban Land Conversion from Agriculture\
		[Regions]/Agriculture to Urban Land Allocation Time
	,
	
	(Agricultural Land[Regions]-Agriculture Protected Land[Regions])/Agriculture to Urban Land Allocation Time
	)
	~	ha/Year
	~	Transformation process of Agriculture Land into Urban and Industrial Land.
	|

Denitrification Rate[Regions]=
	Nitrogen[Regions]*Denitrification fraction
	~	Ton/Year
	~		|

Relative P price[Regions]=
	P price[Regions]/Reference P price
	~	Dmnl
	~		|

Reference N uptake per ha[Regions,PlantFood]=
	Reference crop yield 2016[Regions,PlantFood]*Average N content[PlantFood] ~~|
Reference N uptake per ha[Regions,PasMeat]=
	Average N content[PasMeat]*Reference meat yield[Regions]
	~	Ton/(Year*ha)
	~		|

Current to Max Forest Protected Land[Regions]=
	Forest Protected Land Change Ratio*(1-Forest Protected Land[Regions]/Max Forest Protected Land\
		[Regions])
	~	1/Year
	~	Gap being closed between current and max forest protected land.
	|

"P produced in the manure of crop-based animals"[Regions]=
	Unit P production via manure crop based*
	(Production rate of animal food[Regions,CropMeat] + Production rate of animal food[Regions\
		,Eggs])
	~	Ton/Year
	~		|

Effect of fertilizer on yield[Regions,PlantFood]=
	MIN(Effect of N on Yield 2[Regions,PlantFood], Effect of P on Yield 2[Regions,PlantFood\
		]) ~~|
Effect of fertilizer on yield[Regions,PasMeat]=
	MIN(Effect of N on Yield 2[Regions,PasMeat],Effect of P on Yield 2[Regions,PasMeat])
	~	Dmnl
	~		|

P ratio applied to reference[Regions,PlantFood]=
	P application per ha[Regions,PlantFood]/Reference P uptake rate per ha[Regions,PlantFood\
		] ~~|
P ratio applied to reference[Regions,PasMeat]=
	P application per ha[Regions,PasMeat]/Reference P uptake rate per ha[Regions,PasMeat\
		]
	~	Dmnl
	~		|

Reference P uptake rate per ha[Regions,PlantFood]=
	Reference crop yield 2016[Regions,PlantFood]*Average P content[PlantFood] ~~|
Reference P uptake rate per ha[Regions,PasMeat]=
	Reference meat yield[Regions]*Average P content[PasMeat]
	~	Ton/(Year*ha)
	~		|

Land Use as Share of Total C Emission=
	(sum(C Emission from Land Use[Regions!])/Total C Emission)*100
	~	Dmnl
	~	Carbon emission from forest and agricultural land use change as a \
		percentage of total carbon emission.
	|

Urban and Industrial Land per Capita[Regions]=
	Effect of GDP on Urban Land Requirement[Regions]*Normal Urban and Industrial Land per Capita\
		[Regions]
	~	ha/Person
	~	Actual available area of Urban and Industrial Land per capita assuming \
		equal land distribution between the total population.
	|

Urban and Industrial Land Required[Regions]=
	Population[Regions]*Urban and Industrial Land per Capita[Regions]
	~	ha
	~		|

Commercial N application for each category[Regions,PlantFood]=
	Commercial N application for agriculture[Regions]*N fertilizer shares normalized[PlantFood\
		] ~~|
Commercial N application for each category[Regions,PasMeat]=
	Commercial N application for agriculture[Regions]*N fertilizer shares normalized[PasMeat\
		]
	~	Ton/Year
	~		|

Commercial Nitrogen Application per ha[Regions]=
	Commercial N application for agriculture[Regions]/Agricultural Land[Regions]
	~	Ton/(ha*Year)
	~		|

Commercial P application for agriculture[Regions]=
	Commercial P2O5 application for agriculture[Regions]*P2O5 to P conversion factor
	~	Ton/Year
	~	The amount of elemental P in the applied P2O5 fertilizers
	|

Commercial P application for each category[Regions,PlantFood]=
	Commercial P application for agriculture[Regions]*P fertilizer shares normalized[PlantFood\
		] ~~|
Commercial P application for each category[Regions,PasMeat]=
	Commercial P application for agriculture[Regions]*P fertilizer shares normalized[PasMeat\
		]
	~	Ton/Year
	~		|

Commercial P2O5 application for agriculture[Regions]=
	MIN(P2O5 demand from agriculture[Regions], P2O5 supply for agriculture[Regions])
	~	Ton/Year
	~		|

Desired phosphate rock production rate[Regions]=
	Desired P205 production rate[Regions]/P2O5 content in phosphate rock
	~	Ton/Year
	~		|

Animal Food Supply kcal capita day[Regions]=
	Total Supply of Animal Calories[Regions]/(Population[Regions]*Days in Year*kcal to Mkcal\
		)
	~	kcal/(Person*Day)
	~	Average amount of animal food measured in calories available for each \
		person per day. Source of historical data: http://faostat.fao.org
	|

P application per ha[Regions,PlantFood]=
	Commercial P application for each category[Regions,PlantFood]/Area harvested[Regions\
		,PlantFood] ~~|
P application per ha[Regions,PasMeat]=
	Commercial P application for each category[Regions,PasMeat]/Grassland Allocated for Food Production\
		[Regions]
	~	Ton/(Year*ha)
	~		|

EGI Var S[Regions]=
	EGI S[Regions]+STEP(EGI S[Regions]-EGI S[Regions], 2020)
	~	Dmnl
	~		|

N application per ha[Regions,PlantFood]=
	Commercial N application for each category[Regions,PlantFood]/Delayed area harvested\
		[Regions,PlantFood] ~~|
N application per ha[Regions,PasMeat]=
	Commercial N application for each category[Regions,PasMeat]/Grassland Allocated for Food Production\
		[Regions]
	~	Ton/(Year*ha)
	~		|

Recoverable P generated in crop based manure[Regions]=
	"P produced in the manure of crop-based animals"[Regions]*Recoverable manure fraction crop based
	~	Ton/Year
	~		|

Relative GDP per Capita[Regions]=
	Smoothed GDP per Capita[Regions]/GDP per Capita 2000[Regions]
	~	Dmnl
	~		|

Impact of Land Use Change on Biodiversity[Regions]=
	Impact of Agricultural Land Changes on Biodiversity[Regions]*Impact of Forest Land Changes on Biodiversity\
		[Regions]*Impact of Other Land Changes on Biodiversity[Regions]
	~	Dmnl
	~	Total impact of land use change on species carrying capacity.
	~	:SUPPLEMENTARY 
	|

Effect of Input Neutral Technology Change on Forest Land Fertility[Regions]=
	Input Neutral Forest Technology[Regions]/INIT Input Neutral TC in Forest[Regions]
	~	Dmnl
	~	Impact of technological advancement on forest land fertility.
	|

Input Neutral Forest Technology[Regions]= INTEG (
	Input Neutral Technology Change in Forest[Regions],
		INIT Input Neutral TC in Forest[Regions])
	~	Dmnl
	~	Exogenous variable representing technological advancement and its positive \
		impact on forest land fertility.
	|

n per ha[Regions]=
	Commercial N application for agriculture[Regions]/Total area harvested[Regions]
	~	Ton/(ha*Year)
	~		|

"N produced in the manure of crop-based animals"[Regions]=
	Unit N production via manure crop based*
	(Production rate of animal food[Regions,CropMeat] + Production rate of animal food[Regions\
		,Eggs])
	~	Ton/Year
	~		|

Total Supply of Animal Calories[Regions]=
	sum(Food supply in kcal[Regions,AnimalFood!])
	~	Mkcal/Year
	~		|

N ratio applied to reference[Regions,PlantFood]=
	N application per ha[Regions,PlantFood]/Reference N uptake per ha[Regions,PlantFood]\
		 ~~|
N ratio applied to reference[Regions,PasMeat]=
	N application per ha[Regions,PasMeat]/Reference N uptake per ha[Regions,PasMeat]
	~	Dmnl
	~		|

P price[Regions]=
	P cost*P price margin*SMOOTH(Effect of reserves on P price[Regions], 3)
	~	$/Ton
	~		|

N Uptake for crop type[Regions,PlantFood]=
	Average N content[PlantFood]*Food production rate[Regions,PlantFood] ~~|
N Uptake for crop type[Regions,PasMeat]=
	Food production rate[Regions,PasMeat]*Average N content[PasMeat]
	~	Ton/Year
	~		|

x0 urban land[Regions]=
	EGX Var S[Regions]+STEP(Effect of GDP on Urban Land Requirement x0 Variation[Regions\
		]-EGX Var S[Regions], 2020+SE Var T)
	~	Dmnl
	~		|

CO2 emission rate of the agriculture sector[Regions,FoodCategories]=
	Food production rate[Regions,FoodCategories]*Unit CO2 emissions from food production\
		[FoodCategories]
	~	TonCO2/Year
	~		|

Daily caloric supply per capita[Regions,FoodCategories]=
	Food supply in kcal[Regions,FoodCategories]/(Population[Regions]*Days in Year*kcal to Mkcal\
		)
	~	kcal/(Person*Day)
	~		|

P rock production rate[Regions]=
	Desired phosphate rock production rate[Regions]*Effect of scarcity on P production[Regions\
		]
	~	Ton/Year
	~		|

Total Agricultural and Land Use Emissions[Regions]=
	Total CO2 Emissions from Land Use[Regions]+Total CO2 Emissions from Agriculture[Regions\
		]
	~	TonCO2/Year
	~		|

P use efficiency[Regions]=
	Total P uptake rate[Regions]/(Commercial P application for agriculture[Regions]+Phosphorus application with manure\
		[Regions])
	~	Dmnl
	~		|

Effect of GDP on Forest Land Fertility Elasticity[Regions]=
	Effect of GDP on Forest Land Fertility Elasticity Variation[Regions]+STEP(Effect of GDP on Forest Land Fertility Elasticity Variation\
		[Regions]-Effect of GDP on Forest Land Fertility Elasticity Variation[Regions], 2020\
		)
	~	(Year*Year*Person*Person)/($*$)
	~	Elasticity of impact of GDP on forest land management practices.
	|

Total N Emissions[Regions]=
	Denitrification Rate[Regions]+Nitrogen Leaching and Runoff Rate[Regions]
	~	Ton/Year
	~		|

Total N uptake rate[Regions]=
	MIN(
	sum(N Uptake for crop type[Regions,PlantFood!]) + N Uptake for crop type[Regions,PasMeat\
		],
	Nitrogen[Regions]/TIME STEP)
	~	Ton/Year
	~		|

Commercial Phosphorus Application per ha[Regions]=
	Commercial P2O5 application for agriculture[Regions]/Agricultural Land[Regions]
	~	Ton/(ha*Year)
	~		|

P2O5 production rate[Regions]=
	P rock production rate[Regions]*P2O5 content in phosphate rock
	~	Ton/Year
	~	P205 content
	|

Effect of Trees Aging on Yield[Regions]=
	Table for ETAY(Desired Production Fraction[Regions])
	~	Dmnl
	~	Parameter accounting for decreased forest biomass production from aging \
		tress.
	|

Reserve demand ratio[Regions]=
	Phosphate Rock Proven Reserves[Regions]/Average P demand rate[Regions]
	~	Year
	~		|

Total CO2 Emissions from Land Use[Regions]=
	C Emission from Land Use[Regions]*CO2 to C
	~	TonCO2/Year
	~		|

Nitrogen Leaching and Runoff Rate[Regions]=
	Nitrogen[Regions]*N leaching and runoff fraction
	~	Ton/Year
	~		|

Deforestation to Agricultural Land[Regions]=
	MIN(
	(Forest Land[Regions] - Forest Protected Land[Regions]) / FAT S,
	Intended Conversion Forest to Agriculture[Regions] /Forest to Agriculture Land Allocation Time
	)
	~	ha/Year
	~		|

Recoverable N generated in pasture based manure[Regions]=
	"N produced in the manure of pasture-based animals"[Regions]*Recoverable manure fraction pasture based
	~	Ton/Year
	~		|

P budget[Regions]=
	Commercial P application for agriculture[Regions]+Phosphorus application with manure\
		[Regions]-Phosphorus erosion leaching and runoff rate[Regions]
	-Total P uptake rate[Regions]
	~	Ton/Year
	~		|

Recoverable P generated in pasture based manure[Regions]=
	"P produced in the manure of pasture-based animals"[Regions]*Recoverable manure fraction pasture based
	~	Ton/Year
	~		|

Total P uptake rate[Regions]=
	MIN(
	sum(P Uptake for each crop type[Regions,PlantFood!]) + P Uptake for each crop type[Regions\
		,PasMeat],
	Phosphorus[Regions]/TIME STEP)
	~	Ton/Year
	~		|

Fraction of Urban Land Conversion from Agriculture[Regions]=
	Fraction of Urban Land Conversion from Agriculture Variation[Regions]+STEP(Fraction of Urban Land Conversion from Agriculture Variation\
		[Regions]-Fraction of Urban Land Conversion from Agriculture Variation[Regions], 2020\
		)
	~	Dmnl
	~		|

Harvest Available Forest Land[Regions]=
	Forest Land Fraction Harvested excluding Protected Area[Regions]*MAX(0, (Forest Land\
		[Regions]-Forest Protected Land[Regions]))
	~	ha
	~	Actual area of Forest available to be harvested.
	|

Input Neutral Technology Change in Forest[Regions]=
	Input Neutral Technology Change in Forest Factor[Regions]
	~	1/Year
	~	Change in technological advancement related to forest land fertility.
	|

Total Fertilizer Runoff and Leaching[Regions]=
	Nitrogen Leaching and Runoff Rate[Regions]+Phosphorus erosion leaching and runoff rate\
		[Regions]
	~	Ton/Year
	~		|

P loss to inputs[Regions]=
	Phosphorus erosion leaching and runoff rate[Regions]/(Phosphorus application with manure\
		[Regions]+Commercial P application for agriculture[Regions])
	~	Dmnl
	~		|

Impact of Biomass Production on Biodiversity[Regions]=
	Impact of Agriculture Biomass Production on Biodiversity[Regions]*Impact of Forest Biomass Production on Biodiversity\
		[Regions]
	~	Dmnl
	~	Total impact of forest and crops biomass production on species carrying \
		capacity.
	~	:SUPPLEMENTARY 
	|

Food Ratio[Regions]=
	Total Daily Calorie Supply per Capita[Regions]/Subsistence Food per Capita[Regions]
	~	Dmnl
	~	Available food to subsistence food per capita ratio.
	|

Total CO2 Emissions from Agriculture[Regions]=
	sum(CO2 emission rate of the agriculture sector[Regions,FoodCategories!])
	~	TonCO2/Year
	~		|

Urban and Industrial Land[Regions]= INTEG (
	Agricultural Land Conversion Rate to Urban Land[Regions]+Deforestation to Urban Land\
		[Regions],
		INIT Urban and Industrial Land[Regions])
	~	ha
	~	Total Urban and Industrial Land.
	|

Total P produced in manure[Regions]=
	"P produced in the manure of crop-based animals"[Regions]+"P produced in the manure of pasture-based animals"\
		[Regions]
	~	Ton/Year
	~		|

Total P205 demand[Regions]=
	P2O5 demand from agriculture[Regions]/P2O5 agriculture fraction
	~	Ton/Year
	~		|

Desired Production Fraction[Regions]=
	Total Forest Biomass Demand[Regions]/Potential Biomass Production[Regions]
	~	1
	~	Ratio of demand for forest biomass to potential production.
	|

NTotal P produced in manure[Regions]=
	"N produced in the manure of crop-based animals"[Regions]+"N produced in the manure of pasture-based animals"\
		[Regions]
	~	Ton/Year
	~		|

Phosphorus erosion leaching and runoff rate[Regions]=
	P leaching fraction*Phosphorus[Regions]
	~	Ton/Year
	~	Agricultural topsoil erosion rate*Agricultural topsoil P concentration
	|

Urban and Industrial Land Discrepancy[Regions]=
	MAX(Urban and Industrial Land Required[Regions]-Urban and Industrial Land[Regions], \
		0)
	~	ha
	~		|

Forest Land Yield[Regions]=
	Forest Land Fertility[Regions]*Nominal Energy Forest Land Productivity[Regions]
	~	Biomass ton/(Year*ha)
	~	Actual annual amount of forest biomass production from unit forest land \
		area for given Forest Land Fertility.
	|

Nitrogen[Regions]= INTEG (
	Commercial N application for agriculture[Regions]+deposition+mineralization+Nitrogen application with manure\
		[Regions]-Denitrification Rate[Regions]-Nitrogen Leaching and Runoff Rate[Regions]-\
		Total N uptake rate[Regions],
		Initial Mobile Nitrogen)
	~	Ton
	~	"Mobile" elemental nitrogen in soil.
	|

Recoverable N generated in crop based manure[Regions]=
	"N produced in the manure of crop-based animals"[Regions]*Recoverable manure fraction crop based
	~	Ton/Year
	~		|

Total Supply of Vegetal Calories[Regions]=
	sum(Food supply in kcal[Regions,PlantFood!])
	~	Mkcal/Year
	~		|

Forest Land Fraction Harvested excluding Protected Area[Regions]=
	Forest Land Fraction Harvested excluding Protected Area Variation[Regions]+STEP(Forest Land Fraction Harvested excluding Protected Area Variation\
		[Regions]-Forest Land Fraction Harvested excluding Protected Area Variation[Regions\
		], 2020)
	~	Dmnl
	~	Fraction of Forest dedicated to be harvested.
	|

Vegetal Food supply kcal capita day[Regions]=
	Total Supply of Vegetal Calories[Regions]/(Population[Regions]*Days in Year*kcal to Mkcal\
		)
	~	kcal/(Person*Day)
	~	Average amount of vegetal food measured in calories available for each \
		person per day. Source of historical data: http://faostat.fao.org
	|

Desired P205 production rate[Regions]=
	Effect of price on P production[Regions]*Total P205 demand[Regions]
	~	Ton/Year
	~		|

Effect of Management Practices on Forest Land Fertility[Regions]=
	1+Effect of GDP on Forest Management Practices Increment*(1-EXP(-Effect of GDP on Forest Land Fertility Elasticity\
		[Regions]*GDP per Capita[Regions]
	*GDP per Capita[Regions]))
	~	Dmnl
	~	Impact of forest land management practices on forest land fertility.
	|

Phosphorus[Regions]= INTEG (
	-Phosphorus erosion leaching and runoff rate[Regions]-Total P uptake rate[Regions]+Commercial P application for agriculture\
		[Regions]+Phosphorus application with manure[Regions],
		Initial Phosphorus[Regions])
	~	Ton
	~	This is the total global amount of elemental phosphorus accumulating in \
		the soil.
	|

k urban land[Regions]=
	Effect of GDP on Urban Land Requirement k Variation[Regions]+STEP(Effect of GDP on Urban Land Requirement k Variation\
		[Regions]-Effect of GDP on Urban Land Requirement k Variation[Regions], 2020)
	~	Dmnl
	~		|

"P produced in the manure of pasture-based animals"[Regions]=
	Unit P production via manure pasture based * 
	(Production rate of animal food[Regions,PasMeat]+Production rate of animal food[Regions\
		,Dairy])
	~	Ton/Year
	~		|

Effect of GDP on Urban Land Requirement[Regions]=
	EGI S[Regions] / (1 + EXP(-k urban land[Regions] * (Relative GDP per Capita[Regions]\
		 - EGX S[Regions])))
	~	Dmnl
	~	k urban land +
	|

"N produced in the manure of pasture-based animals"[Regions]=
	Unit N production via manure pasture based * 
	(Production rate of animal food[Regions,PasMeat]+Production rate of animal food[Regions\
		,Dairy])
	~	Ton/Year
	~		|

Phosphorus application with manure[Regions]=
	Recoverable P generated in pasture based manure[Regions]+Recoverable P generated in crop based manure\
		[Regions]
	~	Ton/Year
	~		|

Nitrogen application with manure[Regions]=
	Recoverable N generated in crop based manure[Regions]+Recoverable N generated in pasture based manure\
		[Regions]
	~	Ton/Year
	~		|

Arable land allocation fraction[Regions,PlantFood]=
	SMOOTH(Demand Fraction of Food and Feed Crops[Regions,PlantFood], 5)
	~	Dmnl
	~		|

Trend of Land Demand[Regions]=
	TREND(Total Agricultural Land Demand[Regions], Trend Averaging Time,Initial Trend)
	~	1/Year
	~		|

Other Land[Regions]= INTEG (
	Agricultural Land Erosion Rate[Regions]
	- Agricultural Land Development Rate[Regions]
	- Forestation from Other Land[Regions],
		INIT Other Land[Regions])
	~	ha
	~	Land not classified as Agricultural area, Forest area or Urban and \
		Industrial Land.
	|

Total Agricultural Land Demand[Regions]=
	Cropland Needed[Regions]+Total Grassland Needed[Regions]
	~	ha
	~		|

Forest Biomass Production Land Ratio[Regions]=
	Actual Forest Land Harvested[Regions]/Forest Land[Regions]
	~	Dmnl
	~	Ratio of forest land area being used for biomass production.
	|

Area harvested[Regions,PlantFood]=
	Arable Land Allocated for Crops[Regions]*Arable land allocation fraction[Regions,PlantFood\
		]
	~	ha
	~		|

Demand fraction of Grassland[Regions,PasMeat]=
	Grassland Needed[Regions,PasMeat]/Total Grassland Needed[Regions] ~~|
Demand fraction of Grassland[Regions,Dairy]=
	Grassland Needed[Regions,Dairy]/Total Grassland Needed[Regions]
	~	Dmnl
	~		|

Agricultural Land Development Rate[Regions]=
	MIN(Intended Conversion Other to Agriculture[Regions], Other Land[Regions]-Other Protected Land\
		[Regions])/Agricultural Land Development Time
	~	ha/Year
	~		|

Expected Grassland Meat Yield[Regions]=
	DELAY1I(Grassland Meat Yield[Regions], 1, Initial Grassland Meat Yield[Regions])
	~	Ton/(Year*ha)
	~		|

Smoothed Demand Supply Ratio Agr Land[Regions]=
	SMOOTH(Demand Supply ratio of Agricultural Land[Regions], 10)
	~	Dmnl
	~		|

Agricultural Land Change[Regions]=
	Agricultural Land[Regions]/INIT Agricultural Land[Regions]
	~	Dmnl
	~	Ratio of agricultural land area change compared to its initial area in \
		year 1900.
	|

Demand Supply ratio of Agricultural Land[Regions]=
	Total Agricultural Land Demand[Regions]/Agricultural Land[Regions]
	~	Dmnl
	~		|

Land Allocated for Animal Calories[Regions]=
	Grassland Allocated for Food Production[Regions]
	~	ha
	~	Calculated historical data and projection for land for animal food \
		according to FAO. Source of historical data: http://faostat.fao.org
	|

Land Allocated for Energy Crops[Regions]=
	Arable Land Allocated for Energy Crops[Regions]
	~	ha
	~	Land area dedicated to energy crops production.
	|

Land Allocated for Food Crops[Regions]=
	Arable Land Allocated for Crops[Regions]+
	Permanent crops[Regions]
	~	ha
	~	Land area dedicated to crops production decreased by the area dedicated to \
		energy crops production.
	|

Desired Agricultural Land Conversion[Regions]=
	Trend of Land Demand[Regions]*Agricultural Land[Regions]
	~	ha/Year
	~		|

Cropland Needed[Regions]=
	sum(Arable Land Needed[Regions,PlantFood!])+Permanent crops[Regions]+Arable Land Needed for Energy Crops\
		[Regions]
	~	ha
	~	Land area required for food crops production due to food demand.
	|

Agriculture Biomass Production Land Ratio[Regions]=
	Land Allocated for Energy Crops[Regions]/Land Allocated for Food Crops[Regions]
	~	Dmnl
	~	Ratio of agricultural land area being used for crops biomass production.
	|

Desired crop production[Regions,PlantFood]=
	Food demand inc Waste in tonnes[Regions,PlantFood]+Feed demand in tonnes[Regions,PlantFood\
		]+Food demand for other uses[Regions,PlantFood]
	~	Ton/Year
	~		|

Demand Fraction of Food and Feed Crops[Regions,PlantFood]=
	Arable Land Needed[Regions,PlantFood]/Total Demand for Arable Land[Regions]
	~	Dmnl
	~		|

Grassland Allocated for Food Production[Regions]=
	MIN(Permanent meadows and pastures[Regions],Grassland allocation demand[Regions])
	~	ha
	~		|

Grassland allocation demand[Regions]=
	SMOOTH(Total Grassland Needed[Regions], 5)
	~	ha
	~		|

Grassland allocation fraction[Regions,PasMeat]=
	SMOOTH(Demand fraction of Grassland[Regions,PasMeat], 5) ~~|
Grassland allocation fraction[Regions,Dairy]=
	SMOOTH(Demand fraction of Grassland[Regions,Dairy], 5)
	~	Dmnl
	~		|

Initial Area harvested[Regions,PlantFood]= INITIAL(
	Area harvested[Regions,PlantFood])
	~	ha
	~		|

Arable Land[Regions]=
	Agricultural Land[Regions]*Arable Percentage of Agriculture Land[Regions]
	~	ha
	~	Area of arable land.
	|

Feed fraction in demand[Regions,PlantFood]=
	Feed demand in tonnes[Regions,PlantFood]/Desired crop production[Regions,PlantFood]
	~	Dmnl
	~		|

Total area harvested[Regions]=
	sum(Area harvested[Regions,PlantFood!])
	~	ha
	~		|

Total Demand for Arable Land[Regions]=
	Arable Land Needed for Energy Crops[Regions]+sum(Arable Land Needed[Regions,PlantFood\
		!])
	~	ha
	~		|

Food fraction in demand[Regions,PlantFood]=
	Food demand inc Waste in tonnes[Regions,PlantFood]/Desired crop production[Regions,PlantFood\
		]
	~	Dmnl
	~		|

Total Grassland Needed[Regions]=
	Grassland Needed[Regions,PasMeat]+Grassland Needed[Regions,Dairy]
	~	ha
	~		|

Indicated Gas Trade to Meet Demand[Regions,Africa]=
	(1/Gas Price[Regions]^2)/
	(1/Gas Price[Africa]^2+1/Gas Price[AsiaPacific]^2+1/Gas Price[EastEu]^2+1/Gas Price[\
		LAC]^2+1/Gas Price[WestEu]^2)*
	Gas Demand Local[Africa] ~~|
Indicated Gas Trade to Meet Demand[Regions,AsiaPacific]=
	(1/Gas Price[Regions]^2)/
	(1/Gas Price[Africa]^2+1/Gas Price[AsiaPacific]^2+1/Gas Price[EastEu]^2+1/Gas Price[\
		LAC]^2+1/Gas Price[WestEu]^2)*
	Gas Demand Local[AsiaPacific] ~~|
Indicated Gas Trade to Meet Demand[Regions,EastEu]=
	(1/Gas Price[Regions]^2)/
	(1/Gas Price[Africa]^2+1/Gas Price[AsiaPacific]^2+1/Gas Price[EastEu]^2+1/Gas Price[\
		LAC]^2+1/Gas Price[WestEu]^2)*
	Gas Demand Local[EastEu] ~~|
Indicated Gas Trade to Meet Demand[Regions,LAC]=
	(1/Gas Price[Regions]^2)/
	(1/Gas Price[Africa]^2+1/Gas Price[AsiaPacific]^2+1/Gas Price[EastEu]^2+1/Gas Price[\
		LAC]^2+1/Gas Price[WestEu]^2)*
	Gas Demand Local[LAC] ~~|
Indicated Gas Trade to Meet Demand[Regions,WestEu]=
	(1/Gas Price[Regions]^2)/
	(1/Gas Price[Africa]^2+1/Gas Price[AsiaPacific]^2+1/Gas Price[EastEu]^2+1/Gas Price[\
		LAC]^2+1/Gas Price[WestEu]^2)*
	Gas Demand Local[WestEu]
	~	Mtoe/Year
	~	"Indicated Gas Trade to Meet Demand[Region A, Region B]" represents an indicated \
		value of gas export from Region A to Region B, serving as a starting point \
		for trade modelling. 
		It is calculated based on a logit sharing function considering gas prices \
		in different regions to meet the gas demand of each region.
	|

Ratio between Coal Supply and Production[Regions]=
	Total Coal Supply from Regions incl Export[Regions]/Coal Production[Regions]
	~	Dmnl
	~		|

Total Coal Supply from Regions incl Export[Regions]=
	sum(Coal Trade to Meet Demand[Regions,Regions!])
	~	Mtoe/Year
	~	Total coal supply from Region A including domestic supply, and \
		international exports
	|

Gas Trade to Meet Demand[Regions,Africa]=
	Indicated Gas Trade to Meet Demand[Regions,Africa]*Gas Trade Adj Fraction[Africa] ~~|
Gas Trade to Meet Demand[Regions,AsiaPacific]=
	Indicated Gas Trade to Meet Demand[Regions,AsiaPacific]*Gas Trade Adj Fraction[AsiaPacific\
		] ~~|
Gas Trade to Meet Demand[Regions,EastEu]=
	Indicated Gas Trade to Meet Demand[Regions,EastEu]*Gas Trade Adj Fraction[EastEu] ~~|
Gas Trade to Meet Demand[Regions,LAC]=
	Indicated Gas Trade to Meet Demand[Regions,LAC]*Gas Trade Adj Fraction[LAC] ~~|
Gas Trade to Meet Demand[Regions,WestEu]=
	Indicated Gas Trade to Meet Demand[Regions,WestEu]*Gas Trade Adj Fraction[WestEu]
	~	Mtoe/Year
	~	Gas supply matrix.
		"Gas Trade to Meet Demand[Region A, Region A]" means domestic supply; "Gas \
		Trade to Meet Demand[Region A, Region B]" means gas export from Region A \
		to Region B
	|

Gas Trade Adj Fraction[Regions]=
	FIND ZERO(Demand Scale[Regions],Gas Demand Unfullfilled Ratio[Regions],Relative Demand Scale\
		[Regions],Initial Export Fraction Demand[Regions],
	Size n Demand,Skip Demand,Tolerance Demand,Max Iteration Demand,Method Demand)
	~	Dmnl
	~	This is used to solve nonlinear simultaneous algebraic equations of gas \
		export, to make gas demand unfullfilled ratio close to 0.
	|

Ratio between Gas Supply and Production[Regions]=
	Total Gas Supply from Regions incl Export[Regions]/Gas Production[Regions]
	~	Dmnl
	~		|

Total Coal Supply to Regions incl Imports[Regions]=
	sum(Coal Trade to Meet Demand[Regions!,Regions])
	~	Mtoe/Year
	~	total supply of coal (including domestic supply, and international import) \
		to each region
	|

Total Gas Demand from Regions incl Export Demand[Regions]=
	SMOOTHI(Total Gas Supply from Regions incl Export[Regions], 1 , Gas Demand Local[Regions\
		] )
	~	Mtoe/Year
	~	Total demand for gas resources.
	|

Gas Demand Unfullfilled Ratio[Regions]=
	1-Total Gas Supply to Regions incl Imports[Regions]/Gas Demand Local[Regions]
	~	Dmnl
	~		|

Coal Demand Unfullfilled Ratio[Regions]=
	1-Total Coal Supply to Regions incl Imports[Regions]/Coal Demand Local[Regions]
	~	Dmnl
	~		|

Oil Trade to Meet Demand[Regions,Africa]=
	Indicated Oil Trade to Meet Demand[Regions,Africa]*Oil Trade Adj Fraction[Africa] ~~|
Oil Trade to Meet Demand[Regions,AsiaPacific]=
	Indicated Oil Trade to Meet Demand[Regions,AsiaPacific]*Oil Trade Adj Fraction[AsiaPacific\
		] ~~|
Oil Trade to Meet Demand[Regions,EastEu]=
	Indicated Oil Trade to Meet Demand[Regions,EastEu]*Oil Trade Adj Fraction[EastEu] ~~|
Oil Trade to Meet Demand[Regions,LAC]=
	Indicated Oil Trade to Meet Demand[Regions,LAC]*Oil Trade Adj Fraction[LAC] ~~|
Oil Trade to Meet Demand[Regions,WestEu]=
	Indicated Oil Trade to Meet Demand[Regions,WestEu]*Oil Trade Adj Fraction[WestEu]
	~	Mtoe/Year
	~	Oil supply matrix.
		"Oil Trade to Meet Demand[Region A, Region A]" means domestic supply; "Oil \
		Trade to Meet Demand[Region A, Region B]" means oil export from Region A \
		to Region B
	|

Coal Trade to Meet Demand[Regions,Africa]=
	Indicated Coal Trade to Meet Demand[Regions,Africa]*Coal Trade Adj Fraction[Africa] ~~|
Coal Trade to Meet Demand[Regions,AsiaPacific]=
	Indicated Coal Trade to Meet Demand[Regions,AsiaPacific]*Coal Trade Adj Fraction[AsiaPacific\
		] ~~|
Coal Trade to Meet Demand[Regions,EastEu]=
	Indicated Coal Trade to Meet Demand[Regions,EastEu]*Coal Trade Adj Fraction[EastEu] ~~|
Coal Trade to Meet Demand[Regions,LAC]=
	Indicated Coal Trade to Meet Demand[Regions,LAC]*Coal Trade Adj Fraction[LAC] ~~|
Coal Trade to Meet Demand[Regions,WestEu]=
	Indicated Coal Trade to Meet Demand[Regions,WestEu]*Coal Trade Adj Fraction[WestEu]
	~	Mtoe/Year
	~	Coal supply matrix.
		"Coal Trade to Meet Demand[Region A, Region A]" means domestic supply; \
		"Coal Trade to Meet Demand[Region A, Region B]" means coal export from \
		Region A to Region B
	|

Coal Trade Adj Fraction[Regions]=
	FIND ZERO(Demand Scale[Regions],Coal Demand Unfullfilled Ratio[Regions],Relative Demand Scale\
		[Regions],Initial Export Fraction Demand
	[Regions],
	Size n Demand,Skip Demand,Tolerance Demand,Max Iteration Demand,Method Demand)
	~	Dmnl
	~	This is used to solve nonlinear simultaneous algebraic equations of coal \
		export, to make coal demand unfullfilled ratio close to 0.
	|

Total Gas Supply to Regions incl Imports[Regions]=
	sum(Gas Trade to Meet Demand[Regions!,Regions])
	~	Mtoe/Year
	~	total supply of gas (including domestic supply, and international import) \
		to each region
	|

Indicated Coal Trade to Meet Demand[Regions,Africa]=
	(1/Coal Price[Regions]^2)/
	(1/Coal Price[Africa]^2+1/Coal Price[AsiaPacific]^2+1/Coal Price[EastEu]^2+1/Coal Price\
		[LAC]^2+1/Coal Price[WestEu]^2)*
	Coal Demand Local[Africa] ~~|
Indicated Coal Trade to Meet Demand[Regions,AsiaPacific]=
	(1/Coal Price[Regions]^2)/
	(1/Coal Price[Africa]^2+1/Coal Price[AsiaPacific]^2+1/Coal Price[EastEu]^2+1/Coal Price\
		[LAC]^2+1/Coal Price[WestEu]^2)*
	Coal Demand Local[AsiaPacific] ~~|
Indicated Coal Trade to Meet Demand[Regions,EastEu]=
	(1/Coal Price[Regions]^2)/
	(1/Coal Price[Africa]^2+1/Coal Price[AsiaPacific]^2+1/Coal Price[EastEu]^2+1/Coal Price\
		[LAC]^2+1/Coal Price[WestEu]^2)*
	Coal Demand Local[EastEu] ~~|
Indicated Coal Trade to Meet Demand[Regions,LAC]=
	(1/Coal Price[Regions]^2)/
	(1/Coal Price[Africa]^2+1/Coal Price[AsiaPacific]^2+1/Coal Price[EastEu]^2+1/Coal Price\
		[LAC]^2+1/Coal Price[WestEu]^2)*
	Coal Demand Local[LAC] ~~|
Indicated Coal Trade to Meet Demand[Regions,WestEu]=
	(1/Coal Price[Regions]^2)/
	(1/Coal Price[Africa]^2+1/Coal Price[AsiaPacific]^2+1/Coal Price[EastEu]^2+1/Coal Price\
		[LAC]^2+1/Coal Price[WestEu]^2)*
	Coal Demand Local[WestEu]
	~	Mtoe/Year
	~	"Indicated Coal Trade to Meet Demand[Region A, Region B]" represents an indicated \
		value of coal export from Region A to Region B, serving as a starting \
		point for trade modelling. 
		It is calculated based on a logit sharing function considering coal prices \
		in different regions to meet the coal demand of each region.
	|

Total Coal Demand from Regions incl Export Demand[Regions]=
	SMOOTHI(Total Coal Supply from Regions incl Export[Regions], 1 , Coal Demand Local[Regions\
		] )
	~	Mtoe/Year
	~	Total demand for coal resources.
	|

Total Gas Supply from Regions incl Export[Regions]=
	sum(Gas Trade to Meet Demand[Regions,Regions!])
	~	Mtoe/Year
	~	Total gas supply from Region A including domestic supply, and \
		international exports
	|

Total Oil Demand from Regions incl Export Demand[Regions]=
	SMOOTHI(Total Oil Supply from Regions incl Export[Regions], 1 , Oil Demand Local[Regions\
		] )
	~	Mtoe/Year
	~	Total demand for oil resources, including local consumption and net export
	|

Size n Demand=
	ELMCOUNT(Regions)
	~	
	~		|

Oil Demand Unfullfilled Ratio[Regions]=
	1-Total Oil Supply to Regions incl Imports[Regions]/Oil Demand Local[Regions]
	~	Dmnl
	~		|

Oil Shortage[Regions]=
	Total Oil Demand from Regions incl Export Demand[Regions]-Oil Production[Regions]
	~	Mtoe/Year
	~	Difference between demand and the oil production rate.
	~	:SUPPLEMENTARY 
	|

Ratio between Oil Supply and Production[Regions]=
	Total Oil Supply from Regions incl Export[Regions]/Oil Production[Regions]
	~	
	~		|

Total Oil Supply from Regions incl Export[Regions]=
	sum(Oil Trade to Meet Demand[Regions,Regions!])
	~	Mtoe/Year
	~	Total oil supply from Region A including domestic supply, and \
		international exports
	|

Max Iteration Demand=
	5000
	~	
	~		|

Demand Scale[Regions]=
	1
	~	
	~		|

Total Oil Supply to Regions incl Imports[Regions]=
	sum(Oil Trade to Meet Demand[Regions!,Regions])
	~	Mtoe/Year
	~	total supply of oil (including domestic supply, and international import) \
		to each region
	|

Relative Demand Scale[Regions]=
	1
	~	
	~		|

Method Demand=
	1
	~	
	~		|

Oil Trade Adj Fraction[Regions]=
	FIND ZERO(Demand Scale[Regions],Oil Demand Unfullfilled Ratio[Regions],Relative Demand Scale\
		[Regions],Initial Export Fraction Demand
	[Regions],
	Size n Demand,Skip Demand,Tolerance Demand,Max Iteration Demand,Method Demand)
	~	Dmnl
	~	This is used to solve nonlinear simultaneous algebraic equations of oil \
		export, to make oil demand unfullfilled ratio close to 0.
	|

Desired Investment in Oil Production[Regions]=
	MIN(Potential Oil Production from Resources[Regions],Total Oil Demand from Regions incl Export Demand\
		[Regions])/Productivity of Investment in Oil Production
	[Regions]*toe per Mtoe
	~	$/Year
	~	Desired Investment in Oil Production due to Total Oil Demand and \
		Productivity of Investment in Oil Production.
	|

Indicated Oil Trade to Meet Demand[Regions,Africa]=
	(1/Oil Price[Regions]^2)/
	(1/Oil Price[Africa]^2+1/Oil Price[AsiaPacific]^2+1/Oil Price[EastEu]^2+1/Oil Price[\
		LAC]^2+1/Oil Price[WestEu]^2)*
	Oil Demand Local[Africa] ~~|
Indicated Oil Trade to Meet Demand[Regions,AsiaPacific]=
	(1/Oil Price[Regions]^2)/
	(1/Oil Price[Africa]^2+1/Oil Price[AsiaPacific]^2+1/Oil Price[EastEu]^2+1/Oil Price[\
		LAC]^2+1/Oil Price[WestEu]^2)*
	Oil Demand Local[AsiaPacific] ~~|
Indicated Oil Trade to Meet Demand[Regions,EastEu]=
	(1/Oil Price[Regions]^2)/
	(1/Oil Price[Africa]^2+1/Oil Price[AsiaPacific]^2+1/Oil Price[EastEu]^2+1/Oil Price[\
		LAC]^2+1/Oil Price[WestEu]^2)*
	Oil Demand Local[EastEu] ~~|
Indicated Oil Trade to Meet Demand[Regions,LAC]=
	(1/Oil Price[Regions]^2)/
	(1/Oil Price[Africa]^2+1/Oil Price[AsiaPacific]^2+1/Oil Price[EastEu]^2+1/Oil Price[\
		LAC]^2+1/Oil Price[WestEu]^2)*
	Oil Demand Local[LAC] ~~|
Indicated Oil Trade to Meet Demand[Regions,WestEu]=
	(1/Oil Price[Regions]^2)/
	(1/Oil Price[Africa]^2+1/Oil Price[AsiaPacific]^2+1/Oil Price[EastEu]^2+1/Oil Price[\
		LAC]^2+1/Oil Price[WestEu]^2)*
	Oil Demand Local[WestEu]
	~	Mtoe/Year
	~	"Indicated Oil Trade to Meet Demand[Region A, Region B]" represents an indicated \
		value of oil export from Region A to Region B, serving as a starting point \
		for trade modelling. 
		It is calculated based on a logit sharing function considering oil prices \
		in different regions to meet the oil demand of each region.
	|

Initial Export Fraction Demand[Regions]=
	1
	~	
	~		|

Tolerance Demand=
	1
	~	
	~		|

Skip Demand=
	0
	~	
	~		|

Primary Coal Production[Regions]=
	Coal Production[Regions]*Mtoe into EJ
	~	EJ/Year
	~		|

Primary Solar Energy Production[Regions]=
	Solar Energy Production[Regions]*Mtoe into EJ
	~	EJ/Year
	~		|

Regional Population[Regions]=
	Population[Regions]/1e+06
	~	Million
	~		|

Life Expectancy Variation[Regions]=
	Life Expectancy 2000[Regions]
	~	Year
	~		|

Ratio of GDP pc to the reference[Africa]=
	GDP per Capita[Africa]/GDP per Capita 2000[Africa] ~~|
Ratio of GDP pc to the reference[AsiaPacific]=
	GDP per Capita[AsiaPacific]/GDP per Capita 2000[AsiaPacific] ~~|
Ratio of GDP pc to the reference[EastEu]=
	GDP per Capita[EastEu]/GDP per Capita 2000[EastEu] ~~|
Ratio of GDP pc to the reference[LAC]=
	GDP per Capita[LAC]/GDP per Capita 2000[LAC] ~~|
Ratio of GDP pc to the reference[WestEu]=
	GDP per Capita[WestEu]/GDP per Capita 2000[WestEu]
	~	Dmnl
	~	Reference average world gross domestic product per capita.
		A reference value against which the GDP per Capita is compared to \
		calculate the impact of wealth on health.
	|

Ratio of MYS to the reference[Africa]=
	Mean Years of Schooling[Africa]/MYS2000[Africa] ~~|
Ratio of MYS to the reference[AsiaPacific]=
	Mean Years of Schooling[AsiaPacific]/MYS2000[AsiaPacific] ~~|
Ratio of MYS to the reference[EastEu]=
	Mean Years of Schooling[EastEu]/MYS2000[EastEu] ~~|
Ratio of MYS to the reference[LAC]=
	Mean Years of Schooling[LAC]/MYS2000[LAC] ~~|
Ratio of MYS to the reference[WestEu]=
	Mean Years of Schooling[WestEu]/MYS2000[WestEu]
	~	Dmnl
	~	Reference average world gross domestic product per capita.
		A reference value against which the GDP per Capita is compared to \
		calculate the impact of wealth on health.
	|

Impact of GDP on Fertility[Africa]=
	L0 gdp Fer[Africa] + (L gdp fer[Africa] / (1 + EXP(-k gdp fer[Africa]*(GDP per Capita\
		[Africa]/GDP per Capita 2000
	[Africa]-x0 gdp fer[Africa])))) ~~|
Impact of GDP on Fertility[AsiaPacific]=
	L0 gdp Fer[AsiaPacific] + (L gdp fer[AsiaPacific] / (1 + EXP(-k gdp fer[AsiaPacific]\
		*(GDP per Capita[AsiaPacific]/GDP per Capita 2000
	[AsiaPacific]-x0 gdp fer[AsiaPacific])))) ~~|
Impact of GDP on Fertility[EastEu]=
	L0 gdp Fer[EastEu] + (L gdp fer[EastEu] / (1 + EXP(-k gdp fer[EastEu]*(GDP per Capita\
		[EastEu]/GDP per Capita 2000
	[EastEu]-x0 gdp fer[EastEu])))) ~~|
Impact of GDP on Fertility[LAC]=
	L0 gdp Fer[LAC] + (L gdp fer[LAC] / (1 + EXP(-k gdp fer[LAC]*(GDP per Capita[LAC]/GDP per Capita 2000
	[LAC]-x0 gdp fer[LAC])))) ~~|
Impact of GDP on Fertility[WestEu]=
	L0 gdp Fer[WestEu] + (L gdp fer[WestEu] / (1 + EXP(-k gdp fer[WestEu]*(GDP per Capita\
		[WestEu]/GDP per Capita 2000
	[WestEu]-x0 gdp fer[WestEu]))))
	~	Dmnl
	~	Decreasing logistic function of which parameters are estimated from the \
		global average GDP per capita - Total Fertility relationship, also \
		considering the impact of Mean Years of Schooling.
	|

Impact of Education on Fertility[Africa]=
	L0 edu Fer[Africa] + (L edu fer[Africa] / (1 + EXP(-k edu fer[Africa]*(Mean Years of Schooling\
		[Africa]/MYS2000[
	Africa]-x0 edu fer[Africa])))) ~~|
Impact of Education on Fertility[AsiaPacific]=
	L0 edu Fer[AsiaPacific] + (L edu fer[AsiaPacific] / (1 + EXP(-k edu fer[AsiaPacific]\
		*(Mean Years of Schooling[AsiaPacific]/MYS2000[AsiaPacific]-x0 edu fer[AsiaPacific]\
		)))) ~~|
Impact of Education on Fertility[EastEu]=
	L0 edu Fer[EastEu] + (L edu fer[EastEu] / (1 + EXP(-k edu fer[EastEu]*(Mean Years of Schooling\
		[EastEu]/MYS2000[
	EastEu]-x0 edu fer[EastEu])))) ~~|
Impact of Education on Fertility[LAC]=
	L0 edu Fer[LAC] + (L edu fer[LAC] / (1 + EXP(-k edu fer[LAC]*(Mean Years of Schooling\
		[LAC]/MYS2000[
	LAC]-x0 edu fer[LAC])))) ~~|
Impact of Education on Fertility[WestEu]=
	L0 edu Fer[WestEu] + (L edu fer[WestEu] / (1 + EXP(-k edu fer[WestEu]*(Mean Years of Schooling\
		[WestEu]/MYS2000[
	WestEu]-x0 edu fer[WestEu]))))
	~	Dmnl
	~	Decreasong logistic function of which parameters are estimated from the \
		global average MYS - Total Fertility relationship, also considering the \
		impact of GDP.
	|

Biomass Capacity Factor[Regions]=
	MINBCF[Regions]+(MAXBCF-MINBCF[Regions])*(Biomass Energy Technology Ratio[Regions]/(\
		Biomass Energy Technology Ratio[Regions]+1))
