Rate of New Discovery Oil[Regions]=
	Mtoe per Barrel*Annual Change in Oil Reserves[Regions]
	~	Mtoe/Year
	~		|

Net Change in Other Capital[Regions]=
	(Other Capital Change[Regions]*Current to Max Other Capital[Regions]/Time to Adjust Other Capital\
		)
	~	$/(Year*Year)
	~	Adjustment of capital changes in sectors other than energy.
	|

Total Oil Resources[Regions]=
	Undiscovered Oil Resources[Regions]+Cumulative Additions to Oil Production[Regions]
	~	Mtoe
	~	Total oil resources including Undiscovered Oil Resources, Identified Oil \
		Resources and resources already produced i.e. Cumulative Oil Production.
	|

Investment in Oil Production[Regions]=
	Desired Investment in Oil Production[Regions]
	~	$/Year
	~	Amount of resources dedicated to oil production.
	|

Potential Oil Exploration[Regions]=
	Effective Investment in Oil Exploration[Regions]*Productivity of Investment in Oil Exploration\
		[Regions]/toe per Mtoe
	~	Mtoe/Year
	~	Potential Oil exploration due to available investments in oil resources \
		discovery.
	|

Potential Oil Production[Regions]=
	MIN(Potential Oil Production from Investment[Regions],Potential Oil Production from Resources\
		[Regions])
	~	Mtoe/Year
	~	Potential Oil Production due to available investments in oil resources \
		recovery and recovery technology.
	|

Oil Production Coverage[Regions]=
	Identified Oil Resources[Regions]/Average Oil Production[Regions]
	~	Year
	~	Ratio indicating oil coverage in years for discovered resources and at the \
		current average oil production.
	|

Fraction Invested in Oil Discovery Technology[Regions]=
	Table for FIODT(Oil Fraction Discoverable[Regions])
	~	Dmnl
	~	Fraction of investments in oil technology dedicated to discovery \
		technology.
	|

Change in Average Oil Production[Regions]=
	(Oil Production[Regions]-Average Oil Production[Regions])/Time to Average Oil Production
	~	Mtoe/(Year*Year)
	~	Change in Average Oil Production.
	|

Effective Investment in Oil Exploration[Regions]= INTEG (
	Change in Effective Investment in Oil Exploration[Regions],
		INIT EIOE[Regions])
	~	$/Year
	~	Effective investments dedicated for oil resources exploration.
	|

OLDNet Capital Change Rate[Regions]=
	OLDNet Capital Change[Regions]
	~	$/Year
	~	Net Capital Stock change rate.
	~	:SUPPLEMENTARY 
	|

Potential Oil Production from Investment[Regions]=
	Productivity of Investment in Oil Production[Regions]*Effective Investment in Oil Production\
		[Regions]/toe per Mtoe
	~	Mtoe/Year
	~	Potential Oil Production due to available investments in oil resources \
		recovery.
	|

Oil Exploration Rate[Regions]=
	MIN(Desired Oil Exploration Rate[Regions],Potential Oil Exploration[Regions])
	~	Mtoe/Year
	~	Oil Exploration Rate accounting for potential and desired oil exploration \
		rates.
	|

OLDNet Capital Change[Regions]=
	Net Energy Capital Change[Regions]+Other Capital Change[Regions]
	~	$/Year
	~	Net capital change.
	|

Investment in Oil Exploration[Regions]=
	Desired Investment in Oil Exploration[Regions]
	~	$/Year
	~	Amount of resources dedicated to oil exploration.
	|

Oil Productivity of Investment[Regions]= INTEG (
	Change in Oil Productivity of Investment[Regions],
		INIT OPI[Regions])
	~	toe/$
	~	Factor indicating productivity of investments in oil production.
	|

Undiscovered Oil Resources[Regions]= INTEG (
	Rate of New Discovery Oil[Regions]-Oil Exploration[Regions],
		INIT UORN[Regions])
	~	Mtoe
	~	Existing Oil Resources but not discovered yet.
	|

Total Oil Recoverable Resource Remaining[Regions]=
	(Cumulative Additions to Oil Production[Regions]-Cumulative Oil Production[Regions])\
		*Oil Fraction Recoverable[Regions]
	~	Mtoe
	~	Total Oil Recoverable Resources Remaining as a percentage of Cumulative \
		Additions to Oil Production. It already produced resources. The percentage \
		is determined by production technology developments.
	|

Investment in Oil Discovery Technology[Regions]=
	Investment in Oil Technology[Regions]*Fraction Invested in Oil Discovery Technology[\
		Regions]
	~	$/Year
	~	Total investments in oil exploration technology.
	|

