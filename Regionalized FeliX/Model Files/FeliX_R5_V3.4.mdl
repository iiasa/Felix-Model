	Desired animal food production[LAC,PasMeat] ~~|
Indicated PasMeat Trade to Meet Demand[Regions,WestEu]=
	(1/Initial Agricultural Product Prices[Regions,PasMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,PasMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,PasMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,PasMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,PasMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,PasMeat]^2)*
	Desired animal food production[WestEu,PasMeat]
	~	Ton/Year
	~	"Indicated PasMeat Trade to Meet Demand[Region A, Region B]" represents an indicated \
		value of pasture meat export from Region A to Region B, serving as a \
		starting point for trade modelling. 
		It is calculated based on a logit sharing function considering pasture \
		meat prices in different regions to meet the pasture meat demand of each \
		region.
	|

Excess Demand Dairy[Regions]=
	Desired animal food production[Regions,Dairy]-sum(Dairy Trade to Meet Demand[Regions\
		!,Regions])
	~	
	~	demand = supply = production + import - export
	|

Annual Caloric Demand inc Waste[Regions,FoodCategories]=
	Annual Caloric Demand[Regions,FoodCategories]/(1-Waste fraction Data[Regions,FoodCategories\
		])
	~	Mkcal/Year
	~	Total Annual Calorie Demand for Food Category[FoodCategories]/(1-Waste \
		fraction[FoodCategories])
	|

Total Agricultural and Land Use C Emissions=
	MAX(0, 
	sum(C Emission from Land Use[Regions!])
	- Climate Policy Scenario*SMOOTH(RAMP(Land Mitigation Policy Multiplier*sum(C Emission from Land Use\
		[Regions!]),Climate Action Year, Climate Action Year+20), 
	Land Mitigation Policy Transition Period))
	~	TonC/Year
	~		|

Total C Emission=
	sum(Total C Emission from the Energy Sector[Regions!])+Total Agricultural and Land Use C Emissions
	~	TonC/Year
	~	Emissions of carbon from energy use and other sources.
	|

Agriculture Land Energy Yield[Regions]=
	Nominal Energy Agriculture Land Productivity[Regions]*
	Effect of Carbon Concentration on Agricultural Yield*
	Effect of Climate Change on Agricultural Yield*
	Effect of Input Neutral Technology Change on Agricultural Land Fertility[Regions]*
	Effect of Water Withdrawal on Agriculture Land Fertility*
	Effect of Management Practices on Agriculture Land Fertility
	~	Biomass ton/(Year*ha)
	~	Yield from a unit energy crops land area.
	|

Nominal Energy Agriculture Land Productivity[Regions]=
	Nominal Energy Agriculture Land Productivity Variation[Regions] + STEP(Nominal Energy Agriculture Land Productivity Variation\
		[Regions]-Nominal Energy Agriculture Land Productivity Variation[Regions], 2020)
	~	Biomass ton/(ha*Year)
	~	Reference annual amount of energy crops biomass yield from unit energy \
		crops land area.
	|

