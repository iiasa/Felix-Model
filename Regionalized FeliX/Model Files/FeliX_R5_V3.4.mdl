Impact of Climate Damage on Biodiversity[Regions]=
	1/(1+Biodiversity Impact Climate Damage Scale[Regions]*(Temperature Change from Preindustrial\
		/Biodiversity Impact Reference Temperature[Regions]
	)^Biodiversity Impact Climate Damage Nonlinearity[Regions])
	~	Dmnl
	~	Nonlinear function representing impact of climate risk on species carrying \
		capacity.
	|

Impact of Other Land Changes on Biodiversity[Regions]=
	(Other Land[Regions]/INIT Other Land[Regions])^Impact of Other Land Changes on Biodiversity Elasticity\
		[Regions]
	~	Dmnl
	~	Nonlinear function representing impact of other land use change on species \
		carrying capacity.
	|

Impact of Fertilizer Consumption on Biodiversity[Regions]=
	1/(1+Biodiversity Impact Fertilizer Consumption Scale[Regions]*(Total Fertilizer Runoff and Leaching\
		[Regions]/Biodiversity Impact Reference Fertilizer Consumption[Regions]
	)^Biodiversity Impact Fertilizer Consumption Nonlinearity[Regions])
	~	Dmnl
	~	Nonlinear function representing impact of fertilization practices on \
		species carrying capacity.
	~	:SUPPLEMENTARY 
	|

Impact of Agricultural Land Changes on Biodiversity[Regions]=
	(1/(Agricultural Land[Regions]/INIT Agricultural Land[Regions]))^Impact of Agricultural Land Changes on Biodiversity Elasticity\
		[Regions]
	~	Dmnl
	~	Nonlinear function representing impact of agricultural land use change on \
		species carrying capacity.
	|

Impact of Forest Biomass Production on Biodiversity[Regions]=
	(1-Forest Biomass Production Land Ratio[Regions])^Forest Biomass Production on Biodiversity Elasticity\
		[Regions]
	~	Dmnl
	~	Nonlinear function representing impact of forest biomass production on \
		species carrying capacity.
	|

Impact of Forest Land Changes on Biodiversity[Regions]=
	(Forest Land[Regions]/INIT Forest Land[Regions])^(Impact of Forest Land Changes on Biodiversity Elasticity\
		[Regions])
	~	Dmnl
	~	Nonlinear function representing impact of forest land use change on \
		species carrying capacity.
	|

Impact of Agriculture Biomass Production on Biodiversity[Regions]=
	(1-Agriculture Biomass Production Land Ratio[Regions])^Agriculture Biomass Production on Biodiversity Elasticity\
		[Regions]
	~	Dmnl
	~	Nonlinear function representing impact of crops biomass production on \
		species carrying capacity.
	|

Species Carrying Capacity[Regions]=
	Reference Species Carrying Capacity[Regions]*
	Impact of Biomass Production on Biodiversity[Regions]*
	Impact of Climate Damage on Biodiversity[Regions]*
	Impact of Fertilizer Consumption on Biodiversity[Regions]*
	Impact of Land Use Change on Biodiversity[Regions]
	~	Dmnl
	~	The carrying capacity defines the equilibrium or maximum sustainable \
		species population. It is impacted by fertilization, biomas production, \
		climate risk and land use change.
	|

Total Vegetarians by Age Gender[Regions,Gender,Cohorts]=
	sum(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education!])
	~	People/Year
	~		|

Total Meat Eaters by Age Gender[Regions,Gender,Cohorts]=
	sum("Meat-based Diet Followers"[Regions,Gender,Cohorts,Education!])
	~	People/Year
	~		|

Average calorie intake by gender ans cohort[Regions,FoodCategories,Gender,Cohorts]=
	(Average calorie intake in meat diet[Regions,FoodCategories,Gender,Cohorts]*sum("Meat-based Diet Followers"\
		[Regions,Gender,Cohorts,Education!])+
	Average calorie intake in vegetarian diet[Regions,FoodCategories,Gender,Cohorts]*sum\
		(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education!]))/
	(sum(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education!])+sum("Meat-based Diet Followers"\
		[Regions,Gender,Cohorts,Education!]))
	~	
	~		|

"Age and gender adjustment - MEAT DIET"[Regions,FoodCategories,Gender,Cohorts]=
	AVERAGE TOTAL CALORIE CONSUMPTION[Gender,Cohorts]/World avg calorie consumption[Regions\
		]*Reference meat diet composition[Regions,FoodCategories]
	~	
	~		|

Food Demand excl Waste in tonnes[Regions,FoodCategories]=
	Annual Caloric Demand[Regions,FoodCategories]/Caloric value of food[Regions,FoodCategories\
		]
	~	Ton/Year
	~		|

Food demand inc Waste in tonnes[Regions,FoodCategories]=
	Annual Caloric Demand inc Waste[Regions,FoodCategories]/Caloric value of food[Regions\
		,FoodCategories]
	~	Ton/Year
	~		|

Reference meat diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts]=
	"Age and gender adjustment - MEAT DIET"[Regions,FoodCategories,Gender,Cohorts]
	~	Dmnl
	~		|

Caloric value of food[Regions,FoodCategories]=
	Caloric value of food Data[Regions,FoodCategories]*(1+STEP(SA multiplier for caloric value\
		-1, 2020))
	~	Mkcal/Ton
	~		|

Meat diet composition multipliers[Regions,FoodCategories,Gender,Cohorts]=
	IF THEN ELSE(Diet Composition Switch[Regions]=0 :OR: Diet Composition Switch[Regions\
		]=1, 
	Reference meat diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts],
	IF THEN ELSE(Diet Composition Switch[Regions]=2 :OR: Diet Composition Switch[Regions\
		]=3,
	Meat diet composition multiplier Sc2[Regions,FoodCategories,Gender,Cohorts],
	Meat diet composition multiplier Sc4[Regions,FoodCategories,Gender,Cohorts]))
	~	Dmnl
	~		|

Food supply in kcal[Regions,FoodCategories]=
	Caloric value of food[Regions,FoodCategories]*Food supply in tonnes[Regions,FoodCategories\
		]
	~	Mkcal/Year
	~		|

"Age and gender adjustment - HEALTH DIET"[Regions,FoodCategories,Gender,Cohorts]=
	AVERAGE TOTAL CALORIE CONSUMPTION[Gender,Cohorts]/World avg calorie consumption[Regions\
		]*"Health Diet WHO - Springmann"[FoodCategories]
	~	
	~		|

Meat diet composition multiplier Sc2[Regions,FoodCategories,Gender,Cohorts]=
	Reference meat diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts] \
		+
	Smooth Diet Switch Fnc[Regions]* (Healthy diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts]-Reference meat diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts])
	~	Dmnl
	~		|

"Age and gender adjustment - VEGAN DIET"[Regions,FoodCategories,Gender,Cohorts]=
	AVERAGE TOTAL CALORIE CONSUMPTION[Gender,Cohorts]/World avg calorie consumption[Regions\
		]*Vegan Diet[FoodCategories]
	~	Dmnl
	~		|

"Age and gender adjustment - VEGETARIAN DIET"[Regions,FoodCategories,Gender,Cohorts]=
	AVERAGE TOTAL CALORIE CONSUMPTION[Gender,Cohorts]/World avg calorie consumption[Regions\
		]*Reference vegetarian diet composition[Regions,FoodCategories]
	~	
	~		|

Vegan diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts]=
	"Age and gender adjustment - VEGAN DIET"[Regions,FoodCategories,Gender,Cohorts]
	~	Dmnl
	~		|

Flexitarian diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts]=
	"Age and gender adjustment - FLEXITARIAN DIET"[Regions,FoodCategories,Gender,Cohorts\
		]
	~	Dmnl
	~		|

Vegetarian diet composition multipliers[Regions,FoodCategories,Gender,Cohorts]=
	IF THEN ELSE(Diet Composition Switch[Regions]=3 :OR: Diet Composition Switch[Regions\
		]=4,
	Vegetarian diet composition multiplier Sc3[Regions,FoodCategories,Gender,Cohorts],
	Reference vegetarian diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts\
		])
	~	Dmnl
	~		|

Reference vegetarian diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts\
		]=
	"Age and gender adjustment - VEGETARIAN DIET"[Regions,FoodCategories,Gender,Cohorts]
	~	Dmnl
	~		|

"Age and gender adjustment - FLEXITARIAN DIET"[Regions,FoodCategories,Gender,Cohorts]\
		=
	AVERAGE TOTAL CALORIE CONSUMPTION[Gender,Cohorts]/World avg calorie consumption[Regions\
		]*Global Average Diet Composition FLEX[FoodCategories]
	~	Dmnl
	~		|

Vegetarian diet composition multiplier Sc3[Regions,FoodCategories,Gender,Cohorts]=
	Reference vegetarian diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts\
		]+Smooth Diet Switch Fnc[Regions]*(Vegan diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts]-Reference vegetarian diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts])
	~	Dmnl
	~		|

Healthy diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts]=
	"Age and gender adjustment - HEALTH DIET"[Regions,FoodCategories,Gender,Cohorts]
	~	Dmnl
	~		|

Meat diet composition multiplier Sc4[Regions,FoodCategories,Gender,Cohorts]=
	Reference meat diet decomposition multiplier[Regions,FoodCategories,Gender,Cohorts] \
		+ 
	Smooth Diet Switch Fnc[Regions]*(Flexitarian diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts]-Reference meat diet decomposition multiplier[Regions,FoodCategories\
		,Gender,Cohorts])
	~	Dmnl
	~		|

Average Kcal Intake per Person FLEX[Regions,FoodCategories]=
	Average Total Daily Calorie Intake[Regions]*Global Average Diet Composition FLEX[FoodCategories\
		]
	~	kcal/(Person*Day)
	~		|

