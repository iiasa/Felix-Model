Arable Land Allocated for Crops[Regions]=
	MIN(Arable Land[Regions], Total Demand for Arable Land[Regions])
	~	ha
	~		|

Distortion Function T=
	IF THEN ELSE(Temperature Change from Preindustrial<=p Effect of T on Yield , 
	1+m Effect of T on Yield*(Temperature Change from Preindustrial-alpha)/(p Effect of T on Yield\
		-alpha), 
	1+m Effect of T on Yield - (1+m Effect of T on Yield-u Effect of T on Yield)*(Temperature Change from Preindustrial\
