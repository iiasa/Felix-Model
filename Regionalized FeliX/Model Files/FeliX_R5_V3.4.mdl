WorkingAge Population[Regions,Gender,WorkingAge,skill]=
	Fraction of skilled secondary education graduates*Secondary Education[Regions,Gender\
		,WorkingAge]+Tertiary Education[Regions
	,Gender,WorkingAge] ~~|
