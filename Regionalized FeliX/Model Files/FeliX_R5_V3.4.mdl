TABLE Other Anthropogenic Radiative Forcing(
	[(0,0)-(10,10)],(1900,0),(2005,-0.557989))
	~	W/(Meter*Meter)
	~	Data series for historical data of other radiative forcing. 2005 AND 2010 from the \
		SSP database, SSP2 Message-GLOBIOM (marker).
		Calculated as (total forcing) - (CO2, CH4, N2O and F-Gases forcings)
	|

Heat Transfer Rate=
	1.23
	~	Watt/(Meter*Meter)/DegreesC
	~	Rate of heat transfer between the surface and deep ocean.
	|

Heat to 2000m=
	Heat to 700m+Heat in Deep Ocean 3
	~	Year*W/(Meter*Meter)
	~	Heat to 2000m in deep ocean. Assumes default layer thicknesses, i.e., 100 \
		m for the mixed ocean, 300 m each for layers 1 and 2, and 1300 m for layer \
		3.
	|

Heat to 2000m J=
	Heat to 2000m*J per W Year*(Area*(1-Land Area Fraction))
	~	Je22
	~	Heat to 2000m in Joules*1e22 for the area covered by water.
	|

N2O Radiative Forcing RCP19=
	TABLE N2O Radiative Forcing SSP2 RCP19(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of N2O radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 1.9).
	|

Climate Sensitivity to 2xCO2=
	3
	~	DegreesC
	~	Equilibrium temperature change in response to a 2xCO2 equivalent change in \
		radiative forcing. Deterministic = 3,  Low=2, High =4.5.
	|

N2O Radiative Forcing RCP34=
	TABLE N2O Radiative Forcing SSP2 RCP34(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of N2O radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (SSP2 RCP 3.4).
	|

N2O Radiative Forcing RCP45=
	TABLE N2O Radiative Forcing SSP2 RCP45(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of N2O radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 4.5).
	|

Other Radiative Forcing AIM RCP7=
	TABLE Other Radiative Forcing AIM SSP3 RCP7(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of other radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MESSAGE (RCP \
		8.5).
	|

Heat Transfer 4=
	(Relative Deep 3 Ocean Temperature-Relative Deep 4 Ocean Temperature)*Heat Transfer Coefficient 4\
		/Mean Depth of Adjacent 3 4 Layers
	~	W/(Meter*Meter)
	~	Heat transfer from the third to the fourth layer of the deep ocean.
	|

Other Radiative Forcing IMAGE RCP26=
	TABLE Other Radiative Forcing IMAGE RCP26(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of other radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by IMAGE (RCP \
		2.6).
	|

Other Radiative Forcing MESSAGE RCP85=
	TABLE Other Radiative Forcing MESSAGE RCP85(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of other radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MESSAGE (RCP \
		8.5).
	|

Heat Transfer Coefficient 4=
	((Heat Transfer Rate*Mean Depth of Adjacent 3 4 Layers)*(Heat Diffusion Covar*(Eddy diff coeff 3 4\
		/Eddy diff coeff mean 3 4)+(1-Heat Diffusion Covar)))
	~	W/(Meter*DegreesC)
	~	The ratio of the actual to the mean of the heat transfer coefficient, \
		which controls the movement of heat through the climate sector.
	|

Heat in Deep Ocean 4= INTEG (
	Heat Transfer 4,
		INIT Deep Ocean 4 Temperature*Deep Ocean 4 Heat Capacity)
	~	Year*Watt/(Meter*Meter)
	~	Heat content of the fourth layer of the deep ocean.
	|

J per W Year=
	365*24*60*60/1e+22
	~	Je22/Watt/Year
	~	Convertion from watts*year to Joules*1e22.
	|

CH4 Radiative Forcing RCP34=
	TABLE CH4 Radiative Forcing SSP2 RCP34(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of CH4 radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MESSAGE (RCP \
		8.5).
	|

F Gases Radiative Forcing RCP85=
	TABLE F Gases Radiative Forcing SSP2 RCP85(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of f gases radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MESSAGE (RCP \
		8.5).
	|

TABLE HFC Radiative Forcing MiniCAM RCP45(
	[(2000,0)-(2100,1)],(2005,0.34),(2010,0.344),(2020,0.348),(2030,0.344),(2040,0.323),\
		(2050,0.279),(2060,0.242),(2070,0.215),(2080,0.197),(2090,0.188),(2100,0.183))
	~	W/(Meter*Meter)
	~	Data series for future projections of HFC radiative forcing by MiniCAM \
		(RCP 4.5).
	|

Equilibrium Temperature=
	CO2 Radiative Forcing/(Climate Feedback Parameter*LN(2))
	~	DegreesC
	~	Ratio of Radiative Forcing to the Climate Feedback Parameter
	|

TABLE N2O Radiative Forcing SSP2 RCP19(
	[(0,0)-(10,10)],(2010,0.167804),(2020,0.190979),(2030,0.212475),(2040,0.22977),(2050\
		,0.240821),(2060,0.246385),(2070,0.248219),(2080,0.247229),(2090,0.244504),(2100,0.240289\
		))
	~	W/(Meter*Meter)
	~	Data series for future projections of N2O radiative forcing by \
		MESSAGE-GLOBIOM (RCP 1.9).
	|

Heat Diffusion Covar=
	1
	~	Dmnl
	~	Heat transfer coefficient parameter.
	|

Heat in Atmosphere and Upper Ocean= INTEG (
	Effective Radiative Forcing-Feedback Cooling-Heat Transfer 1,
		INIT Atmospheric and Upper Ocean Temperature*Atmospheric and Upper Ocean Heat Capacity\
		)
	~	Year*Watt/(Meter*Meter)
	~	Temperature of the atmosphere and the mixed ocean layer.
	|

Heat in Deep Ocean 1= INTEG (
	Heat Transfer 1-Heat Transfer 2,
		INIT Deep Ocean 1 Temperature*Deep Ocean 1 Heat Capacity)
	~	Year*Watt/(Meter*Meter)
	~	Heat content of the first layer of the deep ocean.
	|

Heat in Deep Ocean 2= INTEG (
	Heat Transfer 2-Heat Transfer 3,
		INIT Deep Ocean 2 Temperature*Deep Ocean 2 Heat Capacity)
	~	Year*Watt/(Meter*Meter)
	~	Heat content of the second layer of the deep ocean.
	|

Heat in Deep Ocean 3= INTEG (
	Heat Transfer 3-Heat Transfer 4,
		INIT Deep Ocean 3 Temperature*Deep Ocean 3 Heat Capacity)
	~	Year*Watt/(Meter*Meter)
	~	Heat content of the third layer of the deep ocean.
	|

Other Radiative Forcing MiniCAM RCP45=
	TABLE Other Radiative Forcing MiniCAM RCP45(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of other radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by MiniCAM (RCP \
		4.5).
	|

CH4 Radiative Forcing RCP19=
	TABLE CH4 Radiative Forcing SSP2 RCP19(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of CH4 radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 1.9).
	|

CH4 Radiative Forcing RCP26=
	TABLE CH4 Radiative Forcing SSP2 RCP26(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of CH4 radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by \
		MESSAGE-GLOBIOM (RCP 2.6).
	|

INIT Atmospheric and Upper Ocean Temperature=
	0
	~	DegreesC
	~	Initial value of Atmospheric and Upper Ocean Temperature.
		
		GET XLS CONSTANTS('InitialValues.xlsx','Stocks','F66')
	|

Other Forcings=
	CH4 Radiative Forcing+N2O Radiative Forcing+F Gases Radiative Forcing+Other Anthropogenic Radiative Forcing
	~	W/(Meter*Meter)
	~	Radiative forcing from factors other than CO2 in the atmosphere.
	|

Heat to 700m J=
	Heat to 700m*J per W Year*(Area*(1-Land Area Fraction))+Offset 700m Heat
	~	Je22
	~	Heat to 700 m in Joules*1e22 for the area covered by water. Source of Historical \
		Data:
		NOAA – Ocean heat content anomalies; 
		http://www.nodc.noaa.gov/OC5/3M_HEAT_CONTENT/
		Levitus S., J. I. Antonov, T. P. Boyer, R. A. Locarnini, H. E. Garcia, and \
		A. V. Mishonov, 2009. Global ocean heat content 1955-2008 in light of \
		recently revealed instrumentation problems GRL, 36, L07608, \
		doi:10.1029/2008GL037155.
	|

Other Radiative Forcing=
	IF THEN ELSE(Time<2000,Other Radiative Forcing History,
	IF THEN ELSE(RCP Scenario=1,Other Radiative Forcing IMAGE RCP26,
	IF THEN ELSE(RCP Scenario=2,Other Radiative Forcing MiniCAM RCP45,
	IF THEN ELSE(RCP Scenario=3, Other Radiative Forcing AIM RCP60,
	IF THEN ELSE(RCP Scenario=4, Other Radiative Forcing MESSAGE RCP85,
	Other Radiative Forcing AIM RCP7)))))
	~	W/(Meter*Meter)
	~	Radiative forcing from other factors than CO2, CH4, N2O and HFC in the \
		atmosphere.
	|

Other Radiative Forcing AIM RCP60=
	TABLE Other Radiative Forcing AIM RCP60(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Future projections of other radiative forcing from Representative \
		Concentration Pathways prepared for the Fifth Assessment Report of the \
		United Nations Intergovernmental Panel on Climate Change by AIM (RCP 6.0).
	|

Upper Layer Volume Vu=
	Area*(Land Area Fraction*Land Thickness+(1-Land Area Fraction)*Mixed Layer Depth)
	~	Meter*Meter*Meter
	~	Water equivalent volume of the upper box, which is a weighted combination \
		of land, atmosphere,and upper ocean volumes.
	|

F Gases Radiative Forcing History=
	TABLE F Gases Radiative Forcing(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Historical data for radiative forcing from CH4 in the atmosphere.
	|

Heat Transfer Coefficient 1=
	((Heat Transfer Rate*Mean Depth of Adjacent M 1 Layers)*(Heat Diffusion Covar*(Eddy diff coeff M 1\
		/Eddy diff coeff mean M 1)+(1-Heat Diffusion Covar)))
	~	W/(Meter*DegreesC)
	~	The ratio of the actual to the mean of the heat transfer coefficient, \
		which controls the movement of heat through the climate sector.
	|

Volumetric Heat Capacity=
	Mass Heat Capacity*Watt per J s/sec per Year*Density
	~	Year*W/(Meter*Meter*Meter*DegreesC)
	~	Volumetric heat capacity of water, i.e., amount of heat in watt*year \
		required to raise 1 cubic meter of water by one degree C.
	|

CH4 Radiative Forcing History=
	TABLE CH4 Radiative Forcing(Time*Dimensionless Time)
	~	W/(Meter*Meter)
	~	Historical data for radiative forcing from CH4 in the atmosphere.
	|

TABLE F Gases Radiative Forcing SSP2 RCP19(
	[(0,0)-(10,10)],(2010,0.0311024),(2020,0.0613296),(2030,0.0770876),(2040,0.0756992),\
