Carbon Price Finish=
	2100
	~	Year
	~		|

Carbon Price Slope=
	5
	~	$/tCO2/Year
	~		|

Impact of climate change on mortality opt0[Regions]=
	- y climate mortality[Regions] + 
	"100 percent"*(Climate mortality saturation[Regions] / (1 + EXP(-Climate mortality steepness\
		[Regions] * (Temperature Change from Preindustrial - Climate mortality inflection[Regions\
		]))))
	~	percent
	~		|

Impact of climate change on mortality opt1[Regions]=
	IF THEN ELSE(Mean Years of Schooling[Regions]>8.5, 
	Opt1 temperature coeff[Regions]*Temperature Change from Preindustrial + Opt1 MYS coeff\
		[Regions]*Mean Years of Schooling[Regions] + Opt1 constant[Regions]
	,Opt1 temperature coeff[Regions]*Temperature Change from Preindustrial + Opt1 constant\
		[Regions])
	~	percent
	~		|

Impact of climate change on mortality opt2[Regions]=
	Opt2 temperature coeff[Regions]*Temperature Change from Preindustrial + Opt2 edu coeff\
		[Regions]*"Share of females aged 20-39 with sec+ education"[Regions] + Opt2 constant\
		[Regions]
	~	percent
	~		|

Unit Cost of Coal Production[Regions]=
	1/Productivity of Investment in Coal Production[Regions]*toe per Mtoe+Climate Policy Scenario\
		*CO2 Intensity of Fuels
	[Coal]*Carbon Price
	~	$/Mtoe
	~	Unit cost of coal production. ZIDZ(1, Productivity of Investment in Coal \
		Production/Million toe per Mtoe)
	|

Effect of Temp on C Flux Atm ML=
	1-Sensitivity of C flux to temp*Temperature Change from Preindustrial
	~	Dmnl
	~		|

Impact of Education on Life Expectancy[Regions]=
	L LE mys[Regions] / (1 + EXP(-k LE mys[Regions] * (Ratio of MYS to the reference[Regions\
		]-x0 LE mys[Regions])))
	~	Dmnl
	~	Impact of wealth on health services availability.
	~	:SUPPLEMENTARY 
	|

Unit Cost of Gas Production[Regions]=
	1/Productivity of Investment in Gas Production[Regions]*toe per Mtoe+Climate Policy Scenario\
		*CO2 Intensity of Fuels[Gas]*Carbon Price
	~	$/Mtoe
	~	Unit cost of gas production.
	|

Impact of Food on Life Expectancy[Regions]=
	L food pop[Regions] / (1 + EXP(-k food pop[Regions] * (Food Ratio[Regions] - x0 food pop\
		[Regions])))
	~	Dmnl
	~	Impact of food availability on life expectancy.
	|

Unit Cost of Oil Production[Regions]=
	1/Productivity of Investment in Oil Production[Regions]*toe per Mtoe+Climate Policy Scenario\
		*CO2 Intensity of Fuels
	[Oil]*Carbon Price
	~	$/Mtoe
	~	Unit cost of oil production.
	|

Reference Life Expectancy at Birth[Regions]=
	Life Expectancy 2000[Regions] + SMOOTH3(STEP(Life Expectancy Variation[Regions]-Life Expectancy 2000\
		[Regions],Current year
	),SSP Demographic Variation Time)
	~	Year
	~		~	:SUPPLEMENTARY 
	|

Subsistence Food per Capita[Regions]=
	SA Subsistence Food per Capita[Regions]
	~	kcal/(Person*Day)
	~	Subsistence amount of food per person required to survive.
		
		2000 + STEP(SA Subsistence Food per Capita[Regions]-2000, 2020)
	|

Climate mortality saturation[Regions]=
	Climate mortality saturation 0[Regions]
	~	percent
	~	Climate mortality saturation 0 + STEP(Climate mortality saturation SA-Climate \
		mortality saturation 0, Current year)
		
		The parameter that defines the saturation level of the logistic function \
		representing temperature-mortality relation. "..0" is the value that \
		defines the original function calibrated to Bressler et al. 2021, "... SA" \
		is the value that can be user-set to cover the uncertainty range after  \
		the current year.
	|

Life Expectancy at Birth[Regions]=
	Reference Life Expectancy at Birth[Regions]*Impact of Wealth on Health[Regions]*Impact of Education on Life Expectancy\
		[Regions]*Lifetime Multiplier from Food[Regions]*Lifetime Multiplier from Climate Risk\
		[Regions]
	~	Year
	~	The global average life expectancy at birth. Source of historical data: World Bank
		
		origin function:
		Reference Life Expectancy at Birth[Regions]*Impact of Wealth on \
		Health[Regions]*Impact of Education on Life Expectancy[
		Regions]*Lifetime Multiplier from Food[Regions]*Lifetime Multiplier from \
		Climate Risk[Regions]
	|

Impact of GWP on Health[Regions]=
	L LE gdp[Regions] / (1 + EXP(-k LE gdp[Regions] * (Ratio of GDP pc to the reference[\
		Regions]-x0 LE gdp[Regions])))
	~	Dmnl
	~	Impact of wealth on health services availability.
	|

Irrigated Agriculture Land[Regions]=
	Agricultural Land[Regions]*Percent of Irrigated Land[Regions]/100
	~	ha
	~	Area of agricultural land on which the supply of water is only due to \
		irrigation. Source of Historical Data: Gleick,P.H., et al. The World's \
		Water Volume 7: The Biennial Report on Freshwater Resources. Washington: \
		Island Press, 2012.
	|

Lifetime Multiplier from Food[Regions]=
	Impact of Food on Life Expectancy[Regions]
	~	Dmnl
	~	Multiplier to account for changes in life expectancy due to food \
		availability.
	~	:SUPPLEMENTARY 
	|

CO2 emissions[Regions]=
	Total C Emission from the Energy Sector[Regions]*CO2 to C/1e+06
	~	Million ton CO2/Year
	~	From the energy sector only!!!
	|

Total C Emission from the Energy Sector Global=
	sum(Total C Emission from the Energy Sector[Regions!])
	~	TonC/Year
	~		|

Climate mortality inflection[Regions]=
	Climate mortality inflection 0[Regions]
	~	DegreesC
	~	Climate mortality inflection 0 + STEP(Climate mortality inflection SA-Climate \
		mortality inflection 0,Current year)
		
		The parameter that defines the inflection of the logistic function \
		representing temperature-mortality relation. "..0" is the value that \
		defines the original function calibrated to Bressler et al. 2021, "... SA" \
		is the value that can be user-set to cover the uncertainty range after  \
		the current year.
	|

CCS Improvement Change=
	DELAY3(Presure to Adjust Total C Emission from Fossil Fuels*Effectiveness of Pressure to Adjust C Emission\
		,Time to Improve CCS)
	~	1/Year
	~	Change in improvement of carbon capture and storage technology.
	|

INIT CCS Improvement=
	0
	~	
	~	GET XLS CONSTANTS('InitialValues.xlsx','Stocks','F65')
	|

Effectiveness of Pressure to Adjust C Emission=
	0.07+STEP(Effectiveness of Pressure to Adjust C Emission Variation-0.07, 2020)
	~	1/Year
	~	Rate at which the gap between acceptable and current carbon emission from \
		fossil fuels level is addressed.
	|

Effectiveness of Pressure to Adjust C Emission Variation=
	0.07
	~	1/Year
	~	Rate at which the gap between acceptable and current carbon emission from \
		fossil fuels level is addressed.
	|

Desired Total C Emission from Fossil Fuels=
	DE Var S+SMOOTH(STEP(Desired Total C Emission from Fossil Fuels Variation-DE Var S, \
		2020+E Var T),SSP Energy Production Variation Time
	)
	~	TonC/Year
	~	The upper level of acceptable total carbon emission from fossil fuels.
	|

Desired Total C Emission from Fossil Fuels Variation=
	7.5e+09
	~	TonC/Year
	~	The upper level of acceptable total carbon emission from fossil fuels.
	|

TonCO2 to Million ton CO2=
	1/1e+06
	~	Million ton CO2/TonCO2
	~		|

Total CO2 Emissions=
	(Total C Emission-Carbon Removal Rate)*CO2 to C*TonCO2 to Million ton CO2
	~	Million ton CO2/Year
	~		|

CCS Improvement= INTEG (
	CCS Improvement Change,
		INIT CCS Improvement
		)
	~	Dmnl
	~	Accumulated improvement of carbon capture and storage technology.
	|

DE Var S=
	7.5e+09+SMOOTH(STEP(DE S-7.5e+09, 2020),1
	)
	~	TonC/Year
	~	The upper level of acceptable total carbon emission from fossil fuels.
	|

CCS Improvement Factor=
	MIN CCS Improvement Factor+(MAX CCS Improvement Factor-MIN CCS Improvement Factor)*(\
		CCS Improvement/(CCS Improvement+1))
	~	Dmnl
	~		|

Time to Improve CCS Variation=
	10
	~	Year
	~	Average CCS technology development lead time.
	|

CCS Scenario=
	0 + STEP(CCS Scenario Switch Variation, 2020)
	~	Dmnl [0,1,1]
	~	Carbon capture and storage scenario trigger
	|

CCS Scenario Variation=
	0
	~	
	~		|

Presure to Adjust Total C Emission from Fossil Fuels=
	CCS Scenario*(MAX(0,((sum(Total C Emission from Fossil Fuels[Regions!])+sum(C Emission from Biomass Energy\
		[Regions!]))/Desired Total C Emission from Fossil Fuels)-1))
	~	Dmnl
	~	Pressure to adjust the level of carbon emission from fossil fuels is the \
		emission level rises above the acceptable level.
	|

MAX CCS Improvement Factor=
	1
	~	Dmnl
	~	Max impact of carbon capture and storage on carbon intensity of emissions \
		from fossil fuels.
	|

MIN CCS Improvement Factor=
	0
	~	Dmnl
	~	Min impact of carbon capture and storage on carbon intensity of emissions \
		from fossil fuels.
	|

CCS Scenario Switch Variation=
	IF THEN ELSE(0 <= CCS Scenario Variation :AND: CCS Scenario Variation < 1, 0 , 0) + 
	
	IF THEN ELSE(1 <= CCS Scenario Variation :AND: CCS Scenario Variation  < 2,  1 , 0)
	~	
	~		|

Time to Improve CCS=
	10+STEP(Time to Improve CCS Variation-10, 2020)
	~	Year
	~	Average CCS technology development lead time.
	|

DE S=
	7.5e+09
	~	TonC/Year
	~	The upper level of acceptable total carbon emission from fossil fuels.
	|

Minimum Extreme Event Mean=
	0.1
	~	Events/Year
	~	To prevent negative mean value for mean number of extreme events per year
	|

Minimum Number of Extreme Events=
	0
	~	Events/Year
	~		|

