Indicated Eggs Trade to Meet Demand[Regions,EastEu]=
	(1/Initial Agricultural Product Prices[Regions,Eggs]^2)/
	(1/Initial Agricultural Product Prices[Africa,Eggs]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,Eggs]^2+
	 1/Initial Agricultural Product Prices[EastEu,Eggs]^2+
	 1/Initial Agricultural Product Prices[LAC,Eggs]^2+
	 1/Initial Agricultural Product Prices[WestEu,Eggs]^2)*
	Desired animal food production[EastEu,Eggs] ~~|
Indicated Eggs Trade to Meet Demand[Regions,LAC]=
	(1/Initial Agricultural Product Prices[Regions,Eggs]^2)/
	(1/Initial Agricultural Product Prices[Africa,Eggs]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,Eggs]^2+
	 1/Initial Agricultural Product Prices[EastEu,Eggs]^2+
	 1/Initial Agricultural Product Prices[LAC,Eggs]^2+
	 1/Initial Agricultural Product Prices[WestEu,Eggs]^2)*
	Desired animal food production[LAC,Eggs] ~~|
Indicated Eggs Trade to Meet Demand[Regions,WestEu]=
	(1/Initial Agricultural Product Prices[Regions,Eggs]^2)/
	(1/Initial Agricultural Product Prices[Africa,Eggs]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,Eggs]^2+
	 1/Initial Agricultural Product Prices[EastEu,Eggs]^2+
	 1/Initial Agricultural Product Prices[LAC,Eggs]^2+
	 1/Initial Agricultural Product Prices[WestEu,Eggs]^2)*
	Desired animal food production[WestEu,Eggs]
	~	Ton/Year
	~	"Indicated Eggs Trade to Meet Demand[Region A, Region B]" represents an indicated \
		value of egg export from Region A to Region B, serving as a starting point \
		for trade modelling. 
		It is calculated based on a logit sharing function considering egg prices \
		in different regions to meet the egg demand of each region.
	|

CropMeat Demand Fullfilled Ratio[Regions]=
	Total CropMeat Supply to Regions incl Import[Regions]/Desired animal food production\
		[Regions,CropMeat]
	~	Dmnl
	~		|

Excess Demand PasMeat[Regions]=
	Desired animal food production[Regions,PasMeat]-sum(PasMeat Trade to Meet Demand[Regions\
		!,Regions])
	~	
	~	demand = supply = production + import - export
	|

Excess Demand Eggs[Regions]=
	Desired animal food production[Regions,Eggs]-sum(Eggs Trade to Meet Demand[Regions!,\
		Regions])
	~	
	~	demand = supply = production + import - export
	|

Indicated PasMeat Trade to Meet Demand[Regions,Africa]=
	(1/Initial Agricultural Product Prices[Regions,PasMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,PasMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,PasMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,PasMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,PasMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,PasMeat]^2)*
	Desired animal food production[Africa,PasMeat] ~~|
Indicated PasMeat Trade to Meet Demand[Regions,AsiaPacific]=
	(1/Initial Agricultural Product Prices[Regions,PasMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,PasMeat]^2+
