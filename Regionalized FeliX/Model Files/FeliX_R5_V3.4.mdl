	IF THEN ELSE(RCP Scenario=1,Other Anthropogenic Radiative Forcing RCP26,
	IF THEN ELSE(RCP Scenario=2,Other Anthropogenic Radiative Forcing RCP34,
	IF THEN ELSE(RCP Scenario=3, Other Anthropogenic Radiative Forcing RCP45, 
