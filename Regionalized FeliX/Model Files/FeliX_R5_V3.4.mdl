Scaled Excess Demand Dairy[Regions]=
	Excess Demand Dairy[Regions]/MIN(sum(Indicated Dairy Trade to Meet Demand[Regions,Regions\
		!]),sum(Indicated Dairy Trade to Meet Demand[Regions
	!,Regions
	]))
	~	
