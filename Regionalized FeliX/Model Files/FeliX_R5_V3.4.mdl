PasMeat Demand Fullfilled Ratio[Regions]=
	Total PasMeat Supply to Regions incl Import[Regions]/Desired animal food production[\
		Regions,PasMeat]
	~	Dmnl
	~		|

Dairy Demand Fullfilled Ratio[Regions]=
	Total Dairy Supply to Regions incl Import[Regions]/Desired animal food production[Regions\
		,Dairy]
	~	Dmnl
	~		|

Desired animal food production[Regions,AnimalFood]=
	Food demand inc Waste in tonnes[Regions,AnimalFood]+Food demand for other uses[Regions\
		,AnimalFood]
	~	Ton/Year
	~		|

Food demand for other uses[Regions,FoodCategories]=
	Food demand inc Waste in tonnes[Regions,FoodCategories]*Other uses multiplier for food\
		[Regions,FoodCategories]
	~	Ton/Year
	~		|

Eggs Demand Fullfilled Ratio[Regions]=
	Total Eggs Supply to Regions incl Import[Regions]/Desired animal food production[Regions\
		,Eggs]
	~	Dmnl
	~		|

Excess Demand CropMeat[Regions]=
	Desired animal food production[Regions,CropMeat]-sum(CropMeat Trade to Meet Demand[Regions\
		!,Regions])
	~	
	~	demand = supply = production + import - export
	|

Indicated CropMeat Trade to Meet Demand[Regions,Africa]=
	(1/Initial Agricultural Product Prices[Regions,CropMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,CropMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,CropMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,CropMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,CropMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,CropMeat]^2)*
	Desired animal food production[Africa,CropMeat] ~~|
Indicated CropMeat Trade to Meet Demand[Regions,AsiaPacific]=
	(1/Initial Agricultural Product Prices[Regions,CropMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,CropMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,CropMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,CropMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,CropMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,CropMeat]^2)*
	Desired animal food production[AsiaPacific,CropMeat] ~~|
Indicated CropMeat Trade to Meet Demand[Regions,EastEu]=
	(1/Initial Agricultural Product Prices[Regions,CropMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,CropMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,CropMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,CropMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,CropMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,CropMeat]^2)*
	Desired animal food production[EastEu,CropMeat] ~~|
Indicated CropMeat Trade to Meet Demand[Regions,LAC]=
	(1/Initial Agricultural Product Prices[Regions,CropMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,CropMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,CropMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,CropMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,CropMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,CropMeat]^2)*
	Desired animal food production[LAC,CropMeat] ~~|
Indicated CropMeat Trade to Meet Demand[Regions,WestEu]=
	(1/Initial Agricultural Product Prices[Regions,CropMeat]^2)/
	(1/Initial Agricultural Product Prices[Africa,CropMeat]^2+
	 1/Initial Agricultural Product Prices[AsiaPacific,CropMeat]^2+
	 1/Initial Agricultural Product Prices[EastEu,CropMeat]^2+
	 1/Initial Agricultural Product Prices[LAC,CropMeat]^2+
	 1/Initial Agricultural Product Prices[WestEu,CropMeat]^2)*
	Desired animal food production[WestEu,CropMeat]
	~	Ton/Year
	~	"Indicated CropMeat Trade to Meet Demand[Region A, Region B]" represents an \
		indicated value of crop meat export from Region A to Region B, serving as \
		a starting point for trade modelling. 
		It is calculated based on a logit sharing function considering crop meat \
		prices in different regions to meet the crop meat demand of each region.
	|

