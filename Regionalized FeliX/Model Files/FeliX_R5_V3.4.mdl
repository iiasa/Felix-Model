Coal Production Rate[Regions]=
	MIN(Total Coal Demand from Regions incl Export Demand[Regions],Potential Coal Production\
		[Regions])
	~	Mtoe/Year
	~	Total coal energy production per year due to available resources, \
		developments in production technology and coal energy demand.
	|

Oil Production Rate[Regions]=
	MIN(Total Oil Demand from Regions incl Export Demand[Regions],Potential Oil Production\
		[Regions])
	~	Mtoe/Year
	~	Total oil energy production per year due to available resources, \
		developments in production technology and oil energy demand.
	|

Gas Production Rate[Regions]=
	MIN(Total Gas Demand from Regions incl Export Demand[Regions],Potential Gas Production\
		[Regions])
	~	Mtoe/Year
	~	Total gas energy production per year due to available resources, \
		developments in production technology and gas energy demand.
	|

Average Kcal Intake per Person FAO Total[Regions]=
	sum(Average Kcal Intake per Person FAO[Regions,FoodCategories!])
	~	kcal/(Person*Day)
	~		|

Annual Kcal Intake SHIFT[Regions,FoodCategories,Gender,Cohorts]=
	Days in Year*kcal to Mkcal*
	(Average calorie intake in meat diet[Regions,FoodCategories,Gender,Cohorts] * sum("Meat-based Diet Followers"\
		[Regions,Gender,Cohorts,Education!]) +
	
	Average calorie intake in vegetarian diet[Regions,FoodCategories,Gender,Cohorts] * sum\
		(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education!]) 
	)
	~	Mkcal/Year
	~		|

VM Var S[Regions]=
	VM S[Regions]+SMOOTH(STEP(VM S[Regions]-VM S[Regions], 2020),1)
	~	1/Year
	~		|

Regional Total Calorie Demand SHIFT[Regions]=
	sum(Annual Caloric Demand SHIFT[Regions,FoodCategories!])
	~	Mkcal/Year
	~		|

Total Meat Eaters[Regions]=
	sum(Total Meat Eaters by Gender[Regions,Gender!])
	~	People
	~		|

Total Meat Eaters by Gender[Regions,Gender]=
	sum("Meat-based Diet Followers"[Regions,Gender,Cohorts!,Education!])
	~	People
	~		|

Percentage of vegetarians[Regions,Gender,Cohorts,Education]=
	ZIDZ(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education], Population wrt Education\
		[Regions,Gender,Cohorts,Education])
	~	Dmnl
	~		|

Fraction intended to change diet[Regions,Cohorts,Gender,Education]=
	SMOOTH(Indicative fraction intended to change diet[Regions,Cohorts,Gender,Education]\
		,Intention Delay[Regions])
	~	Dmnl
	~		|

"Meat-based Diet Followers"[Regions,Gender,Cohorts,Education]=
	MAX(0, Population wrt Education[Regions,Gender,Cohorts,Education]-Lactoovo Vegetarian Diet Followers\
		[Regions,Gender,Cohorts,Education])
	+(0 * "Shift from meat-based to vegetarian"[Regions,Gender,Cohorts,Education])
	+(0 * "Shift from vegetarian to meat-based"[Regions,Gender,Cohorts,Education])
	~	People
	~		|

Previous population[Regions,Gender,Cohorts,Education]= DELAY FIXED (
	Population wrt Education[Regions,Gender,Cohorts,Education], 1, Initial Pop Ed[Regions\
		,Gender,Cohorts,Education])
	~	People
	~		|

Attitude multiplier for diet change[Regions,Education]=
	L risk attitude[Regions]/
	(1+EXP(-k risk attitude[Regions]*(Perceived Risk[Education] -x0 risk attitude[Regions\
		]) ) )
	~	Dmnl
	~	( L events risk / 
		(1+( EXP(-k events risk*(Climate Events in Memory-x0 events risk) ) )) 
		-(L events risk / 2))+0.5
	|

Reference Daily Caloric Intake[Regions]=
	CI S[Regions] + RAMP((Reference Daily Caloric Intake Variation[Regions]-CI S[Regions\
		])/78,2022,2100)
	~	kcal/(Person*Day)
	~	1961 World average, from FAO data - 2194 kcal
		Calibrated 1672.6 kcal
		1970 value, when gdp effect=1:2325
	|

Reference Daily Caloric Intake Variation[Regions]=
	CI S[Regions]
	~	kcal/(Person*Day)
	~	1961 World average, from FAO data - 2194 kcal
		Calibrated 1672.6 kcal
		1970 value, when gdp effect=1:2325
	|

Effect of GDP on Meat Consumption[Africa]= WITH LOOKUP (
	Relative GDP per Capita[Africa],
		([(0,0)-(3,2)],(0,0.4),(0.25,0.47),(0.5,0.57),(0.75,0.76),(1,1),(1.25,1.24),(1.5,1.43\
		),(1.75,1.53),(2,1.67),(2.25,1.82
		),(2.5,1.87),(2.75,1.9),(3,1.92) )) ~~|
Effect of GDP on Meat Consumption[AsiaPacific]= WITH LOOKUP (
	Relative GDP per Capita[AsiaPacific],
		([(0,0)-(3,2)],(0,0.4),(0.25,0.47),(0.5,0.57),(0.75,0.76),(1,1),(1.25,1.24),(1.5,1.43\
		),(1.75,1.53),(2,1.67),(2.25,1.82
		),(2.5,1.87),(2.75,1.9),(3,1.92) )) ~~|
Effect of GDP on Meat Consumption[EastEu]= WITH LOOKUP (
	Relative GDP per Capita[EastEu],
		([(0,0)-(3,2)],(0,0.4),(0.25,0.47),(0.5,0.57),(0.75,0.76),(1,1),(1.25,1.24),(1.5,1.43\
		),(1.75,1.53),(2,1.67),(2.25,1.82
		),(2.5,1.87),(2.75,1.9),(3,1.92) )) ~~|
Effect of GDP on Meat Consumption[LAC]= WITH LOOKUP (
	Relative GDP per Capita[LAC],
		([(0,0)-(3,2)],(0,0.4),(0.25,0.47),(0.5,0.57),(0.75,0.76),(1,1),(1.25,1.24),(1.5,1.43\
		),(1.75,1.53),(2,1.67),(2.25,1.82
		),(2.5,1.87),(2.75,1.9),(3,1.92) )) ~~|
Effect of GDP on Meat Consumption[WestEu]= WITH LOOKUP (
	Relative GDP per Capita[WestEu],
		([(0,0)-(3,2)],(0,0.4),(0.25,0.47),(0.5,0.57),(0.75,0.76),(1,1),(1.25,1.24),(1.5,1.43\
		),(1.75,1.53),(2,1.67),(2.25,1.82
		),(2.5,1.87),(2.75,1.9),(3,1.92) ))
	~	1/Year
	~	See FAOSTAT_...meatpercapita.xlsx forhow I derived the lookup.
	|

Sum of diet followers[Regions]=
	Total Vegetarians[Regions]+Total Meat Eaters[Regions]
	~	People
	~		|

Potential vegetarians[Regions,Gender,Cohorts,Education]=
	DELAY1I("Meat-based Diet Followers"[Regions,Gender,Cohorts,Education], 1, "Initial Meat-based Diet Followers"\
		[Regions,Gender,Cohorts,Education])
	~	People
	~		|

Average calorie intake in vegetarian diet[Regions,FoodCategories,Gender,Cohorts]=
	Average Total Daily Calorie Intake[Regions]*Vegetarian diet composition multipliers[\
		Regions,FoodCategories,Gender,Cohorts]
	~	kcal/(Person*Day)
	~		|

Indicative fraction intended to change diet[Regions,Cohorts,Gender,Education]=
	Self efficacy multiplier[Regions,Gender]*
	Subjective norm multiplier for diet change[Regions,Gender,Cohorts,Education]*
	Attitude multiplier for diet change[Regions,Education]*
	Normal fraction intended to change diet stepped[Regions]
	~	1/Year
	~		|

Shift fraction of meat eaters to vegetarianism[Regions,Gender,Cohorts,Education]=
	Normal shift fraction from meat to vegetarianism[Regions]+Fraction intended to change diet\
		[Regions,Cohorts,Gender,Education]*Response efficacy multiplier[Regions,Education]*\
		Self efficacy multiplier[Regions,Gender]
	~	1/Year
	~	*Personal willingness multiplier for diet \
		shift[Gender,Cohorts,Education]*Social impact multiplier for diet \
		shift[Gender,Cohorts,Education]
	|

Average Daily Calorie Demand per Capita[Regions]=
	Regional Total Calorie Demand SHIFT[Regions]/Population[Regions]/kcal to Mkcal/Days in Year
	~	kcal/(Person*Day)
	~		|

Annual Caloric Demand FAO[Regions,FoodCategories]=
	Average Kcal Intake per Person FAO[Regions,FoodCategories]*Population[Regions]*kcal to Mkcal\
		*Days in Year
	~	Mkcal/Year
	~		|

Total eater value cohort[Regions,Gender,Cohorts,Education]=
	Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education]+"Meat-based Diet Followers"\
		[Regions,Gender,Cohorts,Education]
	~	People
	~		|

Effect of GDP on Daily Caloric Intake[Regions]=
	Effect of GDP on Calorie Intake Lookup(Relative GDP per Capita[Regions])
	~	Dmnl
	~	See FAOSTAT_..DailyCaloriesOverTime.xlsx
		GWP scenario: \
		[(0,0)-(2.5,1.5)],(0,0.5),(0.25,0.55),(0.5,0.62),(0.75,0.75),(1,1),(1.25,1.\
		12),(1.5,1.2),(1.75,1.26),(2,1.3),(2.25,1.33),(2.5,1.35) )
		BAU Scenario: \
		([(0,0)-(4,1.5)],(0,0.4),(0.5,0.52),(1,1),(1.5,1.15),(2,1.26),(2.5,1.33),(3\
		,1.38),(3.5,1.4),(4,1.42) )
	|

Annual Caloric Demand WRI[Regions,FoodCategories]=
	Average Kcal Intake per Person WRI[Regions,FoodCategories]*Population[Regions]*kcal to Mkcal\
		*Days in Year
	~	Mkcal/Year
	~		|

Diet Composition Switch Variation[Regions]=
	IF THEN ELSE(0 <= Diet Composition Variation[Regions] :AND: Diet Composition Variation\
		[Regions] < 1, 0 , 0)
	
	+ IF THEN ELSE(1 <= Diet Composition Variation[Regions] :AND: Diet Composition Variation\
		[Regions] < 2, 1 , 0)
	
	+ IF THEN ELSE(2 <= Diet Composition Variation[Regions] :AND: Diet Composition Variation\
		[Regions] < 3, 2 , 0)
	
	+ IF THEN ELSE(3 <= Diet Composition Variation[Regions] :AND: Diet Composition Variation\
		[Regions] < 4, 3 , 0)
	
	+ IF THEN ELSE(4 <= Diet Composition Variation[Regions] :AND: Diet Composition Variation\
		[Regions] < 5, 4 , 0)
	~	Dmnl
	~	0: Reference meat and vegetarian diets
		1: Everyone is flexitarian from 2020 on
		2: Meat-eaters eat 'Healthy', vegetarians eat 'Reference' veg diet
		3: Meat-eaters eat 'Healthy', vegetarians eat 'Vegan' diet
		4: Meat-eaters eat 'Flexitarian', vegetarians eat vegan
	|

Average Kcal Intake per Person[Regions,FoodCategories]=
	Annual Caloric Demand[Regions,FoodCategories]/(Population[Regions]*Days in Year*kcal to Mkcal\
		)
	~	kcal/(Person*Day)
	~		|

Average Kcal Intake per Person FAO[Regions,FoodCategories]=
	Average Total Daily Calorie Intake[Regions]*Regional Average Diet Composition FAO[Regions\
		,FoodCategories]
	~	kcal/(Person*Day)
	~		|

Average Kcal Intake per Person SHIFT[Regions,FoodCategories]=
	Annual Caloric Demand SHIFT[Regions,FoodCategories]/(Population[Regions]*Days in Year\
		*kcal to Mkcal)
	~	kcal/(Person*Day)
	~		|

Average Kcal Intake per Person WRI[Regions,FoodCategories]=
	Average Total Daily Calorie Intake[Regions]*Global Average Diet Composition WRI[Regions\
		,FoodCategories]/100
	~	kcal/(Person*Day)
	~		|

Normal fraction intended to change diet stepped[Regions]=
	0 + STEP(Normal fraction intended to change diet[Regions], 2010 )
	~	1/Year
	~		|

Percentage of animal calories[Regions]=
	sum(Diet Composition Percentage[Regions,AnimalFood!])
	~	Dmnl
	~		|

Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts,Education]= INTEG (
	"Shift from meat-based to vegetarian"[Regions,Gender,Cohorts,Education]-"Shift from vegetarian to meat-based"\
		[Regions,Gender,Cohorts,Education]+Population increase rate[Regions,Gender,Cohorts,\
		Education],
		Initial Vegetarian Diet Followers[Regions,Gender,Cohorts,Education])
	~	People
	~		|

"Total shift from meat-based to vegetarian diet"[Regions]=
	sum("Shift from meat-based to vegetarian"[Regions,Gender!,Cohorts!,Education!])
	~	People/Year
	~		|

Normal Shift Fraction from Vegetarianism to Meat[Regions]=
	VM Var S[Regions]+SMOOTH(STEP(Normal Shift Fraction from Vegetarianism to Meat Variation\
		[Regions]-VM Var S[Regions], 2020+L Var T),SSP Food and Diet Variation Time
	)
	~	1/Year
	~		|

Diet Composition Percentage[Regions,FoodCategories]=
	Average Kcal Intake per Person[Regions,FoodCategories]/sum(Average Kcal Intake per Person\
		[Regions,FoodCategories!])
	~	Dmnl
	~		|

Average Total Daily Calorie Intake[Regions]=
	Reference Daily Caloric Intake[Regions]*Effect of GDP on Daily Caloric Intake[Regions\
		]
	~	kcal/(Person*Day)
	~		|

Total Vegetarians by Gender[Regions,Gender]=
	sum(Lactoovo Vegetarian Diet Followers[Regions,Gender,Cohorts!,Education!])
	~	People
	~		|

Population increase rate[Regions,Gender,Cohorts,Education]=
	(Population wrt Education[Regions,Gender,Cohorts,Education]-Previous population[Regions\
		,Gender,Cohorts,Education])*Percentage of vegetarians[Regions,Gender,Cohorts,Education\
		]
	~	People/Year
	~		|

Percentage of vegetarian diet followers[Regions]=
	Total Vegetarians[Regions]/Population[Regions]
	~	Dmnl
	~		|

Annual Caloric Demand FLEX[Regions,FoodCategories]=
	Average Kcal Intake per Person FLEX[Regions,FoodCategories]*Population[Regions]*kcal to Mkcal\
		*Days in Year
	~	Mkcal/Year
	~		|

Average calorie intake in meat diet[Regions,FoodCategories,Gender,Cohorts]=
	Average Total Daily Calorie Intake[Regions]*Meat diet composition multipliers[Regions\
		,FoodCategories,Gender,Cohorts]
	~	kcal/(Person*Day)
	~		|

Shift Fraction Vegetarians to Meat[Regions]=
	Normal Shift Fraction from Vegetarianism to Meat[Regions]*Effect of GDP on Meat Consumption\
		[Regions]
	~	1/Year
	~		|

"Percentage of meat-based diet followers"[Regions]=
	Total Meat Eaters[Regions]/Population[Regions]
	~	Dmnl
	~		|

Plant Based Food Caloric Intake per Person[Regions]=
	sum(Average Kcal Intake per Person[Regions,PlantFood!])
	~	kcal/(Person*Day)
	~		|

Annual Caloric Demand[Regions,FoodCategories]=
	IF THEN ELSE(Diet Composition Switch[Regions]=1, 
	Annual Caloric Demand SHIFT[Regions,FoodCategories]+Smooth Diet Switch Fnc[Regions]*\
		(Annual Caloric Demand FLEX[Regions,FoodCategories]-Annual Caloric Demand SHIFT[Regions\
		,FoodCategories]),
	Annual Caloric Demand SHIFT[Regions,FoodCategories] )
	~	Mkcal/Year
	~	This variable can be changed according to which diet composition is used.
	|

Diet Composition Switch[Regions]=
	0 + STEP(Diet Composition Switch Variation[Regions], 2020)
	~	Dmnl
	~	0: Reference meat and vegetarian diets
		1: Everyone is flexitarian from 2020 on
		2: Meat-eaters eat 'Healthy', vegetarians eat 'Reference' veg diet
		3: Meat-eaters eat 'Healthy', vegetarians eat 'Vegan' diet
		4: Meat-eaters eat 'Flexitarian', vegetarians eat vegan
	|

"Shift from vegetarian to meat-based"[Regions,Gender,Cohorts,Education]=
	Shift Fraction Vegetarians to Meat[Regions]*Lactoovo Vegetarian Diet Followers[Regions\
		,Gender,Cohorts,Education]
	~	People/Year
	~		|

Total Vegetarians[Regions]=
	sum(Total Vegetarians by Gender[Regions,Gender!])
	~	People
	~		|

"Shift from meat-based to vegetarian"[Regions,Gender,Cohorts,Education]=
	Potential vegetarians[Regions,Gender,Cohorts,Education]*Shift fraction of meat eaters to vegetarianism\
		[Regions,Gender,Cohorts,Education]
	~	People/Year
	~		|

Potential production rate of crop animal food[Regions,CropMeat]=
	sum(Feed Availability[Regions,PlantFood!])/Unit feed used for meat production[Regions\
		] ~~|
Potential production rate of crop animal food[Regions,Eggs]=
	Potential production rate of crop animal food[Regions,CropMeat]*Meat to Eggs Multiplier\
		[Regions]
	~	Ton/Year
	~		|

Total CropMeat Supply from Regions incl Export[Regions]=
	sum(CropMeat Trade to Meet Demand[Regions,Regions!])
	~	Ton/Year
	~	Total crop meat supply from Region A including domestic supply, and \
		international exports from Region A
	|

CropMeat Prices Adj[Regions]=
	Initial Agricultural Product Prices[Regions,CropMeat]*CropMeat Prices Adj Fractions[\
		Regions]
	~	
	~		|

Eggs Prices Adj[Regions]=
	Initial Agricultural Product Prices[Regions,Eggs]*Eggs Prices Adj Fraction[Regions]
	~	
	~		|

Eggs Prices Adj Fraction[Regions]=
	FIND ZERO(Demand Scale[Regions],Scaled Excess Demand Eggs[Regions],Relative Demand Scale\
		[Regions],Initial Export Fraction Demand
	[Regions],
	Size n Demand,Skip Demand,Tolerance Demand,Max Iteration Demand,Method Demand)
	~	
	~	This is used to solve nonlinear simultaneous algebraic equations of egg \
		prices, which then adjust the supply of eggs from different regions to \
		make scaled excess demand of eggs close to 0.
	|

Eggs Supply Elaticity[Regions]=
	1.24323,
	1.34353,
	1.35221,
	0.968733,
	2.35896
	~	
	~		|

