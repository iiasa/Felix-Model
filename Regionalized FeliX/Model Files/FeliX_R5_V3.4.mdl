	|

Potential Biomass Energy Production[Regions]=
	MIN(Potential Biomass Energy Production from Infrastructure[Regions],Potential Biomass Energy Production from Resources\
		[Regions])
	~	Mtoe/Year
	~	Potential biomass energy production per year due to available resources, \
		production capability and technical developments.
	|

Installation of Biomass Capacity Rate[Regions]=
	MAX(0,Biomass Infrastructure Adjustment[Regions]*Productivity of Investment in Biomass Capacity Installation\
		[Regions])
	~	1/Year
	~	Rate of new biomass capacity installation.
	|

Biomass Energy Technology Ratio[Regions]= INTEG (
	Increase in Biomass Energy Technology Ratio[Regions],
		INIT BETRN[Regions])
	~	Dmnl
	~	Biomass Energy Technology Ratio increased due to investments in biomass \
		energy efficiency.
	|

Cumulative Biomass Energy Produced[Regions]= INTEG (
	Biomass Energy Production[Regions],
		INIT Cumulative Biomass Produced[Regions])
	~	Mtoe
	~	Cumulative biomass energy that has been produced.
	|

Efficiency of Biomass Installed Capacity[Regions]=
	ZIDZ(Potential Biomass Energy Production from Infrastructure[Regions],Biomass Energy Installed Capacity\
		[Regions])
	~	Mtoe/Year
	~	Total production efficiency of Biomass Installed Capacity.
	|

Biomass Energy Production Rate[Regions]=
	MIN(Potential Biomass Energy Production[Regions],Total Biomass Demand[Regions])
	~	Mtoe/Year
	~	Total biomass energy production per year accounting for demand and \
		potential production due to available resources, production capability and \
		technical developments.
	|

Investment in Biomass Capacity[Regions]=
	Installation of Biomass Capacity Rate[Regions]*Unit Cost of Biomass Capacity Installation\
		[Regions]*Efficiency of Biomass Installed Capacity[Regions]*Biomass Capacity Aging Time\
		[Regions]
	~	$/Year
	~	Amount of resources dedicated to biomass capacity development.
	|

Increase in Biomass Energy Technology Ratio[Regions]=
	DELAY3(Investment in Biomass Energy Efficiency[Regions]*Effectiveness of Investment in Biomass Energy Technology\
		[Regions], Biomass Energy Technology Development Time[Regions])
	~	1/Year
	~	Increase in Biomass Energy Technology Ratio due to investments in biomass \
		energy efficiency technology and their productivity.
	|

Investment in Biomass Energy Installation[Regions]=
	Investment in Biomass Energy Technology[Regions]*Fraction Invested in Biomass Energy Installation\
		[Regions]
	~	$/Year
	~	Total investments in biomass energy capacity.
	|

Effect of Biomass Energy Demand and Supply on Price[Regions]=
	(Total Biomass Demand[Regions]/Potential Biomass Energy Production[Regions])^Sensitivity of Biomass Energy Price to Supply and Demand\
		[Regions]
	~	Dmnl
	~	Effect of Biomass Demand and Supply ratio on actual biomass energy price.
	|

Biomass Infrastructure Adjustment[Regions]=
	Biomass Capacity Aging Rate[Regions]+(Desired Biomass Installed Capacity[Regions]-Biomass Energy Installed Capacity\
		[Regions])/Time to Adjust Biomass Infrastructure[Regions]
	~	1/Year
	~	Adjustment of Biomass Infrastructure to the desired level over a specified \
		adjustment time and accounting for constant infrastructure decrease due to \
		aging process.
	|

Biomass Energy Price[Regions]=
	Indicated Biomass Energy Price[Regions]*Effect of Biomass Energy Demand and Supply on Price\
		[Regions]
	~	$/Mtoe
	~	Actual biomass energy price accounting for indicated  biomass energy price \
		and effect of demand and supply.
	|

Increase in Biomass Installation Technology Ratio[Regions]=
	DELAY3(Investment in Biomass Energy Installation[Regions]*Effectiveness of Investment in Biomass Installation Technology\
		[Regions], Biomass Installation Technology Development Time[Regions])
	~	1/Year
	~	Increase in Biomass Installation Technology Ratio due to investments in \
		biomass energy capacity.
	|

Investment in Biomass Energy Efficiency[Regions]=
	Investment in Biomass Energy Technology[Regions]*(1-Fraction Invested in Biomass Energy Installation\
		[Regions])
	~	$/Year
	~	Total investments in biomass energy efficiency technology.
	|

Biomass Learning Curve Strength[Regions]=
	LN(1 - Fraction for Biomass Learning Curve Strength[Regions])/LN(2)
	~	Dmnl
	~	Strength of biomass learning curve with which the biomass energy costs are \
		influenced..
	|

Investment in Biomass Energy Technology[Regions]=
	Fraction of Revenue Invested in Biomass Technology[Regions]*Biomass Energy Revenue[Regions\
		]
	~	$/Year
	~	Investments in development of biomass energy efficiency technology and \
		production capability.
	|

Fraction Invested in Biomass Energy Installation[Regions]=
	Table for FIBEI(Biomass Installation Efficiency[Regions])
	~	Dmnl
	~	Fraction of investments in biomass energy technology dedicated to capacity.
	|

Fraction for Biomass Learning Curve Strength[Regions]=
	Fraction for Biomass Learning Curve Strength Variation[Regions]+STEP(Fraction for Biomass Learning Curve Strength Variation\
		[Regions]-Fraction for Biomass Learning Curve Strength Variation[Regions], 2020)
	~	Dmnl
	~	Fraction for Biomass Learning Curve Strength indicating by what percentage \
		the biomass energy cost will drop for each doubling of biomass installed \
		capacity.
	|

Biomass Initial Investment[Regions]=
	0
	~	Dmnl
	~	Initial level of fractional investments in biomass energy technology.
	|

INIT BETRN[Regions]=
	0
	~	Dmnl
	~	Initial Biomass Energy Technology Ratio.
		GET XLS CONSTANTS('InitialValues.xlsx','Stocks','F33')
