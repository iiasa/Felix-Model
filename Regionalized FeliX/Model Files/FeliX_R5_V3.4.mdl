Effect of GWP per capita on primary enrollment[Regions,Gender]=
	P1[Regions,Gender]/(1+EXP(-P2[Regions,Gender]*(GDP per capita ratio for enrollment[Regions\
		]-P0[Regions
	,Gender])))
	~	Dmnl
	~	Based on Net enrollment rate (noramlzied wrt max) vs. GWP per capita (normalized wrt \
		2000 value) data. Needs regression!
		IF THEN ELSE function is used to ensure the value of the primary education \
		enrollment fraction <=1
	|

Effect of GWP per capita on secondary enrollment[Regions,Gender]=
	S1[Regions,Gender]/(1+EXP(-S2[Regions,Gender]*(GDP per capita ratio for enrollment[Regions\
		]-S0[Regions
	,Gender])))
	~	Dmnl
	~	Based on gross enrollment rate (noramlzied wrt max) vs. GWP per capita (normalized \
		wrt 2000 value) data. Needs regression!
		IF THEN ELSE function is used to ensure the value of the secondary \
		education enrollment fraction is during [0,1]
	|

Effect of GWP per capita on tertiary enrollment[Regions,Gender]=
	T1[Regions,Gender]/(1+EXP(-T2[Regions,Gender]*(GDP per capita ratio for enrollment[Regions\
		]-T0[Regions
	,Gender])))
	~	Dmnl
	~	Based on gross enrollment rate (noramlzied wrt max) vs. GWP per capita (normalized \
		wrt 2000 value) data. Needs regression! 
		IF THEN ELSE function is used to ensure the value of the tertiary \
		education enrollment fraction is during [0,1]
	|

