		,WorkingAge]
	~	Person
	~		|

Policy Ramp Primary Education[Regions,Gender]=
	Fractional1[Regions] + RAMP(Primary Education Variation[Gender]/(DemoFeliX target year\
		-Current year), Current year, DemoFeliX target year
	)
	~	Dmnl
	~		|

Labor force RAMP[Regions,Gender,WorkingAge]=
	Fractional1[Regions] + RAMP(Labor Force Participation Fraction Variation[Regions,Gender\
		,WorkingAge]/(DemoFeliX target year
	-Current year), Current year , DemoFeliX target year)
	~	
	~		|

Policy Ramp Sec Education[Regions,Gender]=
	Fractional1[Regions] + RAMP(Secondary Education Variation[Regions,Gender]/(DemoFeliX target year\
		-Current year), Current year
	 , DemoFeliX target year)
	~	Dmnl
	~		|

"$ into $thousand"=
	1/1000
	~	Thousand
	~		|

"15 to 39":
	"15-19","20-24","25-29","30-34","35-39"
	~	
	~		|

Reference Other Technology baseline=
	1
	~	Dmnl
	~	Reference factor productivity in other than energy sectors.
	|

Reference Other Technology Variation=
	1
	~	Dmnl
	~	Reference factor productivity in other than energy sectors.
	|

Adjustments for relative incomes of skilled[male,Childhood]=
	0.77 ~~|
Adjustments for relative incomes of skilled[male,"15 to 39"]=
	1.1 ~~|
Adjustments for relative incomes of skilled[male,"40 to 64"]=
	1.2 ~~|
Adjustments for relative incomes of skilled[male,"65+"]=
	1.22 ~~|
Adjustments for relative incomes of skilled[female,Childhood]=
	0.77 ~~|
Adjustments for relative incomes of skilled[female,"15 to 39"]=
	1 ~~|
Adjustments for relative incomes of skilled[female,"40 to 64"]=
	1.1 ~~|
Adjustments for relative incomes of skilled[female,"65+"]=
	1.05
	~	Dmnl
	~	to adjust the relative incomes of skilled labor force of each population group
		Two assumptions: (1) the relationship between income and age tends to \
		exhibit an inverted-U-shape pattern. Incomes rise with age and then drop \
		slightly as taxpayers enter retirement. (2)  Male has more incomes than \
		female in the same age group.
	|

Relative income of skilled variation=
	65
	~	$/Year
	~		|

Relative income of skilled variation baseline=
	65
	~	$/Year
	~		|

Relative incomes of skilled[Gender,Cohorts]=
	Reference relative income of skilled*Adjustments for relative incomes of skilled[Gender\
		,Cohorts]
	~	$/Year
	~	Relative incomes of skilled. Need data about the earnings of skilled in each \
		population cohort.
		Data from OECD datasets. https://stats.oecd.org/Index.aspx?DataSetCode=EAG_EARNINGS 
		65 is about the average relative incomes of skilled population in OECD countries.
		Detailed data collection can be found in the file: Data collection from \
		OECD earnings.xlsx
	|

Relative incomes of unskilled[male,Cohorts]=
	Total relative incomes[male,Cohorts]-Relative incomes of skilled[male,Cohorts] ~~|
Relative incomes of unskilled[female,Cohorts]=
	Total relative incomes[female,Cohorts]-Relative incomes of skilled[female,Cohorts]
	~	$/Year
	~	Relative incomes of unskilled. Need data about the earnings of unskilled population \
		in each population cohort.
		Data from OECD datasets. https://stats.oecd.org/Index.aspx?DataSetCode=EAG_EARNINGS 
		Detailed data collection can be found in the file: Data collection from \
		OECD earnings.xlsx
	|

