	20000,
	4078.45,
	75000
	~	$/(Year*Person) [2000,10000]
	~	A reference value against which the GDP per Capita is compared to \
		calculate the impact of population wealth on average agricultural water \
		use on the land where the supply of water is due to irrigation.
	|

Quality of Domestic Water=
	Domestic Water Withdrawal Fulfillment Rate^Water Quality Steepness*(Water Quality Inflection\
		^Water Quality Steepness+1)/(Water Quality Inflection^Water Quality Steepness+Domestic Water Withdrawal Fulfillment Rate\
		^Water Quality Steepness)
	~	Dmnl
	~	Nonlinear relation describing the quality of domestic as dependent on \
		withdrawal fulfillment rate.
	|

INIT Reliable Water Supply=
	4.2e+12
	~	m*m*m/Year
	~	Amount of water that can be reliably provided on annual basis for \
		domestic, agricultural and industrial use due to resources and \
		infrastructure availability for year 1900.
	|

Domestic Water Withdrawal Fulfillment Factor=
	0.8
	~	Dmnl
	~	A factor determining the strength of infrastructure operating limits on \
		domestic water withdrawal fulfillment.
	|

MAX Percent of Irrigated Land[Regions]=
	80,
	80,
	96.6738,
	99.1059,
	32.0369
	~	Dmnl [80,100]
	~	Max percentage of total agricultural land that can be eventually irrigated.
	|

Nordhaus Damage=
	"100 percent"*( 1
	                  - 1
	                       / ( 1
	                            + alpha Nordhaus damage 
	                                 * Temperature Change from Preindustrial
	                            + beta Nordhaus damage 
	                                 * Temperature Change from Preindustrial
	                                      ^ 2) )
	~	percent
	~	Formulation of the original damage function used by Nordhaus in PNAS \
		(2017) paper.
	|

Industrial Water Withdrawal Fulfillment Factor=
	2
	~	Dmnl
	~	A factor determining the strength of infrastructure operating limits on \
		industrial water withdrawal fulfillment.
	|

Desired Water Supply Rate=
	MAX(0,Water Consumption Adjustment+Available Water Resources Adjustment)
	~	m*m*m/Year
	~	Desired water supply including constant water consumption and available \
		water resources adjustment.
	|

MIN Percent of Irrigated Land[Regions]=
	0.1,
	0.1,
	0.1,
	0.0999795,
	0.1
	~	Dmnl [0,0.1]
	~	Min percentage of total agricultural land that can be irrigated.
	|

Water Consumption Adjustment=
	Agricultural Water Withdrawal Rate+Domestic Water Withdrawal Rate+Industrial Water Withdrawal Rate\
		-Recovery of Used Water Resources Rate
	~	m*m*m/Year
	~	The sum of consumption of water in industrial, agricultural and domestic \
		sectors corected by used water recovery rate.
	|

Net Change in Reliable Water Supply=
	((INIT Reliable Water Supply*Impact of Climate Damage on Reliable Water Supply*Additional Change in Reliable Water Supply\
		)-Reliable Water Supply)/Min Reliable Water Supply Decrease Time
	~	m*m*m/(Year*Year)
	~	Change in reliable water supply due to changes in water resources or \
		infrastructure availability.
	|

denom2 DietzStern=
	4
	~	DegreesC
	~		|

Climate Damage Steepness=
	Climate Damage Steepness 0+STEP(Climate Damage Steepness SA-Climate Damage Steepness 0\
		,Current year)
	~	1/DegreesC
	~	This function starts with the parameter values defined by the original \
		calibration (parameter "...0") e.g. to Nordhaus, until the present year, \
		and it allows for user-defined values to cover future uncertainty \
		(parameter "... SA").
	|

Drought Out=
	Agricultural Water Withdrawal Rate no Drought-Agricultural Water Withdrawal Rate
	~	m*m*m/Year
	~	Water resources decrease rate due to drought.
	|

Burke Damage long term pooled Lookup(
	[(0,0)-(10,30)],(0,0),(1,6.3),(2,35),(3,55),(4,68.7),(5,80))
	~	percent
	~	Damage estimate according to Burket et al. 2015 Nature Fig. 4d
	|

Climate Damage Function SWITCH=
	0
	~	Dmnl
	~	0 : 0
		1 : Nordhaus
		2 : Dietz&Stern
		3 : Burke short term pooled
		4 : Burke long term pooled
		5 : Logistic function defined by three parameters
	|

denom1 DietzStern=
	12.2
	~	DegreesC
	~		|

Reference GWP per Capita for Domestic Water Use[Regions]=
	14070,
	6466.13,
	5000,
	7823.56,
	10000
	~	$/(Year*Person) [5000,15000]
	~	A reference value against which the GDP per Capita is compared to \
		calculate the impact of population wealth on domestic water use.
	|

Reference GWP per Capita for Agricultural Water Use Rainfed[Regions]=
	12704.9,
	4000,
	25000,
	15000,
	62183.7
	~	$/(Year*Person) [5000,15000]
	~	A reference value against which the GDP per Capita is compared to \
		calculate the impact of population wealth on average agricultural water \
		use on the land where the supply of water is only due to rainfall.
	|

Burke Damage short term pooled=
	Burke Damage short term pooled Lookup(Temperature Change from Preindustrial/unit DegreesC\
		)
	~	percent
	~		|

Climate Damage Steepness SA=
	1.09955
	~	1/DegreesC
	~	Nonlinearity of Climate Damage Fraction.
		Nordhaus :1.09955
		D&S : 1.795846
		Burke st:1.888017
		Burke lt:1.43089
	|

Water Supply Rate=
	Desired Water Supply Rate*Water Supply Fulfillment Rate
	~	m*m*m/Year
	~	Water supply taking into account the desired water supply and the supply \
		fulfillment rate. The water supply includes withdrawals from surface \
		water, groundwater or nonconventional sources for example desalination.
	|

Poverty rate[Regions,Gender,Cohorts]=
	IF THEN ELSE(
	Standard deviation of the lognormal distribution of consumption[Regions,Gender,Cohorts\
		]=0, 
	0.5, 
	IF THEN ELSE("lnPL-mean"[Regions,Gender,Cohorts]<0, 
	1-Table for standard normal distribution(-"lnPL-mean"[Regions,Gender,Cohorts]/Standard deviation of the lognormal distribution of consumption
	[Regions,Gender,Cohorts]), 
	Table for standard normal distribution("lnPL-mean"[Regions,Gender,Cohorts]/Standard deviation of the lognormal distribution of consumption
	[Regions,Gender,Cohorts]
	)))*"100 percent"
	~	percent
	~		|

Climate Damage Steepness 0=
	1.09955
	~	1/DegreesC
	~	Nonlinearity of Climate Damage Fraction.
		Nordhaus :1.09955
		D&S : 1.795846
		Burke st:1.888017
		Burke lt:1.43089
	|

Lifetime Multiplier from Climate Risk[Regions]=
	1 / (1 + SMOOTH(Impact of climate change on mortality fraction[Regions],2)/"100 percent"\
		)
	~	Dmnl
	~	Multiplier to account for changes in life expectancy at birth, depending \
		on the impact of climate change on mortality fractions. Based on the \
		equation that annual average mortality fraction = 1 / LE at birth.
	~	:SUPPLEMENTARY 
	|

Non Recoverable Water Consumption Rate=
	Used Water Resources*(1-Average Used Water Recovery Fraction)
	~	m*m*m/Year
	~	Rate of water consumption not possible to be recovered.
	|

Water Quality Inflection=
	0.5
	~	Dmnl
	~	Inflection point of nonlinear relation describing domestic water quality.
	|

Reference GWP per Capita for Industrial Water Use[Regions]=
	10000,
	12020.5,
	13150,
	14078.1,
	25000
	~	$/(Year*Person) [7000,50000]
	~	A reference value against which the GDP per Capita is compared to \
		calculate the impact of population wealth on average inductrial water use.
	|

Min Water Withdrawal Time=
	1
	~	Year
	~	Minimal time unit constraining water withdrawal.
	|

unit DegreesC=
	1
	~	DegreesC
	~		|

