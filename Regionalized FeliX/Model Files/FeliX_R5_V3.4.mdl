Maturation of Primary Education Graduates[Regions,Gender,PrimaryEdCohorts]=
	IF THEN ELSE(PrimaryEdCohorts = "100+", 0, Primary Education Graduates[Regions,Gender\
		,PrimaryEdCohorts]/Interval duration)
	~	People/Year
	~	Average Primary Education Ratio[Gender,PrimaryEdCohorts]*Maturation Rate[Gender
		,PrimaryEdCohorts]
	|

Maturation of Secondary Education Graduates[Regions,Gender,SecondaryEdCohorts]=
	IF THEN ELSE(SecondaryEdCohorts = "100+", 0, Secondary Education Graduates[Regions,Gender\
		,SecondaryEdCohorts]/Interval duration)
	~	People/Year
	~	Average Secondary Education Level[Gender,SecondaryEdCohorts]*Maturation Rate
		[Gender,SecondaryEdCohorts]
	|

Maturation of Tertiary Education Graduates[Regions,Gender,TertiaryEdCohorts]=
	IF THEN ELSE(TertiaryEdCohorts = "100+", 0, Tertiary Education Graduates[Regions,Gender\
		,TertiaryEdCohorts]/Interval duration)
	~	People/Year
	~	Average Tertiary Education Level[Gender,TertiaryEdCohorts]*Maturation Rate
		[Gender,TertiaryEdCohorts]
	|

