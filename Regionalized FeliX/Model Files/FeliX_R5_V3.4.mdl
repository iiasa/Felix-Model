	Ramp Start10[Regions]+Ramp Period10[Regions]
	~	Year
	~	End of fractional investments in Educational Attainment.
	|

Desired Available Water Resources=
	Total Water Demand*(Min Water Withdrawal Time+Water Safety Stock Coverage)
	~	m*m*m
	~	Total desired available water resources including demand from industrial, \
		agricultural and domestic sectors as well as safety coverage.
	|

Industrial Water Demand[Regions]=
	Average Industrial Water Use[Regions]
	~	m*m*m/Year
	~	Total water demand for industrial purposes. Source of Historical Data:
		International Hydrological Programme (IHP) of UNESCO, data by Shiklomanov, I.A – \
		Dynamics of water use in the world (total) over the kinds of economic \
		activities
		http://webworld.unesco.org/water/ihp/db/shiklomanov/
	|

Industrial Water Withdrawal Fulfillment Rate=
	(2/(1+EXP(-Industrial Water Withdrawal Fulfillment Factor*(Max Water Withdrawal Rate\
		/sum(Industrial Water Demand[Regions!]))))-1)
	~	Dmnl
	~	Nonlinear relation that describes industrial water withdrawal fulfillment \
		as a relation of max water withdrawal and demand. With growing industrial \
		water demand the withdrawal fulfillment might be impaired which relates to \
		infrastructure design and its operating limits.
	|

Industrial Water Withdrawal Rate=
	sum(Industrial Water Demand[Regions!])*Industrial Water Withdrawal Fulfillment Rate
	~	m*m*m/Year
	~	Water withdrawal rate for industrial purposes.
	|

Agricultural Water Withdrawal Fulfillment Rate=
	(2/(1+EXP(-Agricultural Water Withdrawal Fulfillment Factor*(Max Water Withdrawal Rate\
		/sum(Agricultural Water Demand[Regions!]))))-1)
	~	Dmnl
	~	Nonlinear relation that describes agricultural water withdrawal \
		fulfillment as a relation of max water withdrawal and demand. With growing \
		agricultural water demand the withdrawal fulfillment might be impaired \
		which relates to infrastructure design and its operating limits.
	|

Average Agricultural Water Use per m2 Rainfed[Regions]=
	MIN Agricultural Water Use Rainfed[Regions]+(MAX Agricultural Water Use Rainfed[Regions\
		]-MIN Agricultural Water Use Rainfed[Regions])*(Smoothed GDP per Capita[Regions]
	/(Smoothed GDP per Capita[Regions]+Reference GWP per Capita for Agricultural Water Use Rainfed\
		[Regions]))
	~	m*m*m/(Year*m*m)
	~	Nonlinear relation that describes average agricultural water use on \
		rainfed part of agricultural land as dependent on the population wealth \
		represented by GWP per capita. Scaled between minimal and maximal level.
	|

Agricultural Water Withdrawal Rate no Drought=
	sum(Agricultural Water Demand[Regions!])*Agricultural Water Withdrawal Fulfillment Rate
	~	m*m*m/Year
	~	Drought scenario variable. Accounts for Agricultural Water Withdrawal Rate \
		in no drought case.
	|

Domestic Water Withdrawal Rate=
	sum(Domestic Water Demand[Regions!])*Domestic Water Withdrawal Fulfillment Rate
	~	m*m*m/Year
	~	Water withdrawal rate for domestic purposes.
	|

Average Domestic Water Use per Capita[Regions]=
	MIN Domestic Water Use per Capita[Regions]+(MAX Domestic Water Use per Capita[Regions\
		]-MIN Domestic Water Use per Capita[Regions])*(Smoothed GDP per Capita[Regions]
	/(Smoothed GDP per Capita[Regions]+Reference GWP per Capita for Domestic Water Use[Regions\
		]))
	~	m*m*m/(Year*People)
	~	Nonlinear relation that describes average domestic water use per capita as \
		dependent on the population wealth represented by GWP per capita. Scaled \
		between minimal and maximal level.
	|

Average Agricultural Water Use per m2 Irrigated[Regions]=
	MIN Agricultural Water Use Irrigated[Regions]+(MAX Agricultural Water Use Irrigated[\
		Regions]-MIN Agricultural Water Use Irrigated[Regions])*(
	Smoothed GDP per Capita[Regions]
	/(Smoothed GDP per Capita[Regions]+Reference GWP per Capita for Agricultural Water Use Irrigated\
		[Regions]))
	~	m*m*m/(Year*m*m)
	~	Nonlinear relation that describes average agricultural water use on \
		irrigated part of agricultural land as dependent on the population wealth \
		represented by GWP per capita. Scaled between minimal and maximal level.
	|

Agricultural Water Withdrawal Rate=
	sum(Agricultural Water Demand[Regions!])*Agricultural Water Withdrawal Fulfillment Rate\
		 * (1-Extreme Drought)
	~	m*m*m/Year
	~	Water withdrawal rate for agricultural purposes.
	|

Total Water Demand=
	sum(Agricultural Water Demand[Regions!])+
	sum(Domestic Water Demand[Regions!])+
	sum(Industrial Water Demand[Regions!])
	~	m*m*m/Year
	~	Total world water demand related to various purposes.
		http://webworld.unesco.org/water/ihp/db/shiklomanov/index.shtml
	|

Domestic Water Demand[Regions]=
	Smoothed Total Population[Regions]*Average Domestic Water Use per Capita[Regions]
	~	m*m*m/Year
	~	Total water demand for domestic purposes. Source of Historical Data:
		International Hydrological Programme (IHP) of UNESCO, data by Shiklomanov, I.A – \
		Dynamics of water use in the world (total) over the kinds of economic \
		activities
		http://webworld.unesco.org/water/ihp/db/shiklomanov/
	|

Domestic Water Withdrawal Fulfillment Rate=
	(2/(1+EXP(-Domestic Water Withdrawal Fulfillment Factor*(Max Water Withdrawal Rate/sum\
		(Domestic Water Demand[Regions!]))))-1)
	~	Dmnl
	~	Nonlinear relation that describes domestic water withdrawal fulfillment as \
		a relation of max water withdrawal and demand. With growing domestic water \
		demand the withdrawal fulfillment might be impaired which relates to \
		infrastructure design and its operating limits.
	|

Recovery of Used Water Resources Rate=
	Used Water Resources*Average Used Water Recovery Fraction
	~	m*m*m/Year
	~	Rate of water consumption possible to be recovered and thus return to \
		available water resources stock.
	|

Climate Damage Fraction OLD=
	1/(1+Climate Damage Scale*(Temperature Change from Preindustrial/Reference Temperature\
		)^Climate Damage Nonlinearity)
	~	Dmnl
	~	Fraction of Output lost to Climate Change as a function of temperature \
		rise. A logistic function is chosen to formulate climate damages due to \
		its flexibility to capture various damage function estimates such as \
		Nordhaus and Dietz&Stern ( exponential) or Burke (logarithmic).
	|

"100 percent"=
	100
	~	percent
	~		|

Climate Damage Inflection=
	Climate Damage Inflection 0+STEP(Climate Damage Inflection SA-Climate Damage Inflection 0\
		,Current year)
	~	DegreesC
	~	This function starts with the parameter values defined by the original \
		calibration (parameter "...0") e.g. to Nordhaus, until the present year, \
		and it allows for user-defined values to cover future uncertainty \
		(parameter "... SA").
	|

Climate Damage Inflection 0=
	3.89219
	~	DegreesC
	~	Nordhaus : 3.89219
		D&S  : 3.863367	
		Burke st : 1.773525
		Burke lt : 2.2569
	|

Climate Damage Inflection SA=
	3.89219
	~	DegreesC
	~	Nordhaus : 3.89219
		D&S  : 3.863367	
		Burke st : 1.773525
		Burke lt : 2.2569
	|

Climate Damage Nonlinearity=
	2
	~	Dmnl
	~	Nonlinearity of Climate Damage Cost Fraction.
	|

Climate Damage Percentage=
	IF THEN ELSE(Climate Damage Function SWITCH=0, 0,
	             IF THEN ELSE(Climate Damage Function SWITCH=1, Nordhaus Damage,
	                          IF THEN ELSE(Climate Damage Function SWITCH=2, Dietz and Stern Damage\
		,
	                                       (IF THEN ELSE(Climate Damage Function SWITCH=\
		3,Burke Damage short term pooled,
	                                                     IF THEN ELSE(Climate Damage Function SWITCH\
		=4, Burke Damage long term pooled,
	                                                                  Logistic Damage)))\
		)))
	~	percent
	~	Can be set either to predefined functions according to the literature, or \
		to a flexible logistic function that can capture a wide uncertainty range.
	|

Climate Damage Saturation=
	Climate Damage Saturation 0 + STEP(Climate Damage Saturation SA-Climate Damage Saturation 0\
		,Current year)
	~	Dmnl
	~	This function starts with the parameter values defined by the original \
		calibration (parameter "...0") e.g. to Nordhaus, until the present year, \
		and it allows for user-defined values to cover future uncertainty \
		(parameter "... SA").
	|

Climate Damage Saturation 0=
	0.073953
	~	Dmnl
	~	Nordhaus: 0.073953
		Dietz&Stern:0.935478
		Burke st : 0.206988
		Burke lt : 0.75716
	|

Climate Damage Saturation SA=
	0.073953
	~	Dmnl
	~	Nordhaus: 0.073953
		Dietz&Stern:0.935478
		Burke st : 0.206988
		Burke lt : 0.75716
	|

Climate Damage Scale=
	0.013
	~	Dmnl
	~	Climate Damage Fraction at Reference Temperature.
	|

Additional Change in Reliable Water Supply=
	1
	~	Dmnl
	~	A parameter that enables testing additional changes in reliable water \
		supply independently from changes due to climate risk.
	|

exp1 DietzStern=
	2
	~	Dmnl
	~		|

exp2 DietzStern=
	7.02
	~	Dmnl
	~		|

Burke Damage short term pooled Lookup(
	[(0,0)-(10,30)],(0,0),(1,1),(2,13),(3,19),(4,20.5),(5,21))
	~	percent
	~	Damage estimate according to Burket et al. 2015 Nature Fig. 4d
	|

Extreme Drought=
	0
	~	Dmnl
	~	Drought scenario trigger.
	|

beta Nordhaus damage=
	0.00278
	~	1/(DegreesC*DegreesC)
	~		|

Dietz and Stern Damage=
	"100 percent"*(1
	                  - 1
	                       / ( 1
	                            + ( Temperature Change from Preindustrial
	                                 / denom1 DietzStern ) 
	                                 ^ exp1 DietzStern 
	                            + ( Temperature Change from Preindustrial
	                                 / denom2 DietzStern ) 
	                                 ^ exp2 DietzStern ))
	~	percent
	~	Formulation of the original damage function used by Dietz and Stern in the \
		Economic Journal (2015) paper. https://doi.org/10.1111/ecoj.12188
	|

Used Water Resources= INTEG (
	Agricultural Water Withdrawal Rate+Domestic Water Withdrawal Rate+Industrial Water Withdrawal Rate\
		-Non Recoverable Water Consumption Rate-Recovery of Used Water Resources Rate,
		Available Water Resources)
	~	m*m*m
	~	Water resources that have been used for industrial, agricultural and \
		domestic purposes.
	|

