Solar Energy Price[Regions]=
	Indicated Solar Energy Price[Regions]*Effect of Solar Energy Demand and Supply on Price\
		[Regions]
	~	$/Mtoe
	~	Actual solar energy price accounting for indicated solar energy price and \
		effect of demand and supply.
	|

Possible Solar Energy Production[Regions]=
	Solar Conversion Efficiency Factor[Regions]*Sun Radiation*Solar Installed Capacity[Regions\
		]*Time FL*Solar Conversion Efficiency[Regions]*kWh into Mtoe
	~	Mtoe/Year
	~	Potential solar energy production per year due to available production \
		capability, weather conditions and technical developments.
	|

Investment in Solar Energy Efficiency[Regions]=
	Investment in Solar Energy Technology[Regions]*(1-Fraction Invested in Solar Energy Installation\
		[Regions])
	~	$/Year
	~	Total investments in solar conversion efficiency technology.
	|

Investment in Solar Energy Installation[Regions]=
	Investment in Solar Energy Technology[Regions]*Fraction Invested in Solar Energy Installation\
		[Regions]
	~	$/Year
	~	Total investments in solar energy capacity.
	|

Investment in Solar Energy Technology[Regions]=
	Fraction of Revenue Invested in Solar Technology[Regions]*Solar Energy Revenue[Regions\
		]
	~	$/Year
	~	Investments in development of solar conversion efficiency technology and \
		production capability.
	|

Production to Installation Ratio[Regions]=
	Solar Energy Production[Regions]/Solar Installed Capacity[Regions]
	~	Mtoe/(m*m*Year)
	~	Ratio of solar energy production to available production capacity.
	|

Solar Installation Efficiency[Regions]=
	MINSIE+(MAXSIE-MINSIE)*(Solar Installation Technology Ratio[Regions]/(Solar Installation Technology Ratio\
		[Regions]+1))
	~	1
	~	Parameter indicating solar energy capacity installation efficiency at the \
		current state of technical developments.
	|

Solar Installation Technology Ratio[Regions]= INTEG (
	Increase in Solar Installation Technology Ratio[Regions],
		INIT SITRN[Regions])
	~	Dmnl
	~	Solar Installation Technology Ratio increased due to investments in solar \
		energy capacity installation efficiency.
	|

Solar Installed Capacity[Regions]= INTEG (
	Installation of Solar Capacity Rate[Regions]-Solar Capacity Aging Rate[Regions],
		INIT SIC[Regions])
	~	m*m
	~	Installed capacity to transform solar radiation into energy.
	|

Cost of Solar Energy[Regions]=
	Unit Cost of Solar Capacity Installation[Regions]+Unit Cost of Solar Energy Production\
		[Regions]
	~	$/Mtoe
	~	Cost of solar energy production assuming an impact of learning curve.
	|

Solar Investment Fraction Slope[Regions]=
	ABS(Solar Final Investment[Regions]-Solar Initial Investment[Regions])/Ramp Investment Period Solar\
		[Regions]
	~	1/Year
	~	Intensity of increase in investments in solar energy technology.
	|

Productivity of Investment in Solar Capacity Installation[Regions]=
	Impact of Space on Capacity Installation[Regions]*Solar Installation Efficiency[Regions\
		]
	~	Dmnl
	~	Productivity of solar capacity installation taking into account the level \
		of available capacities and technology development state.
	|

Increase in Solar Energy Technology Ratio[Regions]=
	DELAY3(Investment in Solar Energy Efficiency[Regions]*Effectiveness of Investment in Solar Energy Technology\
		[Regions], Solar Energy Technology Development Time[Regions])
	~	1/Year
	~	Increase in Solar Energy Technology Ratio due to investments in solar \
		conversion efficiency technology and their productivity.
	|

Increase in Solar Installation Technology Ratio[Regions]=
	DELAY3(Investment in Solar Energy Installation[Regions]*Effectiveness of Investment in Solar Installation Technology\
		[Regions], Solar Installation Technology Development Time[Regions]
	)
	~	1/Year
	~	Increase in Solar Installation Technology Ratio due to investments in \
		solar energy installation  capacity.
	|

Ramp Investment Period Solar[Regions]=
	Fraction of Revenue Invested in Solar Technology Ramp Investment Period Variation[Regions\
		]+STEP(Fraction of Revenue Invested in Solar Technology Ramp Investment Period Variation\
		[Regions]-Fraction of Revenue Invested in Solar Technology Ramp Investment Period Variation\
