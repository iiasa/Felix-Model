	~	$/(Person*Year)
	~		|

Reference Economy Output[Regions,Labor force type]=
	InitialREO[Regions,Labor force type]*Output in 1900[Regions]*
	Ratio of technology[Regions,Labor force type]*Technology[Regions]*
	(Ratio of capital[Regions,Labor force type]*(Capital[Regions]/INIT Capital[Regions])\
		)^Capital Elasticity Output[Regions
	,Labor force type]*
	Labor Force on Economy Output[Regions,Labor force type]
	~	$/Year
	~	Output in 1900*Technology*(((Capital/INIT Capital)^Capital Elasticity Output)*(Labor \
		Force input)^(1-Capital Elasticity Output))
		
		Global version:
		InitialREO[Regions,Labor force type]*Output in 1900[Regions]*Ratio of \
		technology[Regions,Labor force type]*Technology Data*(Ratio of \
		capital[Regions,Labor force type]*(Capital[Regions]/INIT \
		Capital[Regions]))^Capital Elasticity Output[Labor force type]*sum(Labor \
		Force input[Regions,Gender!,WorkingAge!,Labor force type])^(1-Capital \
		Elasticity Output[Labor force type])
	|

Gross Domestic Product[Regions]=
	Total REO[Regions]*Impact of Biodiversity on Economy[Regions]*Net Climate Change Impact on Economy
	~	$/Year
	~	Total REO[Regions]*Net Climate Change Impact on Economy Data*Impact of \
		Biodiversity on Economy[Regions]
	|

