Subjective norm multiplier for diet change[Regions,Gender,Cohorts,Education]=
	L social norm[Regions,Cohorts]/
	(1+EXP(-k social norm[Regions,Cohorts]*( Percentage of vegetarians[Regions,Gender,Cohorts\
		,Education] -x0 social norm[Regions,Cohorts]) ) )
	~	Dmnl
	~		|

Land Allocated for Food Crops Global=
	sum(Land Allocated for Food Crops[Regions!])
	~	ha
	~		|

Commercial N application for each category Global=
	sum(Commercial N application for each category[Regions!,PasMeat])+sum(Commercial N application for each category\
		[Regions
	!,PlantFood!])
	~	Ton/Year
	~		|

Percentage of vegetarian diet followers Global=
	sum(Total Vegetarians[Regions!])/sum(Population[Regions!])
	~	Dmnl
	~		|

Total Agricultural and Land Use Emissions Global=
	sum(Total Agricultural and Land Use Emissions[Regions!])
	~	TonCO2/Year
	~		|

