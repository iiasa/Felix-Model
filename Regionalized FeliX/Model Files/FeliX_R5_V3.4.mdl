Food production rate[Regions,PlantFood]=
	MIN(Total Agricultural Product Demand from Regions incl Export Demand Plant Food[Regions\
		,PlantFood],Potential crop production
	[Regions,PlantFood]) ~~|
Food production rate[Regions,AnimalFood]=
	Production rate of animal food[Regions,AnimalFood]
	~	Ton/Year
	~		|

Scaled Excess Demand Grains[Regions]=
	Excess Demand Grains[Regions]/MIN(sum(Indicated Grains Trade to Meet Demand[Regions,\
		Regions!]),sum(Indicated Grains Trade to Meet Demand[Regions
	!,Regions]))
	~	
	~		|

Scaled Excess Demand OtherCrops[Regions]=
	Excess Demand OtherCrops[Regions]/MIN(sum(Indicated OtherCrops Trade to Meet Demand[\
		Regions,Regions!]),sum(Indicated OtherCrops Trade to Meet Demand
	[Regions
	!,Regions]))
	~	
	~		|

Scaled Excess Demand PasMeat[Regions]=
	Excess Demand PasMeat[Regions]/MIN(sum(Indicated PasMeat Trade to Meet Demand[Regions\
		,Regions!]),sum(Indicated PasMeat Trade to Meet Demand
	[Regions!,Regions]))
	~	
	~		|

Scaled Excess Demand Pulses[Regions]=
	Excess Demand Pulses[Regions]/MIN(sum(Indicated Pulses Trade to Meet Demand[Regions,\
		Regions!]),sum(Indicated Pulses Trade to Meet Demand[Regions
	!,Regions]))
	~	
	~		|

Scaled Excess Demand VegFruits[Regions]=
	Excess Demand VegFruits[Regions]/MIN(sum(Indicated VegFruits Trade to Meet Demand[Regions\
		,Regions!]),sum(Indicated VegFruits Trade to Meet Demand[Regions
	!,Regions]))
	~	
	~		|

PasMeat Trade to Meet Demand[Africa,Regions]=
	Indicated PasMeat Trade to Meet Demand[Africa,Regions]*(PasMeat Prices Adj[Africa]/Initial Agricultural Product Prices\
		[Africa
	,PasMeat])^PasMeat Supply Elaticity[Africa] ~~|
PasMeat Trade to Meet Demand[AsiaPacific,Regions]=
	Indicated PasMeat Trade to Meet Demand[AsiaPacific,Regions]*(PasMeat Prices Adj[AsiaPacific\
		]/Initial Agricultural Product Prices
	[AsiaPacific,PasMeat])^PasMeat Supply Elaticity[AsiaPacific] ~~|
PasMeat Trade to Meet Demand[EastEu,Regions]=
	Indicated PasMeat Trade to Meet Demand[EastEu,Regions]*(PasMeat Prices Adj[EastEu]/Initial Agricultural Product Prices\
		[EastEu
	,PasMeat])^PasMeat Supply Elaticity[EastEu] ~~|
PasMeat Trade to Meet Demand[LAC,Regions]=
	Indicated PasMeat Trade to Meet Demand[LAC,Regions]*(PasMeat Prices Adj[LAC]/Initial Agricultural Product Prices\
		[LAC,PasMeat
	])^PasMeat Supply Elaticity[LAC] ~~|
PasMeat Trade to Meet Demand[WestEu,Regions]=
	Indicated PasMeat Trade to Meet Demand[WestEu,Regions]*(PasMeat Prices Adj[WestEu]/Initial Agricultural Product Prices\
		[WestEu
	,PasMeat])^PasMeat Supply Elaticity[WestEu]
	~	
	~	Pasture meat supply matrix.
		"PasMeat Trade to Meet Demand[Region A, Region A]" means domestic supply; \
		"PasMeat Trade to Meet Demand[Region A, Region B]" means pasture meat \
		export from Region A to Region B
	|

