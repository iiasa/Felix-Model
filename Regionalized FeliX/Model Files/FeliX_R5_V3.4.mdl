Threshold Z for Extreme Temperatures=
	inverse CDF*StDev Temperature+Mean Temperature for Events
	~	DegreesC
	~	90% right position @ mean 0.964 var 16.76
	|

Number of Future Events=
	IF THEN ELSE( 
	   Time<=Filter Date ,
	   Reference Extreme Event Mean ,
	   Poisson Arrivals
	)
	~	Events/Year
	~		|

Change Rate Start7=
	Ramp Start7
	~	Year
	~	Start of increased investments in Educational Attainment.
	|

Other Technology Steepness Final Change Rate Variation=
	6
	~	1/Year
	~	Final Educational Attainment Change Rate
	|

Other Technology Steepness=
	Variable16 Technology
	~	Dmnl
	~	Parameter determining intensity of reference factor productivity in other \
		than energy sectors.
	|

Delayed Poisson Event Generation=
	DELAY FIXED(Number of Future Events, Window Avg Time , Number of Future Events )
	~	Events/Year
	~		|

Days in Year=
	365
	~	Days/Year
	~	The number of days per year.
	|

Poisson Arrivals=
	RANDOM POISSON(Minimum Number of Extreme Events, Maximum Number of Extreme Events, Extreme Event Mean\
		, 
	Poisson Distribution Shift, Poisson Distribution Stretch, S Stream ID)
	~	Events/Year
	~		|

Change Rate Slope7=
	ABS(Final Change Rate7-Initial Change Rate7)/Ramp Period7
	~	1/(Year*Year)
	~	Intensity of Educational Attainment Change Rate.
	|

