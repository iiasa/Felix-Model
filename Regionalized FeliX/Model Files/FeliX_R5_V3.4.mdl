	0.330407
	~	Dmnl [0.01,1]
	~		|

Reference Other Technology=
	Reference Other Technology baseline  + 
	RAMP((Reference Other Technology Variation-Reference Other Technology baseline)/(Year2100\
		-Current year),
	Current year,Year2100)
	~	Dmnl
	~	Reference factor productivity in other than energy sectors.
	|

Reference relative income of skilled=
	Relative income of skilled variation baseline + 
	RAMP((Relative income of skilled variation-Relative income of skilled variation baseline\
		)/(DemoFeliX target year-Current year), 
	Current year , DemoFeliX target year)
	~	$/Year
	~		|

Net Capital Change Rate[Regions]=
	Net Capital Change[Regions]
	~	$/Year
	~	Net Capital Stock change rate.
	|

Time to Adjust Other Capital=
	20
	~	Year
	~	Time required to adjust capital changes in sectors other than energy.
	|

Global poverty rate=
	sum(Poverty rate[Regions!,Gender!,SecondaryEdCohorts!]*Population Cohorts[Regions!,Gender\
		!,SecondaryEdCohorts!])/sum(Population Cohorts[Regions!,Gender!,Cohorts!])
	~	percent
	~	Calibrated with historical data from World Bank: \
		https://data.worldbank.org/indicator/SI.POV.DDAY
	~	:SUPPLEMENTARY 
	|

Skilled population[Regions,Gender,Cohorts]=
	Tertiary Education Graduates[Regions,Gender,Cohorts]+Fraction of skilled secondary education graduates\
		*Secondary Education Graduates[Regions,Gender,Cohorts]
	~	People
	~		|

Fraction of skilled secondary education graduates=
	Skilled fraction of secondary education graduates baseline + RAMP((Skilled fraction of secondary education graduates\
		-Skilled fraction of secondary education graduates baseline)/(DemoFeliX target year\
		-Current year), Current year, 
	DemoFeliX target year)
	~	Dmnl
	~	the value was obtained by the model calibration.
	|

