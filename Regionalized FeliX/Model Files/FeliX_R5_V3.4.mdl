Graduation Rate from Primary Education[Regions,Gender,"10-14"]=
	MIN(
	DELAY1(
	Enrollment rate to primary education[Regions,Gender],Average Primary Education Duration\
		)*(Interval duration+Interval duration
	-Average Primary Education Duration)/Interval duration, 
	Maturation Rate[Regions,Gender,"10-14"]
	) ~~|
Graduation Rate from Primary Education[Regions,Gender,"15-19"]=
	MIN(DELAY1(Enrollment rate to primary education[Regions,Gender],Average Primary Education Duration\
		)*(Average Primary Education Duration
	-Interval duration)/Interval duration,Maturation Rate[Regions,Gender,"15-19"])
	~	People/Year
	~		|

Graduation Rate from Secondary Education[Regions,Gender,"15-19"]=
	MIN(
	DELAY1(
	Enrollment Rate to Secondary Education[Regions,Gender,"10-14"]*
	(Interval duration+Interval duration-Average Secondary Education Duration[Regions])/\
		Interval duration,
	Average Secondary Education Duration[Regions]),
	Maturation Rate[Regions,Gender,"15-19"]) ~~|
Graduation Rate from Secondary Education[Regions,Gender,"20-24"]=
	MIN(
	DELAY1(
	Enrollment Rate to Secondary Education[Regions,Gender,"15-19"]*
	(Interval duration+Interval duration-Average Secondary Education Duration[Regions])/\
		Interval duration+
	Enrollment Rate to Secondary Education[Regions,Gender,"10-14"]*(Average Secondary Education Duration\
		[Regions]-Interval duration)/Interval duration
	,Average Secondary Education Duration[Regions]),
	Maturation Rate[Regions,Gender,"20-24"]) ~~|
Graduation Rate from Secondary Education[Regions,Gender,"25-29"]=
	MIN(
	DELAY1(Enrollment Rate to Secondary Education[Regions,Gender,"15-19"]*
	(Average Secondary Education Duration[Regions]-Interval duration)/Interval duration,
	Average Secondary Education Duration[Regions]),
	Maturation Rate[Regions,Gender,"25-29"])
	~	People/Year
	~	Conidering that the average secondary education duration is 6 yrs, 4/5 of the \
		students enrolled when aged 10-14 graduate when they are 15-19. 1/5 of thm \
		graduate at the 20-24 interval.
		The same goes for the students enrolled when 15-19.
	|

